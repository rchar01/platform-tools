FROM docker.io/library/python:3.14.7-slim-trixie@sha256:83c1cebb322d099ac9e3a3a532ba74b0146d702838b25e4c75c02fa81ffeb910

ARG DEBIAN_SNAPSHOT=20260803T000000Z

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC

# The Python base was built from the Debian snapshot at this timestamp. Keep
# package indexes immutable and direct package versions reviewable.
RUN printf '%s\n' \
      'Types: deb' \
      "URIs: https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/" \
      'Suites: trixie trixie-updates' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp' \
      '' \
      'Types: deb' \
      "URIs: https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}/" \
      'Suites: trixie-security' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp' \
      > /etc/apt/sources.list.d/debian.sources \
  && printf '%s\n' 'Acquire::Check-Valid-Until "false";' \
      > /etc/apt/apt.conf.d/99snapshot

COPY requirements-test.txt constraints-test.txt /tmp/platform-tools-test/

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      age=1.2.1-1+b5 \
      bash=5.2.37-2+b9 \
      ca-certificates=20250419 \
      coreutils=9.7-3 \
      diffutils=1:3.10-4 \
      file=1:5.46-5 \
      findutils=4.10.0-3 \
      grep=3.11-4 \
      gzip=1.13-1 \
      jq=1.7.1-6+deb13u2 \
      make=4.4.1-2 \
      mawk=1.3.4.20250131-1 \
      openssh-client=1:10.0p1-7+deb13u4 \
      openssl=3.5.6-1~deb13u2 \
      procps=2:4.0.4-9 \
      sed=4.9-2+deb13u1 \
      tar=1.35+dfsg-3.1 \
      util-linux=2.41-5 \
  && python3 -m pip install \
      --disable-pip-version-check \
      --no-cache-dir \
      --root-user-action=ignore \
      --constraint /tmp/platform-tools-test/constraints-test.txt \
      --requirement /tmp/platform-tools-test/requirements-test.txt \
  && rm -rf /tmp/platform-tools-test /var/lib/apt/lists/*

RUN test "$(python3 --version)" = 'Python 3.14.7' \
  && test "$(python3 -m pytest --version)" = 'pytest 9.1.1' \
  && test "$(python3 -c 'from importlib.metadata import version; print(version("pytest-xdist"))')" = '3.8.0' \
  && test "$(python3 -c 'from importlib.metadata import version; print(version("PyYAML"))')" = '6.0.3' \
  && test "$(python3 -c 'from importlib.metadata import version; print(version("pluggy"))')" = '1.6.0' \
  && python3 -c 'import importlib.util; assert all(importlib.util.find_spec(name) is None for name in ("anyio", "typeguard"))' \
  && python3 -m pip check

WORKDIR /workspace

CMD ["/bin/bash"]
