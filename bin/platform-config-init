if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2))); then
  printf "bash version 4.2 or higher is required\n" >&2
  exit 1
fi

root_command() {
  config_dir=${args[--config-dir]:-$(default_config_dir)}
  config_dir=$(expand_path "$config_dir")

  mkdir -p "$config_dir"
  chmod 700 "$config_dir"
  ok "Config directory ready: $config_dir"

  ensure_secret_dir "$config_dir/config"
  ensure_secret_dir "$config_dir/infra"
  ensure_secret_dir "$config_dir/pki"

  write_if_missing "$config_dir/README.md" content_readme

  for legacy_path in \
    "$config_dir/proxmox-token" \
    "$config_dir/codeberg.env" \
    "$config_dir/ansible.env" \
    "$config_dir/backup.env" \
    "$config_dir/proxmox.env"; do
    if [[ -e "$legacy_path" ]]; then
      warn "Legacy path exists and was left unchanged: $legacy_path"
    fi
  done

  cat <<EOF

Next steps:

  1. Let each downstream project/helper create its own files under:

        $config_dir

  2. Write the Proxmox token through the Proxmox helper when needed:

        platform-proxmox-token-init --write-token-file "$config_dir/infra/proxmox.token" --ssh root@<proxmox-ip>

  3. Run the downstream platform command, for example:

       tofu plan -var-file=../../../platform-private/infra/production.tfvars

EOF

}

version_command() {
  echo "$version"
}

platform_config_init_usage() {
  printf "platform-config-init - Create the local platform secret namespace outside Git\n\n"

  printf "%s\n" "$(bold "Usage:")"
  printf "  platform-config-init [OPTIONS]\n"
  printf "  platform-config-init --help | -h\n"
  printf "  platform-config-init --version | -v\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "$(bold "Options:")"

    printf "  %s\n" "$(magenta "--config-dir PATH")"
    printf "    Config directory to create\n"
    echo

    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "$(magenta "--version, -v")"
    printf "    Show version number\n"
    echo

    printf "%s\n" "$(bold "Examples:")"
    printf "  platform-config-init\n"
    printf "  platform-config-init --config-dir /tmp/platform-infrastructure-test\n"
    echo

    printf "Created layout:\n  README.md\n  infra/\n  config/\n  pki/\n\nThe default is platform-infrastructure under the XDG configuration home,\nwhich normally resolves to ~/.config/platform-infrastructure.\nExisting README.md is not overwritten. Directories are mode 700 and\nREADME.md is mode 600.\n"
    echo

  fi
}

normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

enable_auto_colors() {
  if [[ -z ${NO_COLOR+x} && ! -t 1 ]]; then
    NO_COLOR=1
  fi
}

print_in_color() {
  local color="$1"
  shift
  if [[ "${NO_COLOR:-}" == "" ]]; then
    printf "$color%b\e[0m\n" "$*"
  else
    printf "%b\n" "$*"
  fi
}

