if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2))); then
  printf "bash version 4.2 or higher is required\n" >&2
  exit 1
fi

root_command() {
  SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  COMMON_PATH=${PLATFORM_TOOLS_LIB_DIR:-}
  if [[ -n $COMMON_PATH ]]; then
    COMMON_PATH=${COMMON_PATH}/platform-pki-common.sh
  elif [[ -r ${SCRIPT_DIR}/../lib/platform-pki-common.sh ]]; then
    COMMON_PATH=${SCRIPT_DIR}/../lib/platform-pki-common.sh
  else
    COMMON_PATH=${PLATFORM_TOOLS_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/platform-tools}/lib/platform-pki-common.sh
  fi
  [[ -r $COMMON_PATH ]] || {
    printf '[ERROR] platform-pki-common.sh not found\n' >&2
    exit 1
  }
  # shellcheck source=../../../../lib/platform-pki-common.sh disable=SC1091
  source "$COMMON_PATH"

  SERVICE=${args[service]}
  NAMESPACE=${args[--namespace]:-$(pki_default_namespace)}
  PKI_DIR=${args[--pki-dir]:-}

  pki_validate_service_name "$SERVICE"
  NAMESPACE=$(pki_expand_path "$NAMESPACE")
  PKI_DIR=${PKI_DIR:-${NAMESPACE}/pki}
  PKI_DIR=$(pki_expand_path "$PKI_DIR")

  pki_require_cmd openssl
  pki_require_pki_dir
  pki_require_service_in_inventory "$SERVICE"
  CERT=$(pki_service_cert "$SERVICE")
  pki_require_file "$CERT"

  printf 'Service: %s\n' "$SERVICE"
  openssl x509 -in "$CERT" -noout \
    -subject \
    -issuer \
    -serial \
    -startdate \
    -enddate \
    -fingerprint -sha256
  openssl x509 -in "$CERT" -noout -ext subjectAltName || true
  openssl x509 -in "$CERT" -noout -ext keyUsage || true
  openssl x509 -in "$CERT" -noout -ext extendedKeyUsage || true

}

version_command() {
  echo "$version"
}

platform_pki_print_cert_usage() {
  printf "platform-pki-print-cert - Print readable details for a generated service certificate\n\n"

  printf "%s\n" "Usage:"
  printf "  platform-pki-print-cert SERVICE [OPTIONS]\n"
  printf "  platform-pki-print-cert --help | -h\n"
  printf "  platform-pki-print-cert --version | -v\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--namespace PATH"
    printf "    Platform namespace root\n"
    echo

    printf "  %s\n" "--pki-dir PATH"
    printf "    PKI directory\n"
    echo

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "--version, -v"
    printf "    Show version number\n"
    echo

    printf "%s\n" "Arguments:"

    printf "  %s\n" "SERVICE"
    printf "    Inventory service name\n"
    echo

    printf "%s\n" "Examples:"
    printf "  platform-pki-print-cert platform-example\n"
    printf "  platform-pki-print-cert platform-example --pki-dir /tmp/platform-pki\n"
    echo

    printf "The namespace defaults to platform-infrastructure under the XDG\nconfiguration home. The PKI directory defaults to <namespace>/pki.\n"
    echo

  fi
}

normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

validate_not_empty() {
  [[ -n $1 ]] || printf '%s\n' 'must not be empty'
}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        platform_pki_print_cert_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="root"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --namespace)

        if [[ -n ${2+x} ]]; then
          args['--namespace']="$2"
          shift
          shift
        else
          printf "%s\n" "--namespace requires an argument: --namespace PATH" >&2
          exit 1
        fi
        ;;

      --pki-dir)

        if [[ -n ${2+x} ]]; then
          args['--pki-dir']="$2"
          shift
          shift
        else
          printf "%s\n" "--pki-dir requires an argument: --pki-dir PATH" >&2
          exit 1
        fi
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        if [[ -z ${args['service']+x} ]]; then
          args['service']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  if [[ -z ${args['service']+x} ]]; then
    printf "missing required argument: SERVICE\nusage: platform-pki-print-cert SERVICE [OPTIONS]\n" >&2

    exit 1
  fi

  if [[ -v args['--namespace'] ]]; then
    validation_output="$(validate_not_empty "${args['--namespace']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--namespace PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--pki-dir'] ]]; then
    validation_output="$(validate_not_empty "${args['--pki-dir']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--pki-dir PATH" "$validation_output" >&2
      exit 1
    fi
  fi

}

initialize() {
  declare -g version="platform-pki-print-cert 1.4.0-dev"
  set -euo pipefail

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "root") root_command ;;
  esac
}

command_line_args=("$@")
initialize
run "${command_line_args[@]}"
