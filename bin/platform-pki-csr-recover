root_command() {
  SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  COMMON_PATH=${PLATFORM_TOOLS_LIB_DIR:-}
  if [[ -n $COMMON_PATH ]]; then
    COMMON_PATH=${COMMON_PATH}/platform-pki-common.sh
  elif [[ -r ${SCRIPT_DIR}/../lib/platform-pki-common.sh ]]; then
    COMMON_PATH=${SCRIPT_DIR}/../lib/platform-pki-common.sh
  else
    COMMON_PATH=${PLATFORM_TOOLS_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/platform-tools}/lib/platform-pki-common.sh
  fi
  [[ -r $COMMON_PATH ]] || { printf '[ERROR] platform-pki-common.sh not found\n' >&2; exit 1; }
  # shellcheck source=../../../../lib/platform-pki-common.sh disable=SC1091
  source "$COMMON_PATH"
  CSR_COMMON_PATH=$(dirname -- "$COMMON_PATH")/platform-pki-csr-sign.sh
  [[ -r $CSR_COMMON_PATH ]] || { printf '[ERROR] platform-pki-csr-sign.sh not found\n' >&2; exit 1; }
  # shellcheck source=../../../../lib/platform-pki-csr-sign.sh disable=SC1091
  source "$CSR_COMMON_PATH"

  pki_reject_repeated_options --transaction --response-key --namespace --pki-dir --yes
  TRANSACTION=${args[--transaction]}
  [[ $TRANSACTION =~ ^csr-[0-9a-f]{32}$ ]] || pki_die 'CSR recovery transaction ID is invalid'
  NAMESPACE=${args[--namespace]:-$(pki_default_namespace)}
  PKI_DIR=${args[--pki-dir]:-}
  NAMESPACE=$(pki_expand_path "$NAMESPACE")
  PKI_DIR=${PKI_DIR:-${NAMESPACE}/pki}
  PKI_DIR=$(pki_expand_path "$PKI_DIR")
  if [[ ! -v args[--yes] ]]; then
    [[ -t 0 ]] || pki_die 'CSR recovery requires a TTY or --yes'
    printf 'Type recover %s to continue: ' "$TRANSACTION" >&2
    IFS= read -r confirmation
    [[ $confirmation == "recover $TRANSACTION" ]] || pki_die 'CSR recovery confirmation did not match'
  fi
  pki_csr_recover "${args[--response-key]:-}"

}

version_command() {
  echo "$version"
}

platform_pki_csr_recover_usage() {
  printf "platform-pki-csr-recover - Recover an authenticated host-local CSR signing transaction\n\n"

  printf "%s\n" "$(bold "Usage:")"
  printf "  platform-pki-csr-recover [OPTIONS]\n"
  printf "  platform-pki-csr-recover --help | -h\n"
  printf "  platform-pki-csr-recover --version | -v\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "$(bold "Options:")"

    printf "  %s\n" "$(magenta "--transaction ID (required)")"
    printf "    Exact csr-<request-id> transaction\n"
    echo

    printf "  %s\n" "$(magenta "--response-key PATH")"
    printf "    Trusted response-signing key when post-commit signing remains\n"
    echo

    printf "  %s\n" "$(magenta "--namespace PATH")"
    printf "    Platform namespace root\n"
    echo

    printf "  %s\n" "$(magenta "--pki-dir PATH")"
    printf "    PKI directory\n"
    echo

    printf "  %s\n" "$(magenta "--yes")"
    printf "    Confirm deterministic recovery without a TTY\n"
    echo

    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "$(magenta "--version, -v")"
    printf "    Show version number\n"
    echo

    printf "%s\n" "$(bold "Examples:")"
    printf "  platform-pki-csr-recover --transaction csr-0123456789abcdef0123456789abcdef\n  --response-key /secure/response_ed25519\n"
    echo

    printf "Uncommitted recovery restores only exact partial CA publication and keeps the\nrequest and nonce consumed. Committed recovery never rolls back or re-signs;\nit resumes exact response and pending-candidate publication. A response key\nis required only when the journaled response signature is absent.\n"
    echo

  fi
}

normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

enable_auto_colors() {
  if [[ -z ${NO_COLOR+x} && ! -t 1 ]]; then NO_COLOR=1; fi
}
print_in_color() {
  local color=$1
  shift
  if [[ ${NO_COLOR:-} == '' ]]; then printf "$color%b\e[0m\n" "$*"; else printf '%b\n' "$*"; fi
}
green() { print_in_color "\e[32m" "$*"; }
blue() { print_in_color "\e[34m" "$*"; }
magenta() { print_in_color "\e[35m" "$*"; }
cyan() { print_in_color "\e[36m" "$*"; }
bold() { print_in_color "\e[1m" "$*"; }

validate_not_empty() {
  [[ -n $1 ]] || printf '%s\n' 'must not be empty'
}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        platform_pki_csr_recover_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="root"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --transaction)

        if [[ -n ${2+x} ]]; then
          args['--transaction']="$2"
          shift
          shift
        else
          printf "%s\n" "--transaction requires an argument: --transaction ID" >&2
          exit 1
        fi
        ;;

      --response-key)

        if [[ -n ${2+x} ]]; then
          args['--response-key']="$2"
          shift
          shift
        else
          printf "%s\n" "--response-key requires an argument: --response-key PATH" >&2
          exit 1
        fi
        ;;

      --namespace)

        if [[ -n ${2+x} ]]; then
          args['--namespace']="$2"
          shift
          shift
        else
          printf "%s\n" "--namespace requires an argument: --namespace PATH" >&2
          exit 1
        fi
        ;;

      --pki-dir)

        if [[ -n ${2+x} ]]; then
          args['--pki-dir']="$2"
          shift
          shift
        else
          printf "%s\n" "--pki-dir requires an argument: --pki-dir PATH" >&2
          exit 1
        fi
        ;;

      --yes)

        args['--yes']=1
        shift
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  if [[ -z ${args['--transaction']+x} ]]; then
    printf "missing required flag: --transaction ID\n" >&2
    exit 1
  fi

  if [[ -v args['--transaction'] ]]; then
    validation_output="$(validate_not_empty "${args['--transaction']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--transaction ID" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--response-key'] ]]; then
    validation_output="$(validate_not_empty "${args['--response-key']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--response-key PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--namespace'] ]]; then
    validation_output="$(validate_not_empty "${args['--namespace']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--namespace PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--pki-dir'] ]]; then
    validation_output="$(validate_not_empty "${args['--pki-dir']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--pki-dir PATH" "$validation_output" >&2
      exit 1
    fi
  fi

}

initialize() {
  declare -g version="platform-pki-csr-recover 2.0.0"
  set -euo pipefail

  enable_auto_colors

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "root") root_command ;;
  esac
}

