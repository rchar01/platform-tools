validate_not_empty() {
  [[ -n $1 ]] || printf '%s\n' 'must not be empty'
}

validate_days() {
  if [[ ! $1 =~ ^[0-9]+$ ]]; then
    printf 'Days value must be numeric: %s\n' "$1"
  elif (( $1 < 1 )); then
    printf 'Days value must be at least 1: %s\n' "$1"
  fi
}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        platform_pki_service_verify_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="root"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --namespace)

        if [[ -n ${2+x} ]]; then
          args['--namespace']="$2"
          shift
          shift
        else
          printf "%s\n" "--namespace requires an argument: --namespace PATH" >&2
          exit 1
        fi
        ;;

      --pki-dir)

        if [[ -n ${2+x} ]]; then
          args['--pki-dir']="$2"
          shift
          shift
        else
          printf "%s\n" "--pki-dir requires an argument: --pki-dir PATH" >&2
          exit 1
        fi
        ;;

      --min-days)

        if [[ -n ${2+x} ]]; then
          args['--min-days']="$2"
          shift
          shift
        else
          printf "%s\n" "--min-days requires an argument: --min-days DAYS" >&2
          exit 1
        fi
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        if [[ -z ${args['service']+x} ]]; then
          args['service']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  if [[ -z ${args['service']+x} ]]; then
    printf "missing required argument: SERVICE\nusage: platform-pki-service-verify SERVICE [OPTIONS]\n" >&2

    exit 1
  fi

  [[ -n ${args['--min-days']:-} ]] || args['--min-days']="30"

  if [[ -v args['--namespace'] ]]; then
    validation_output="$(validate_not_empty "${args['--namespace']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--namespace PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--pki-dir'] ]]; then
    validation_output="$(validate_not_empty "${args['--pki-dir']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--pki-dir PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--min-days'] ]]; then
    validation_output="$(validate_days "${args['--min-days']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--min-days DAYS" "$validation_output" >&2
      exit 1
    fi
  fi

}

initialize() {
  declare -g version="platform-pki-service-verify 2.0.0"
  set -euo pipefail

  enable_auto_colors

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "root") root_command ;;
  esac
}

command_line_args=("$@")
initialize
run "${command_line_args[@]}"
