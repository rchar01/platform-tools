validate_not_empty() {
  [[ -n $1 ]] || printf '%s\n' 'must not be empty'
}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        platform_pki_backup_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="root"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --namespace)

        if [[ -n ${2+x} ]]; then
          args['--namespace']="$2"
          shift
          shift
        else
          printf "%s\n" "--namespace requires an argument: --namespace PATH" >&2
          exit 1
        fi
        ;;

      --pki-dir)

        if [[ -n ${2+x} ]]; then
          args['--pki-dir']="$2"
          shift
          shift
        else
          printf "%s\n" "--pki-dir requires an argument: --pki-dir PATH" >&2
          exit 1
        fi
        ;;

      --backup-dir)

        if [[ -n ${2+x} ]]; then
          args['--backup-dir']="$2"
          shift
          shift
        else
          printf "%s\n" "--backup-dir requires an argument: --backup-dir PATH" >&2
          exit 1
        fi
        ;;

      --age-recipient)

        if [[ -n ${2+x} ]]; then
          escaped="$(printf '%q' "$2")"
          if [[ -z ${args['--age-recipient']+x} ]]; then
            args['--age-recipient']="$escaped"
          else
            args['--age-recipient']="${args['--age-recipient']} $escaped"
          fi
          shift
          shift
        else
          printf "%s\n" "--age-recipient requires an argument: --age-recipient VALUE" >&2
          exit 1
        fi
        ;;

      --allow-plain-backup)

        args['--allow-plain-backup']=1
        shift
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  if [[ -v args['--namespace'] ]]; then
    validation_output="$(validate_not_empty "${args['--namespace']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--namespace PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--pki-dir'] ]]; then
    validation_output="$(validate_not_empty "${args['--pki-dir']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--pki-dir PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--backup-dir'] ]]; then
    validation_output="$(validate_not_empty "${args['--backup-dir']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--backup-dir PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--age-recipient'] ]]; then
    values=''
    eval "values=(${args['--age-recipient']})"
    for value in "${values[@]}"; do
      validation_output="$(validate_not_empty "$value")"
      if [[ -n "$validation_output" ]]; then
        printf "validation error in %s:\n%s\n" "--age-recipient VALUE" "$validation_output" >&2
        exit 1
      fi
    done
  fi

}

initialize() {
  declare -g version="platform-pki-backup 1.4.0"
  set -euo pipefail

  enable_auto_colors

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "root") root_command ;;
  esac
}

command_line_args=("$@")
initialize
run "${command_line_args[@]}"
