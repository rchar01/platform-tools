platform_pki_ca_rollover_migrate_command() {

  SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  COMMON_PATH=${PLATFORM_TOOLS_LIB_DIR:-}
  if [[ -n $COMMON_PATH ]]; then COMMON_PATH=${COMMON_PATH}/platform-pki-common.sh
  elif [[ -r ${SCRIPT_DIR}/../lib/platform-pki-common.sh ]]; then COMMON_PATH=${SCRIPT_DIR}/../lib/platform-pki-common.sh
  else COMMON_PATH=${PLATFORM_TOOLS_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/platform-tools}/lib/platform-pki-common.sh; fi
  [[ -r $COMMON_PATH ]] || { printf '[ERROR] platform-pki-common.sh not found\n' >&2; exit 1; }
  # shellcheck source=../../../../lib/platform-pki-common.sh disable=SC1091
  source "$COMMON_PATH"

  fault() {
    [[ ${PLATFORM_PKI_MIGRATE_CRASH_AT:-} != "$1" ]] || kill -KILL "$$"
    [[ ${PLATFORM_PKI_MIGRATE_FAIL_AT:-} != "$1" ]] || {
      pki_die "Injected migration interruption at $1"
    }
  }

  read_receipt() {
    local line key value
    declare -gA RECEIPT=()
    [[ -f $BACKUP_RECEIPT && ! -L $BACKUP_RECEIPT ]] || pki_die "Backup receipt must be a non-symlink regular file: $BACKUP_RECEIPT"
    [[ $(stat -c '%u:%a:%h' "$BACKUP_RECEIPT") == "$(id -u):600:1" ]] || pki_die 'Backup receipt must be current-user-owned, singly linked, and mode 600'
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line =~ ^([a-z0-9_]+)=(.*)$ ]] || pki_die 'Backup receipt has invalid content'
      key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
      [[ ! -v RECEIPT[$key] ]] || pki_die "Backup receipt contains duplicate field: $key"
      RECEIPT[$key]=$value
    done <"$BACKUP_RECEIPT"
    for key in schema layout session backup_path backup_device backup_inode backup_size backup_mode backup_owner archive_sha256 created_at created_epoch state_manifest_sha256 private_metadata_sha256; do
      [[ -v RECEIPT[$key] && -n ${RECEIPT[$key]} ]] || pki_die "Backup receipt is missing field: $key"
    done
    [[ ${#RECEIPT[@]} -eq 14 && ${RECEIPT[schema]} == 2 && ${RECEIPT[layout]} == legacy && ${RECEIPT[session]} =~ ^[0-9a-f]{32}$ && ${RECEIPT[created_epoch]} =~ ^[0-9]+$ ]] || pki_die 'Backup receipt is not a supported legacy-layout receipt'
    now=$(date -u +%s); (( now >= 10#${RECEIPT[created_epoch]} && now - 10#${RECEIPT[created_epoch]} <= 86400 )) || pki_die 'Backup receipt is older than the 24-hour migration freshness window'
    ARCHIVE=${RECEIPT[backup_path]}
    [[ $ARCHIVE == /* && -f $ARCHIVE && ! -L $ARCHIVE ]] || pki_die "Backup archive is missing or unsafe: $ARCHIVE"
    [[ $(stat -c '%d:%i:%s:%a:%u:%h' "$ARCHIVE") == "${RECEIPT[backup_device]}:${RECEIPT[backup_inode]}:${RECEIPT[backup_size]}:${RECEIPT[backup_mode]}:${RECEIPT[backup_owner]}:1" ]] || pki_die 'Backup archive identity no longer matches its receipt'
    archive_hash=$(sha256sum "$ARCHIVE"); [[ ${archive_hash%% *} == "${RECEIPT[archive_sha256]}" ]] || pki_die 'Backup archive digest no longer matches its receipt'
  }

  transform_config() {
    local source=$1 destination=$2 old=$3 new=$4 line replacements=0
    : >"$destination"
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line == "dir = $old" ]]; then printf 'dir = %s\n' "$new" >>"$destination"; replacements=$((replacements + 1))
      else printf '%s\n' "$line" >>"$destination"; fi
    done <"$source"
    [[ $replacements -eq 1 ]] || pki_die "Managed OpenSSL configuration has an unexpected directory: $source"
    chmod 600 "$destination"
  }

  write_journal() {
    pki_write_journal "$JOURNAL" "schema=2
  operation=legacy-migrate
  transaction=$TXN_ID
  phase=$1
  legacy_root=$LEGACY_ROOT
  legacy_intermediate=$LEGACY_INT
  new_root=$NEW_ROOT
  new_intermediate=$NEW_INT
  root_source_identity=$ROOT_SOURCE_ID
  intermediate_source_identity=$INT_SOURCE_ID
  root_sha256=$ROOT_FP
  intermediate_sha256=$INT_FP
  transaction_dir=$TXN_DIR
  transaction_identity=$TXN_IDENTITY
  provenance_stage=$PROVENANCE_STAGE
  provenance_dir=$PROVENANCE_DIR
  provenance_identity=$PROVENANCE_IDENTITY
  provenance_manifest=$PROVENANCE_MANIFEST
  provenance_manifest_identity=$PROVENANCE_MANIFEST_IDENTITY
  provenance_manifest_sha256=$PROVENANCE_MANIFEST_SHA256
  receipt_identity=$RECEIPT_IDENTITY
  services_sha256=$SERVICES_SHA256
  services_identity=$SERVICES_IDENTITY
  backup_receipt=$BACKUP_RECEIPT
  private_repo=$PRIVATE_REPO
  backup_session=$BACKUP_SESSION
  backup_session_original_identity=$BACKUP_SESSION_ORIGINAL_ID
  backup_session_published_identity=$BACKUP_SESSION_PUBLISHED_ID
  root_reservation=$ROOT_RESERVATION
  root_reservation_original_identity=$ROOT_RESERVATION_ORIGINAL_ID
  root_reservation_reserved_identity=$ROOT_RESERVATION_RESERVED_ID
  root_reservation_consumed_identity=$ROOT_RESERVATION_CONSUMED_ID
  root_reservation_rollback_identity=${ROOT_RESERVATION_ROLLBACK_ID:-absent}
  intermediate_reservation=$INT_RESERVATION
  intermediate_reservation_original_identity=$INT_RESERVATION_ORIGINAL_ID
  intermediate_reservation_reserved_identity=$INT_RESERVATION_RESERVED_ID
  intermediate_reservation_consumed_identity=$INT_RESERVATION_CONSUMED_ID
  intermediate_reservation_rollback_identity=${INT_RESERVATION_ROLLBACK_ID:-absent}
  root_config_original_identity=$ROOT_CONFIG_ORIGINAL_ID
  root_config_published_identity=$ROOT_CONFIG_PUBLISHED_ID
  root_config_rollback_identity=${ROOT_CONFIG_ROLLBACK_ID:-absent}
  root_config_backup_identity=$ROOT_CONFIG_BACKUP_ID
  intermediate_config_original_identity=$INT_CONFIG_ORIGINAL_ID
  intermediate_config_published_identity=$INT_CONFIG_PUBLISHED_ID
  intermediate_config_rollback_identity=${INT_CONFIG_ROLLBACK_ID:-absent}
  intermediate_config_backup_identity=$INT_CONFIG_BACKUP_ID
  issuer_ledger=$ISSUER_LEDGER
  issuer_ledger_identity=$ISSUER_LEDGER_ID
  issuer_ledger_sha256=$ISSUER_LEDGER_SHA256
  quarantine_ledger=$QUARANTINE_LEDGER
  quarantine_ledger_identity=$QUARANTINE_LEDGER_ID
  quarantine_ledger_sha256=$QUARANTINE_LEDGER_SHA256
  active_manifest=$ACTIVE_MANIFEST
  active_original_identity=$ACTIVE_ORIGINAL_ID
  active_published_identity=$ACTIVE_PUBLISHED_ID
  committed=${2:-false}
  "
  }

  require_authority_location() {
    local legacy=$1 generation=$2 identity=$3 label=$4 legacy_exists=false generation_exists=false
    [[ ! -e $legacy && ! -L $legacy ]] || legacy_exists=true
    [[ ! -e $generation && ! -L $generation ]] || generation_exists=true
    [[ $legacy_exists != "$generation_exists" ]] || pki_die "$label paths are simultaneously present or absent"
    if [[ $legacy_exists == true ]]; then [[ -d $legacy && ! -L $legacy && $(stat -c '%d:%i' "$legacy") == "$identity" ]] || pki_die "$label legacy identity changed"
    else [[ -d $generation && ! -L $generation && $(stat -c '%d:%i' "$generation") == "$identity" ]] || pki_die "$label generation identity changed"; fi
  }

  require_ledger() {
    local path=$1 identity=$2 digest=$3 label=$4 actual
    pki_require_file_identity "$path" "$identity" "$label"
    actual=$(sha256sum "$path"); [[ ${actual%% *} == "$digest" ]] || pki_die "$label digest changed"
  }

  preflight_migration_mutations() {
    local service issuer original published stage basename identity source destination
    pki_require_file_identity "$BACKUP_RECEIPT" "$RECEIPT_IDENTITY" 'Migration backup receipt'
    require_ledger "$ISSUER_LEDGER" "$ISSUER_LEDGER_ID" "$ISSUER_LEDGER_SHA256" 'Migration issuer ledger'
    require_ledger "$QUARANTINE_LEDGER" "$QUARANTINE_LEDGER_ID" "$QUARANTINE_LEDGER_SHA256" 'Migration quarantine ledger'
    require_ledger "$TXN_DIR/services" "$SERVICES_IDENTITY" "$SERVICES_SHA256" 'Migration service snapshot'
    pki_validate_provenance_manifest "$PROVENANCE_STAGE" "$PROVENANCE_MANIFEST" "$PROVENANCE_MANIFEST_IDENTITY" "$PROVENANCE_MANIFEST_SHA256"
    require_authority_location "$LEGACY_ROOT" "$NEW_ROOT" "$ROOT_SOURCE_ID" 'Root authority'; [[ -d $LEGACY_ROOT ]] || pki_die 'Root authority moved before migration mutation'
    require_authority_location "$LEGACY_INT" "$NEW_INT" "$INT_SOURCE_ID" 'Intermediate authority'; [[ -d $LEGACY_INT ]] || pki_die 'Intermediate authority moved before migration mutation'
    pki_require_file_identity "$LEGACY_ROOT/openssl.cnf" "$ROOT_CONFIG_ORIGINAL_ID" 'Root OpenSSL configuration'
    pki_require_file_identity "$LEGACY_INT/openssl.cnf" "$INT_CONFIG_ORIGINAL_ID" 'Intermediate OpenSSL configuration'
    pki_require_file_identity "$TXN_DIR/root-openssl.new" "$ROOT_CONFIG_PUBLISHED_ID" 'Staged root OpenSSL configuration'
    pki_require_file_identity "$TXN_DIR/intermediate-openssl.new" "$INT_CONFIG_PUBLISHED_ID" 'Staged intermediate OpenSSL configuration'
    pki_require_file_identity "$TXN_DIR/root-openssl.rollback" "$ROOT_CONFIG_ROLLBACK_ID" 'Staged root OpenSSL rollback'
    pki_require_file_identity "$TXN_DIR/intermediate-openssl.rollback" "$INT_CONFIG_ROLLBACK_ID" 'Staged intermediate OpenSSL rollback'
    pki_require_file_identity "$BACKUP_SESSION" "$BACKUP_SESSION_ORIGINAL_ID" 'Backup migration session'
    pki_require_file_identity "$TXN_DIR/backup-session.publish" "$BACKUP_SESSION_PUBLISHED_ID" 'Staged backup migration session'
    pki_require_file_identity "$ROOT_RESERVATION" "$ROOT_RESERVATION_ORIGINAL_ID" 'Root generation reservation'
    pki_require_file_identity "$INT_RESERVATION" "$INT_RESERVATION_ORIGINAL_ID" 'Intermediate generation reservation'
    pki_require_file_identity "$TXN_DIR/root-reserved.publish" "$ROOT_RESERVATION_RESERVED_ID" 'Staged root reservation'
    pki_require_file_identity "$TXN_DIR/intermediate-reserved.publish" "$INT_RESERVATION_RESERVED_ID" 'Staged intermediate reservation'
    pki_require_file_identity "$TXN_DIR/root-consumed.publish" "$ROOT_RESERVATION_CONSUMED_ID" 'Staged consumed root reservation'
    pki_require_file_identity "$TXN_DIR/intermediate-consumed.publish" "$INT_RESERVATION_CONSUMED_ID" 'Staged consumed intermediate reservation'
    pki_require_file_identity "$TXN_DIR/root-abandoned.publish" "$ROOT_RESERVATION_ROLLBACK_ID" 'Staged abandoned root reservation'
    pki_require_file_identity "$TXN_DIR/intermediate-abandoned.publish" "$INT_RESERVATION_ROLLBACK_ID" 'Staged abandoned intermediate reservation'
    pki_require_file_identity "$ACTIVE_MANIFEST" "$ACTIVE_ORIGINAL_ID" 'Active issuer manifest'
    pki_require_file_identity "$TXN_DIR/active.publish" "$ACTIVE_PUBLISHED_ID" 'Staged active issuer manifest'
    pki_require_file_identity "$PROVENANCE_DIR" absent 'Migration provenance destination'
    while IFS='|' read -r service original published; do
      issuer=$(pki_service_issuer "$service"); stage="$TXN_DIR/issuer-stage/$service"
      pki_require_file_identity "$issuer" "$original" "Service $service issuer"
      pki_require_file_identity "$stage" "$published" "Staged issuer $service"
    done <"$ISSUER_LEDGER"
    while IFS='|' read -r basename identity; do
      source="$PKI_DIR/$basename"; destination="$TXN_DIR/quarantine/$basename"
      pki_require_file_identity "$source" "$identity" 'Legacy quarantine source'
      pki_require_file_identity "$destination" absent 'Legacy quarantine destination'
    done <"$QUARANTINE_LEDGER"
  }

  finish_migrate() {
    local status=$?
    trap - EXIT; trap '' HUP INT TERM
    if [[ ${MUTATION_STARTED:-false} == true && ${COMMITTED:-false} != true ]]; then
      pki_atomic_write "$RECOVERY_MARKER" "transaction=$TXN_ID
  action=run platform-pki-ca-rollover recover
  " || status=1
    fi
    [[ -z ${SNAPSHOT_DIR:-} || ! -d $SNAPSHOT_DIR ]] || rm -rf "$SNAPSHOT_DIR"
    [[ ${EXPORT_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$EXPORT_LOCK" 2>/dev/null || status=1
    [[ ${INVENTORY_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$INVENTORY_LOCK" 2>/dev/null || status=1
    [[ ${INTERMEDIATE_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$INTERMEDIATE_LOCK" 2>/dev/null || status=1
    [[ ${ROOT_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$ROOT_LOCK" 2>/dev/null || status=1
    exit "$status"
  }

  NAMESPACE=${args[--namespace]:-$(pki_default_namespace)}; PKI_DIR=${args[--pki-dir]:-}
  BACKUP_RECEIPT=$(pki_expand_path "${args[--backup-receipt]}"); PRIVATE_REPO=$(pki_expand_path "${args[--private-repo]}")
  YES=false; [[ -v args[--yes] ]] && YES=true
  EXPECTED_ROOT=${args[--expected-root-sha256]:-}; EXPECTED_INT=${args[--expected-intermediate-sha256]:-}
  NAMESPACE=$(pki_expand_path "$NAMESPACE"); PKI_DIR=${PKI_DIR:-${NAMESPACE}/pki}; PKI_DIR=$(pki_expand_path "$PKI_DIR")
  pki_require_cmd openssl; pki_require_cmd sha256sum; pki_require_pki_dir; pki_prepare_control_state
  [[ $BACKUP_RECEIPT == /* ]] || BACKUP_RECEIPT="$(pwd -P)/$BACKUP_RECEIPT"
  [[ $PRIVATE_REPO == /* ]] || PRIVATE_REPO="$(pwd -P)/$PRIVATE_REPO"
  read_receipt

  ROOT_LOCK=$(pki_root_operation_lock); INTERMEDIATE_LOCK=$(pki_intermediate_operation_lock)
  INVENTORY_LOCK=$(pki_inventory_operation_lock); EXPORT_LOCK=$(pki_export_operation_lock)
  SNAPSHOT_DIR=''; MUTATION_STARTED=false; COMMITTED=false
  trap finish_migrate EXIT; trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
  pki_acquire_operation_lock "$ROOT_LOCK" 'root CA operation'; ROOT_LOCK_HELD=true
  pki_acquire_operation_lock "$INTERMEDIATE_LOCK" 'intermediate CA operation'; INTERMEDIATE_LOCK_HELD=true
  pki_acquire_operation_lock "$INVENTORY_LOCK" 'inventory operation'; INVENTORY_LOCK_HELD=true
  pki_acquire_operation_lock "$EXPORT_LOCK" 'export operation'; EXPORT_LOCK_HELD=true
  pki_require_no_unresolved_journal
  LAYOUT=$(pki_detect_layout)
  if [[ $LAYOUT == generation ]]; then
    pki_load_active_issuer_snapshot
    [[ $ACTIVE_ROOT_ID == g1 && $ACTIVE_INTERMEDIATE_ID == g1-i1 ]] || pki_die 'Existing generation layout is not the completed legacy migration pair'
    pki_ok 'Legacy PKI migration is already complete; no changes made'
    exit 0
  fi
  [[ $LAYOUT == legacy ]] || pki_die "Legacy migration refuses incomplete or ambiguous layout: $LAYOUT"
  [[ $(pki_public_state_digest legacy) == "${RECEIPT[state_manifest_sha256]}" ]] || pki_die 'Current public PKI state differs from the backed-up state manifest'
  [[ $(pki_private_metadata_digest) == "${RECEIPT[private_metadata_sha256]}" ]] || pki_die 'Current private metadata differs from the backed-up state'

  LEGACY_ROOT="$PKI_DIR/root-ca"; LEGACY_INT="$PKI_DIR/intermediate-ca"
  NEW_ROOT=$(pki_root_authority_dir g1); NEW_INT=$(pki_intermediate_authority_dir g1-i1)
  for dir in "$LEGACY_ROOT" "$LEGACY_INT"; do pki_require_private_dir "$dir" 'Legacy CA directory'; done
  ROOT_CERT="$LEGACY_ROOT/certs/root-ca.crt"; INT_CERT="$LEGACY_INT/certs/intermediate-ca.crt"
  for path in "$ROOT_CERT" "$INT_CERT" "$LEGACY_ROOT/openssl.cnf" "$LEGACY_INT/openssl.cnf"; do pki_require_file "$path"; done
  openssl verify -CAfile "$ROOT_CERT" "$INT_CERT" >/dev/null || pki_die 'Legacy intermediate does not verify against the legacy root'
  ROOT_FP=$(openssl x509 -in "$ROOT_CERT" -noout -fingerprint -sha256); ROOT_FP=${ROOT_FP#*=}; ROOT_FP=${ROOT_FP//:/}; ROOT_FP=${ROOT_FP^^}
  INT_FP=$(openssl x509 -in "$INT_CERT" -noout -fingerprint -sha256); INT_FP=${INT_FP#*=}; INT_FP=${INT_FP//:/}; INT_FP=${INT_FP^^}
  if [[ $YES == true ]]; then
    [[ $EXPECTED_ROOT =~ ^[0-9A-Fa-f]{64}$ && $EXPECTED_INT =~ ^[0-9A-Fa-f]{64}$ ]] || pki_die '--yes requires both expected 64-hex SHA-256 fingerprints'
    [[ ${EXPECTED_ROOT^^} == "$ROOT_FP" && ${EXPECTED_INT^^} == "$INT_FP" ]] || pki_die 'Expected CA fingerprints do not match legacy certificates'
  else
    [[ -t 0 ]] || pki_die 'Migration confirmation requires a TTY or --yes with both expected fingerprints'
    printf 'Type migrate %s %s to continue: ' "$ROOT_FP" "$INT_FP" >&2
    IFS= read -r confirmation
    [[ $confirmation == "migrate $ROOT_FP $INT_FP" ]] || pki_die 'Migration confirmation did not match'
  fi

  SNAPSHOT_DIR=$(mktemp -d "${TMPDIR:-/tmp}/platform-pki-migrate.XXXXXX")
  pki_load_inventory_snapshot "$SNAPSHOT_DIR"
  pki_validate_legacy_state
  PRIVATE_INVENTORY="$PRIVATE_REPO/pki/services.yml"
  pki_require_no_symlink_path_components "$PRIVATE_REPO" 'Private repository'
  [[ -f $PRIVATE_INVENTORY && ! -L $PRIVATE_INVENTORY ]] || pki_die "Canonical private inventory is missing or unsafe: $PRIVATE_INVENTORY"
  [[ $(stat -c '%u:%h:%a' "$PRIVATE_INVENTORY") == "$(id -u):1:600" ]] || pki_die 'Canonical private inventory must be current-user-owned, singly linked, and mode 600'
  pki_validate_inventory_file "$PRIVATE_INVENTORY" "$SNAPSHOT_DIR/private-canonical"
  LC_ALL=C sort "$INVENTORY_CANONICAL" >"$SNAPSHOT_DIR/local-sorted"; LC_ALL=C sort "$SNAPSHOT_DIR/private-canonical" >"$SNAPSHOT_DIR/private-sorted"
  cmp -s "$SNAPSHOT_DIR/local-sorted" "$SNAPSHOT_DIR/private-sorted" || pki_die 'Active inventory differs semantically from the canonical private inventory; install and review it before migration'

  while IFS= read -r service; do
    cert=$(pki_service_cert "$service"); [[ -e $cert ]] || continue
    [[ -f $cert && ! -L $cert ]] || pki_die "Current service certificate is unsafe: $cert"
    openssl verify -CAfile "$ROOT_CERT" -untrusted "$INT_CERT" "$cert" >/dev/null || pki_die "Service does not verify through the legacy issuer: $service"
  done < <(pki_inventory_services)
  ROOT_SOURCE_ID=$(stat -c '%d:%i' "$LEGACY_ROOT"); INT_SOURCE_ID=$(stat -c '%d:%i' "$LEGACY_INT")
  [[ $(stat -c '%d' "$LEGACY_ROOT") == $(stat -c '%d' "$PKI_DIR/authorities/roots") && $(stat -c '%d' "$LEGACY_INT") == $(stat -c '%d' "$PKI_DIR/authorities/intermediates") ]] || pki_die 'Legacy CA directories and generation destinations must be on the same filesystem'
  ROOT_RESERVATION=$(pki_generation_reservation g1); INT_RESERVATION=$(pki_generation_reservation g1-i1)
  ROOT_RESERVATION_ORIGINAL_ID=$(pki_file_identity_or_absent "$ROOT_RESERVATION"); INT_RESERVATION_ORIGINAL_ID=$(pki_file_identity_or_absent "$INT_RESERVATION")
  for record in "$ROOT_RESERVATION|g1|root|$ROOT_FP|$ROOT_SOURCE_ID|$ROOT_RESERVATION_ORIGINAL_ID" "$INT_RESERVATION|g1-i1|intermediate|$INT_FP|$INT_SOURCE_ID|$INT_RESERVATION_ORIGINAL_ID"; do
    path=${record%%|*}; rest=${record#*|}; generation=${rest%%|*}; rest=${rest#*|}; kind=${rest%%|*}; rest=${rest#*|}; fp=${rest%%|*}; rest=${rest#*|}; identity=${rest%%|*}; original_id=${rest#*|}
    [[ $original_id == absent ]] && continue
    pki_read_state_record "$path" 'Legacy migration generation reservation'
    [[ ${#PKI_RECORD[@]} -eq 5 && ${PKI_RECORD[generation]:-} == "$generation" && ${PKI_RECORD[kind]:-} == "$kind" && ${PKI_RECORD[status]:-} == abandoned && ${PKI_RECORD[fingerprint_sha256]:-} == "$fp" && ${PKI_RECORD[source_identity]:-} == "$identity" && $(pki_file_object_state "$path") == "$original_id" ]] || pki_die "Generation reservation cannot be safely adopted: $path"
  done

  TXN_ID="migrate-$(date -u '+%Y%m%d-%H%M%S')-$$"; TXN_DIR="$PKI_DIR/state/rollover/$TXN_ID"; mkdir -m 700 "$TXN_DIR"; TXN_IDENTITY=$(pki_dir_identity "$TXN_DIR"); RECEIPT_IDENTITY=$(pki_file_identity "$BACKUP_RECEIPT")
  cp -p "$LEGACY_ROOT/openssl.cnf" "$TXN_DIR/root-openssl.cnf"; cp -p "$LEGACY_INT/openssl.cnf" "$TXN_DIR/intermediate-openssl.cnf"
  transform_config "$LEGACY_ROOT/openssl.cnf" "$TXN_DIR/root-openssl.new" "$LEGACY_ROOT" "$NEW_ROOT"
  transform_config "$LEGACY_INT/openssl.cnf" "$TXN_DIR/intermediate-openssl.new" "$LEGACY_INT" "$NEW_INT"
  ROOT_CONFIG_ORIGINAL_ID=$(pki_file_object_state "$LEGACY_ROOT/openssl.cnf"); INT_CONFIG_ORIGINAL_ID=$(pki_file_object_state "$LEGACY_INT/openssl.cnf")
  ROOT_CONFIG_BACKUP_ID=$(pki_file_object_state "$TXN_DIR/root-openssl.cnf"); INT_CONFIG_BACKUP_ID=$(pki_file_object_state "$TXN_DIR/intermediate-openssl.cnf")
  ROOT_CONFIG_PUBLISHED_ID=$(pki_file_object_state "$TXN_DIR/root-openssl.new"); INT_CONFIG_PUBLISHED_ID=$(pki_file_object_state "$TXN_DIR/intermediate-openssl.new")
  printf 'public_state_sha256=%s\n' "${RECEIPT[state_manifest_sha256]}" >"$TXN_DIR/baseline"
  for private in "$LEGACY_ROOT/private/root-ca.key" "$LEGACY_INT/private/intermediate-ca.key"; do [[ ! -e $private ]] || stat -c 'private_metadata=%n|%d|%i|%u|%a|%s|%y|%z' "$private" >>"$TXN_DIR/baseline"; done
  chmod 600 "$TXN_DIR"/*; mkdir -m 700 "$TXN_DIR/issuer-stage" "$TXN_DIR/quarantine"
  while IFS= read -r service; do [[ ! -f $(pki_service_cert "$service") ]] || printf '%s\n' "$service"; done < <(pki_inventory_services) >"$TXN_DIR/services"; chmod 600 "$TXN_DIR/services"; pki_fsync "$TXN_DIR/services"; SERVICES_IDENTITY=$(pki_file_identity "$TXN_DIR/services"); SERVICES_SHA256=$(sha256sum "$TXN_DIR/services"); SERVICES_SHA256=${SERVICES_SHA256%% *}; pki_fsync "$TXN_DIR"
  JOURNAL=$(pki_recovery_journal); RECOVERY_MARKER=$(pki_recovery_marker); ACTIVE_MANIFEST=$(pki_active_issuer_manifest)
  ACTIVE_ORIGINAL_ID=$(pki_file_identity_or_absent "$ACTIVE_MANIFEST"); [[ $ACTIVE_ORIGINAL_ID == absent ]] || pki_die 'Legacy migration active manifest destination already exists'
  BACKUP_SESSION="$PKI_DIR/state/rollover/backup-session-${RECEIPT[session]}"; BACKUP_SESSION_ORIGINAL_ID=$(pki_file_identity_or_absent "$BACKUP_SESSION"); [[ $BACKUP_SESSION_ORIGINAL_ID == absent ]] || pki_die 'Backup migration session was already consumed'
  pki_atomic_write "$TXN_DIR/backup-session.publish" "session=${RECEIPT[session]}
  archive_sha256=${RECEIPT[archive_sha256]}
  transaction=$TXN_ID
  "; BACKUP_SESSION_PUBLISHED_ID=$(pki_file_object_state "$TXN_DIR/backup-session.publish")
  pki_atomic_write "$TXN_DIR/root-reserved.publish" "generation=g1
  kind=root
  status=reserved
  fingerprint_sha256=$ROOT_FP
  source_identity=$ROOT_SOURCE_ID
  "; ROOT_RESERVATION_RESERVED_ID=$(pki_file_object_state "$TXN_DIR/root-reserved.publish")
  pki_atomic_write "$TXN_DIR/intermediate-reserved.publish" "generation=g1-i1
  kind=intermediate
  status=reserved
  fingerprint_sha256=$INT_FP
  source_identity=$INT_SOURCE_ID
  "; INT_RESERVATION_RESERVED_ID=$(pki_file_object_state "$TXN_DIR/intermediate-reserved.publish")
  pki_atomic_write "$TXN_DIR/root-consumed.publish" "generation=g1
  kind=root
  status=consumed
  fingerprint_sha256=$ROOT_FP
  source_identity=$ROOT_SOURCE_ID
  "; ROOT_RESERVATION_CONSUMED_ID=$(pki_file_object_state "$TXN_DIR/root-consumed.publish")
  pki_atomic_write "$TXN_DIR/intermediate-consumed.publish" "generation=g1-i1
  kind=intermediate
  status=consumed
  fingerprint_sha256=$INT_FP
  source_identity=$INT_SOURCE_ID
  "; INT_RESERVATION_CONSUMED_ID=$(pki_file_object_state "$TXN_DIR/intermediate-consumed.publish")
  pki_atomic_write "$TXN_DIR/root-abandoned.publish" "generation=g1
  kind=root
  status=abandoned
  fingerprint_sha256=$ROOT_FP
  source_identity=$ROOT_SOURCE_ID
  "; ROOT_RESERVATION_ROLLBACK_ID=$(pki_file_object_state "$TXN_DIR/root-abandoned.publish")
  pki_atomic_write "$TXN_DIR/intermediate-abandoned.publish" "generation=g1-i1
  kind=intermediate
  status=abandoned
  fingerprint_sha256=$INT_FP
  source_identity=$INT_SOURCE_ID
  "; INT_RESERVATION_ROLLBACK_ID=$(pki_file_object_state "$TXN_DIR/intermediate-abandoned.publish")
  cp -p "$TXN_DIR/root-openssl.cnf" "$TXN_DIR/root-openssl.rollback"; ROOT_CONFIG_ROLLBACK_ID=$(pki_file_object_state "$TXN_DIR/root-openssl.rollback")
  cp -p "$TXN_DIR/intermediate-openssl.cnf" "$TXN_DIR/intermediate-openssl.rollback"; INT_CONFIG_ROLLBACK_ID=$(pki_file_object_state "$TXN_DIR/intermediate-openssl.rollback")
  pki_atomic_write "$TXN_DIR/active.publish" "root=g1
  intermediate=g1-i1
  "; ACTIVE_PUBLISHED_ID=$(pki_file_object_state "$TXN_DIR/active.publish")
  ISSUER_LEDGER="$TXN_DIR/issuer-identities"; : >"$ISSUER_LEDGER"
  while IFS= read -r service; do issuer=$(pki_service_issuer "$service"); original=$(pki_file_identity_or_absent "$issuer"); [[ $original == absent ]] || pki_die "Service issuer record already exists during legacy migration: $issuer"; stage="$TXN_DIR/issuer-stage/$service"; pki_atomic_write "$stage" "root=g1
  intermediate=g1-i1
  "; printf '%s|%s|%s\n' "$service" "$original" "$(pki_file_object_state "$stage")" >>"$ISSUER_LEDGER"; done <"$TXN_DIR/services"
  chmod 600 "$ISSUER_LEDGER"; pki_fsync "$ISSUER_LEDGER"; ISSUER_LEDGER_ID=$(pki_file_identity "$ISSUER_LEDGER"); ISSUER_LEDGER_SHA256=$(sha256sum "$ISSUER_LEDGER"); ISSUER_LEDGER_SHA256=${ISSUER_LEDGER_SHA256%% *}
  QUARANTINE_LEDGER="$TXN_DIR/quarantine-identities"; : >"$QUARANTINE_LEDGER"
  for old in "$PKI_DIR/pki.env" "$PKI_DIR/openssl-root.cnf.tpl" "$PKI_DIR/openssl-intermediate.cnf.tpl" "$PKI_DIR/openssl-service.cnf.tpl"; do [[ ! -e $old && ! -L $old ]] && continue; [[ -f $old && ! -L $old ]] || pki_die "Legacy quarantine source is unsafe: $old"; basename=$(basename -- "$old"); destination="$TXN_DIR/quarantine/$basename"; pki_require_file_identity "$destination" absent 'Legacy quarantine destination'; printf '%s|%s\n' "$basename" "$(pki_file_object_state "$old")" >>"$QUARANTINE_LEDGER"; done
  chmod 600 "$QUARANTINE_LEDGER"; pki_fsync "$QUARANTINE_LEDGER"; QUARANTINE_LEDGER_ID=$(pki_file_identity "$QUARANTINE_LEDGER"); QUARANTINE_LEDGER_SHA256=$(sha256sum "$QUARANTINE_LEDGER"); QUARANTINE_LEDGER_SHA256=${QUARANTINE_LEDGER_SHA256%% *}; pki_fsync_tree "$TXN_DIR"
  if [[ ! -e $PKI_DIR/legacy && ! -L $PKI_DIR/legacy ]]; then mkdir -m 700 "$PKI_DIR/legacy"; pki_fsync "$PKI_DIR"; fi
  pki_require_private_dir "$PKI_DIR/legacy" 'Migration provenance directory'
  PROVENANCE_STAGE="$PKI_DIR/legacy/.$TXN_ID.publish"; PROVENANCE_DIR="$PKI_DIR/legacy/$TXN_ID"; pki_require_file_identity "$PROVENANCE_STAGE" absent 'Migration provenance stage'; pki_require_file_identity "$PROVENANCE_DIR" absent 'Migration provenance destination'
  cp -a "$TXN_DIR" "$PROVENANCE_STAGE"
  while IFS='|' read -r basename identity; do [[ -n $basename ]] || continue; pki_require_file_identity "$PKI_DIR/$basename" "$identity" 'Legacy provenance source'; cp -p -- "$PKI_DIR/$basename" "$PROVENANCE_STAGE/quarantine/$basename"; done <"$QUARANTINE_LEDGER"
  printf 'Legacy singleton CA directories were moved without copying private keys.\nOriginal managed OpenSSL configurations and quarantined legacy scaffolding are retained here.\n' >"$PROVENANCE_STAGE/README"; chmod 600 "$PROVENANCE_STAGE/README"
  PROVENANCE_MANIFEST="$PROVENANCE_STAGE/provenance-manifest"; pki_atomic_write "$PROVENANCE_MANIFEST" "$(pki_provenance_manifest "$PROVENANCE_STAGE")"
  PROVENANCE_MANIFEST_IDENTITY=$(pki_file_identity "$PROVENANCE_MANIFEST"); PROVENANCE_MANIFEST_SHA256=$(sha256sum "$PROVENANCE_MANIFEST"); PROVENANCE_MANIFEST_SHA256=${PROVENANCE_MANIFEST_SHA256%% *}
  pki_fsync_tree "$PROVENANCE_STAGE"; PROVENANCE_IDENTITY=$(pki_dir_identity "$PROVENANCE_STAGE")
  preflight_migration_mutations
  write_journal pre-mutation
  MUTATION_STARTED=true
  fault after-journal
  pki_require_file_identity "$BACKUP_SESSION" "$BACKUP_SESSION_ORIGINAL_ID" 'Backup migration session'; pki_publish_staged_file "$TXN_DIR/backup-session.publish" "$BACKUP_SESSION"
  pki_require_file_identity "$ROOT_RESERVATION" "$ROOT_RESERVATION_ORIGINAL_ID" 'Root generation reservation'; pki_publish_staged_file "$TXN_DIR/root-reserved.publish" "$ROOT_RESERVATION"
  pki_require_file_identity "$INT_RESERVATION" "$INT_RESERVATION_ORIGINAL_ID" 'Intermediate generation reservation'; pki_publish_staged_file "$TXN_DIR/intermediate-reserved.publish" "$INT_RESERVATION"
  write_journal reserved; fault after-reservations
  require_authority_location "$LEGACY_ROOT" "$NEW_ROOT" "$ROOT_SOURCE_ID" 'Root authority'; pki_require_file_identity "$NEW_ROOT" absent 'Root generation destination'; mv -T "$LEGACY_ROOT" "$NEW_ROOT"; [[ $(stat -c '%d:%i' "$NEW_ROOT") == "$ROOT_SOURCE_ID" ]] || pki_die 'Migrated root authority identity changed'; pki_fsync_rename_parents "$(dirname -- "$LEGACY_ROOT")" "$(dirname -- "$NEW_ROOT")"; write_journal root-renamed; fault after-root-rename
  require_authority_location "$LEGACY_INT" "$NEW_INT" "$INT_SOURCE_ID" 'Intermediate authority'; pki_require_file_identity "$NEW_INT" absent 'Intermediate generation destination'; mv -T "$LEGACY_INT" "$NEW_INT"; [[ $(stat -c '%d:%i' "$NEW_INT") == "$INT_SOURCE_ID" ]] || pki_die 'Migrated intermediate authority identity changed'; pki_fsync_rename_parents "$(dirname -- "$LEGACY_INT")" "$(dirname -- "$NEW_INT")"; write_journal intermediate-renamed; fault after-intermediate-rename
  pki_require_file_identity "$NEW_ROOT/openssl.cnf" "$ROOT_CONFIG_ORIGINAL_ID" 'Root OpenSSL configuration'; pki_require_file_identity "$NEW_INT/openssl.cnf" "$INT_CONFIG_ORIGINAL_ID" 'Intermediate OpenSSL configuration'; pki_publish_staged_file "$TXN_DIR/root-openssl.new" "$NEW_ROOT/openssl.cnf"; pki_publish_staged_file "$TXN_DIR/intermediate-openssl.new" "$NEW_INT/openssl.cnf"
  write_journal configs-published; fault after-configs
  while IFS='|' read -r service original published; do [[ -n $service ]] || continue; issuer=$(pki_service_issuer "$service"); stage="$TXN_DIR/issuer-stage/$service"; pki_require_file_identity "$issuer" "$original" "Service $service issuer"; pki_require_file_identity "$stage" "$published" "Service $service staged issuer"; pki_publish_staged_file "$stage" "$issuer"; done <"$ISSUER_LEDGER"
  write_journal issuers-published; fault after-issuers
  while IFS='|' read -r basename identity; do [[ -n $basename ]] || continue; source="$PKI_DIR/$basename"; destination="$TXN_DIR/quarantine/$basename"; pki_require_file_identity "$source" "$identity" 'Legacy quarantine source'; pki_require_file_identity "$destination" absent 'Legacy quarantine destination'; mv -T -- "$source" "$destination"; pki_fsync_rename_parents "$(dirname -- "$source")" "$(dirname -- "$destination")"; pki_require_file_identity "$destination" "$identity" 'Published quarantine entry'; done <"$QUARANTINE_LEDGER"
  write_journal quarantined; fault after-quarantine
  pki_require_file_identity "$ROOT_RESERVATION" "$ROOT_RESERVATION_RESERVED_ID" 'Reserved root generation'; pki_publish_staged_file "$TXN_DIR/root-consumed.publish" "$ROOT_RESERVATION"
  pki_require_file_identity "$INT_RESERVATION" "$INT_RESERVATION_RESERVED_ID" 'Reserved intermediate generation'; pki_publish_staged_file "$TXN_DIR/intermediate-consumed.publish" "$INT_RESERVATION"
  write_journal active-pending; pki_require_file_identity "$ACTIVE_MANIFEST" "$ACTIVE_ORIGINAL_ID" 'Active issuer manifest'; pki_publish_staged_file "$TXN_DIR/active.publish" "$ACTIVE_MANIFEST"; write_journal active-published; fault after-active
  pki_require_file_identity "$PROVENANCE_DIR" absent 'Migration provenance destination'; mv -T -- "$PROVENANCE_STAGE" "$PROVENANCE_DIR"; pki_fsync_rename_parents "$(dirname -- "$PROVENANCE_STAGE")" "$(dirname -- "$PROVENANCE_DIR")"; [[ $(pki_dir_identity "$PROVENANCE_DIR") == "$PROVENANCE_IDENTITY" ]] || pki_die 'Migration provenance identity changed during publication'; write_journal provenance-published
  write_journal complete true; rm -f -- "$RECOVERY_MARKER"; pki_fsync "$(dirname -- "$RECOVERY_MARKER")"; COMMITTED=true
  pki_remove_journaled_tree "$TXN_DIR" "$TXN_IDENTITY" "$(dirname -- "$TXN_DIR")" || pki_die 'Cannot remove committed migration transaction staging'
  pki_ok 'Migrated legacy PKI state to root g1 and intermediate g1-i1'

}

platform_pki_ca_rollover_status_command() {

  SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  COMMON_PATH=${PLATFORM_TOOLS_LIB_DIR:-}
  if [[ -n $COMMON_PATH ]]; then COMMON_PATH=${COMMON_PATH}/platform-pki-common.sh
  elif [[ -r ${SCRIPT_DIR}/../lib/platform-pki-common.sh ]]; then COMMON_PATH=${SCRIPT_DIR}/../lib/platform-pki-common.sh
  else COMMON_PATH=${PLATFORM_TOOLS_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/platform-tools}/lib/platform-pki-common.sh; fi
  [[ -r $COMMON_PATH ]] || { printf '[ERROR] platform-pki-common.sh not found\n' >&2; exit 1; }
  # shellcheck source=../../../../lib/platform-pki-common.sh disable=SC1091
  source "$COMMON_PATH"

  NAMESPACE=${args[--namespace]:-$(pki_default_namespace)}; PKI_DIR=${args[--pki-dir]:-}
  NAMESPACE=$(pki_expand_path "$NAMESPACE"); PKI_DIR=${PKI_DIR:-${NAMESPACE}/pki}; PKI_DIR=$(pki_expand_path "$PKI_DIR")
  pki_require_pki_dir; pki_prepare_control_state
  ROOT_LOCK=$(pki_root_operation_lock); INTERMEDIATE_LOCK=$(pki_intermediate_operation_lock)
  INVENTORY_LOCK=$(pki_inventory_operation_lock); EXPORT_LOCK=$(pki_export_operation_lock)
  finish_status() {
    local status=$?
    trap - EXIT
    [[ ${EXPORT_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$EXPORT_LOCK" 2>/dev/null || status=2
    [[ ${INVENTORY_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$INVENTORY_LOCK" 2>/dev/null || status=2
    [[ ${INTERMEDIATE_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$INTERMEDIATE_LOCK" 2>/dev/null || status=2
    [[ ${ROOT_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$ROOT_LOCK" 2>/dev/null || status=2
    exit "$status"
  }
  trap finish_status EXIT
  pki_acquire_operation_lock "$ROOT_LOCK" 'root CA operation'; ROOT_LOCK_HELD=true
  pki_acquire_operation_lock "$INTERMEDIATE_LOCK" 'intermediate CA operation'; INTERMEDIATE_LOCK_HELD=true
  pki_acquire_operation_lock "$INVENTORY_LOCK" 'inventory operation'; INVENTORY_LOCK_HELD=true
  pki_acquire_operation_lock "$EXPORT_LOCK" 'export operation'; EXPORT_LOCK_HELD=true
  JOURNAL=$(pki_recovery_journal); MARKER=$(pki_recovery_marker); declare -A PKI_RECORD=()
  if [[ -e $MARKER || -L $MARKER ]]; then
    [[ -f $MARKER && ! -L $MARKER && $(stat -c '%u:%a:%h' "$MARKER") == "$(id -u):600:1" ]] || pki_die "PKI recovery marker is unsafe: $MARKER"
  fi
  if [[ -e $JOURNAL || -L $JOURNAL ]]; then
    pki_read_state_record "$JOURNAL" 'PKI recovery journal'
  fi
  if [[ -e $MARKER || ${PKI_RECORD[committed]:-true} != true ]]; then
    printf 'status=recovery-required\ntransaction=%s\naction=run platform-pki-ca-rollover recover\n' "${PKI_RECORD[transaction]:-unknown}"
    exit 2
  fi
  LAYOUT=$(pki_detect_layout)
  case $LAYOUT in
    legacy)
      printf 'status=legacy\naction=run platform-pki-backup, then platform-pki-ca-rollover migrate\n'
      exit 1
      ;;
    generation)
      pki_load_active_issuer_snapshot
      printf 'status=ready\nactive_root=%s\nactive_intermediate=%s\n' "$ACTIVE_ROOT_ID" "$ACTIVE_INTERMEDIATE_ID"
      ;;
    *)
      printf 'status=%s\naction=repair incomplete or ambiguous PKI layout before continuing\n' "$LAYOUT"
      exit 2
      ;;
  esac

}

platform_pki_ca_rollover_recover_command() {

  SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  COMMON_PATH=${PLATFORM_TOOLS_LIB_DIR:-}
  if [[ -n $COMMON_PATH ]]; then COMMON_PATH=${COMMON_PATH}/platform-pki-common.sh
  elif [[ -r ${SCRIPT_DIR}/../lib/platform-pki-common.sh ]]; then COMMON_PATH=${SCRIPT_DIR}/../lib/platform-pki-common.sh
  else COMMON_PATH=${PLATFORM_TOOLS_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/platform-tools}/lib/platform-pki-common.sh; fi
  [[ -r $COMMON_PATH ]] || { printf '[ERROR] platform-pki-common.sh not found\n' >&2; exit 1; }
  # shellcheck source=../../../../lib/platform-pki-common.sh disable=SC1091
  source "$COMMON_PATH"

  NAMESPACE=${args[--namespace]:-$(pki_default_namespace)}; PKI_DIR=${args[--pki-dir]:-}
  TRANSACTION=${args[--transaction]}; ACTION=${args[--action]}; YES=false; [[ -v args[--yes] ]] && YES=true
  NAMESPACE=$(pki_expand_path "$NAMESPACE"); PKI_DIR=${PKI_DIR:-${NAMESPACE}/pki}; PKI_DIR=$(pki_expand_path "$PKI_DIR")
  [[ $TRANSACTION =~ ^(migrate|root-bootstrap|intermediate-bootstrap)-[0-9]{8}-[0-9]{6}-[0-9]+$ ]] || pki_die 'Recovery transaction ID is invalid'
  if [[ $YES != true ]]; then
    [[ -t 0 ]] || pki_die 'Recovery requires a TTY or --yes'
    printf 'Type recover %s %s to continue: ' "$TRANSACTION" "$ACTION" >&2
    IFS= read -r confirmation; [[ $confirmation == "recover $TRANSACTION $ACTION" ]] || pki_die 'Recovery confirmation did not match'
  fi
  pki_require_pki_dir; pki_prepare_control_state
  ROOT_LOCK=$(pki_root_operation_lock); INTERMEDIATE_LOCK=$(pki_intermediate_operation_lock); INVENTORY_LOCK=$(pki_inventory_operation_lock); EXPORT_LOCK=$(pki_export_operation_lock)
  finish_recover() { local status=$?; trap - EXIT; [[ ${EXPORT_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$EXPORT_LOCK" || status=1; [[ ${INVENTORY_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$INVENTORY_LOCK" || status=1; [[ ${INTERMEDIATE_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$INTERMEDIATE_LOCK" || status=1; [[ ${ROOT_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$ROOT_LOCK" || status=1; exit "$status"; }
  trap finish_recover EXIT
  pki_acquire_operation_lock "$ROOT_LOCK" 'root CA operation'; ROOT_LOCK_HELD=true
  pki_acquire_operation_lock "$INTERMEDIATE_LOCK" 'intermediate CA operation'; INTERMEDIATE_LOCK_HELD=true
  pki_acquire_operation_lock "$INVENTORY_LOCK" 'inventory operation'; INVENTORY_LOCK_HELD=true
  pki_acquire_operation_lock "$EXPORT_LOCK" 'export operation'; EXPORT_LOCK_HELD=true
  JOURNAL=$(pki_recovery_journal); MARKER=$(pki_recovery_marker)
  pki_read_state_record "$JOURNAL" 'PKI recovery journal'
  [[ ${PKI_RECORD[transaction]:-} == "$TRANSACTION" && ${PKI_RECORD[committed]:-} == false ]] || pki_die 'Recovery journal does not describe the requested uncommitted transaction'
  recover_fault() { [[ ${PLATFORM_PKI_RECOVER_CRASH_AT:-} != "$1" ]] || kill -KILL "$$"; }
  write_loaded_journal() {
    local phase=$1 committed=${2:-false} key value content=''
    PKI_RECORD[phase]=$phase; PKI_RECORD[committed]=$committed
    while IFS= read -r key; do value=${PKI_RECORD[$key]}; content+="$key=$value
  "; done < <(printf '%s\n' "${!PKI_RECORD[@]}" | LC_ALL=C sort)
    pki_write_journal "$JOURNAL" "$content"
  }
  checkpoint_recovery() { PKI_RECORD[recovery_step]=$1; write_loaded_journal recovering; recover_fault "$1"; }
  file_state_allowed() {
    local path=$1 label=$2 current full expected
    shift 2
    current=$(pki_file_identity_or_absent "$path"); full=$current
    [[ $current == absent ]] || full=$(pki_file_identity "$path")
    for expected in "$@"; do [[ $current != "$expected" && $full != "$expected" ]] || return 0; done
    pki_die "$label is not in a journaled identity state"
  }
  if [[ ${PKI_RECORD[operation]:-} == root-bootstrap || ${PKI_RECORD[operation]:-} == intermediate-bootstrap ]]; then
    if [[ ${PKI_RECORD[operation]} == root-bootstrap ]]; then [[ $ACTION == rollback ]] || pki_die 'Root bootstrap recovery supports only rollback'
    elif [[ $ACTION == resume ]]; then [[ ${PKI_RECORD[phase]} == cleanup-* || ${PKI_RECORD[recovery_step]:-} == cleanup-* ]] || pki_die 'Intermediate bootstrap resume is limited to sensitive-stage cleanup'
    else [[ $ACTION == rollback ]] || pki_die 'Intermediate bootstrap recovery action is invalid'; fi
    for field in schema operation transaction phase stage_dir stage_identity transaction_dir transaction_identity reservation reservation_reserved_identity reservation_consumed_identity reservation_abandoned_identity recovery_action recovery_step committed; do [[ -v PKI_RECORD[$field] ]] || pki_die "Bootstrap recovery journal is missing field: $field"; done
    [[ ${PKI_RECORD[schema]} == 3 ]] || pki_die 'Bootstrap recovery journal schema is unsupported'
    TXN_DIR=${PKI_RECORD[transaction_dir]}; [[ $TXN_DIR == "$PKI_DIR/state/rollover/$TRANSACTION" && -d $TXN_DIR && ! -L $TXN_DIR && $(pki_dir_identity "$TXN_DIR") == "${PKI_RECORD[transaction_identity]}" ]] || pki_die 'Bootstrap recovery transaction directory is missing, replaced, or unsafe'
    stage=${PKI_RECORD[stage_dir]}; stage_identity=${PKI_RECORD[stage_identity]}; reservation=${PKI_RECORD[reservation]}; abandoned_stage="$TXN_DIR/reservation-abandoned"
    file_state_allowed "$reservation" 'Bootstrap reservation' absent "${PKI_RECORD[reservation_reserved_identity]}" "${PKI_RECORD[reservation_consumed_identity]}" "${PKI_RECORD[reservation_abandoned_identity]}"
    [[ $(pki_file_identity_or_absent "$reservation") == "${PKI_RECORD[reservation_abandoned_identity]}" ]] || pki_require_file_identity "$abandoned_stage" "${PKI_RECORD[reservation_abandoned_identity]}" 'Abandoned bootstrap reservation stage'
    [[ $stage == none || ! -e $stage && ! -L $stage || -d $stage && ! -L $stage && $(pki_dir_identity "$stage") == "$stage_identity" ]] || pki_die 'Bootstrap staging identity changed'
    PKI_RECORD[recovery_action]=rollback
    if [[ ${PKI_RECORD[operation]} == root-bootstrap ]]; then
      for field in generation authority_dir authority_identity bootstrap_identity; do [[ -v PKI_RECORD[$field] ]] || pki_die "Root bootstrap recovery journal is missing field: $field"; done
      generation=${PKI_RECORD[generation]}; pki_validate_root_generation "$generation"; authority=${PKI_RECORD[authority_dir]}; authority_identity=${PKI_RECORD[authority_identity]}
      [[ $authority == "$(pki_root_authority_dir "$generation")" && $reservation == "$(pki_generation_reservation "$generation")" ]] || pki_die 'Root bootstrap recovery paths are invalid'
      [[ ! -e $authority && ! -L $authority || -d $authority && ! -L $authority && $authority_identity != none && $(pki_dir_identity "$authority") == "$authority_identity" ]] || pki_die 'Root bootstrap authority identity changed'
      bootstrap=$(pki_bootstrap_root_manifest); file_state_allowed "$bootstrap" 'Bootstrap root manifest' absent "${PKI_RECORD[bootstrap_identity]}"
      if [[ $(pki_file_identity_or_absent "$bootstrap") != absent ]]; then checkpoint_recovery rollback-bootstrap-pending; pki_remove_identity_file "$bootstrap" "${PKI_RECORD[bootstrap_identity]}" || pki_die 'Cannot remove bootstrap root manifest'; checkpoint_recovery rollback-bootstrap-done; fi
    else
      for field in root_generation intermediate_generation root_dir intermediate_dir intermediate_identity issued_serial bootstrap_fingerprint active_identity bootstrap_identity bootstrap_rollback_identity root_mutated root_stage root_stage_identity; do [[ -v PKI_RECORD[$field] ]] || pki_die "Intermediate recovery journal is missing field: $field"; done
      root_generation=${PKI_RECORD[root_generation]}; generation=${PKI_RECORD[intermediate_generation]}; pki_validate_root_generation "$root_generation"; pki_validate_intermediate_generation "$generation"; [[ $generation == "$root_generation"-i* ]] || pki_die 'Intermediate bootstrap generations are mismatched'
      root_dir=${PKI_RECORD[root_dir]}; authority=${PKI_RECORD[intermediate_dir]}; authority_identity=${PKI_RECORD[intermediate_identity]}; issued_serial=${PKI_RECORD[issued_serial]}
      [[ $root_dir == "$(pki_root_authority_dir "$root_generation")" && $authority == "$(pki_intermediate_authority_dir "$generation")" && $reservation == "$(pki_generation_reservation "$generation")" ]] || pki_die 'Intermediate bootstrap recovery paths are invalid'
      root_stage=${PKI_RECORD[root_stage]}; root_stage_identity=${PKI_RECORD[root_stage_identity]}
      if [[ $root_stage != none ]]; then [[ $root_stage == "$stage/root" && $root_stage_identity != none ]] || pki_die 'Sensitive root signing stage path is invalid'; [[ ! -e $root_stage && ! -L $root_stage || -d $root_stage && ! -L $root_stage && $(pki_dir_identity "$root_stage") == "$root_stage_identity" ]] || pki_die 'Sensitive root signing stage identity changed'; fi
      [[ ! -e $authority && ! -L $authority || -d $authority && ! -L $authority && $authority_identity != none && $(pki_dir_identity "$authority") == "$authority_identity" ]] || pki_die 'Intermediate bootstrap authority identity changed'
      active=$(pki_active_issuer_manifest); file_state_allowed "$active" 'Active issuer manifest' absent "${PKI_RECORD[active_identity]}"
      bootstrap=$(pki_bootstrap_root_manifest); bootstrap_stage="$TXN_DIR/bootstrap-rollback"; file_state_allowed "$bootstrap" 'Bootstrap root manifest' absent "${PKI_RECORD[bootstrap_identity]}" "${PKI_RECORD[bootstrap_rollback_identity]}"
      [[ $(pki_file_identity_or_absent "$bootstrap") != absent ]] || pki_require_file_identity "$bootstrap_stage" "${PKI_RECORD[bootstrap_rollback_identity]}" 'Bootstrap rollback stage'
      if [[ ${PKI_RECORD[root_mutated]} == true ]]; then
        declare -A db_path=() db_backup=(); db_keys=(index index_attr serial crlnumber index_old index_attr_old serial_old crlnumber_old newcert)
        db_path[index]="$root_dir/index.txt"; db_path[index_attr]="$root_dir/index.txt.attr"; db_path[serial]="$root_dir/serial"; db_path[crlnumber]="$root_dir/crlnumber"; db_path[index_old]="$root_dir/index.txt.old"; db_path[index_attr_old]="$root_dir/index.txt.attr.old"; db_path[serial_old]="$root_dir/serial.old"; db_path[crlnumber_old]="$root_dir/crlnumber.old"; db_path[newcert]="$root_dir/newcerts/$issued_serial.pem"
        backup="$stage/root-backup"; db_backup[index]="$backup/index.txt"; db_backup[index_attr]="$backup/index.txt.attr"; db_backup[serial]="$backup/serial"; db_backup[crlnumber]="$backup/crlnumber"; db_backup[index_old]="$backup/index.txt.old"; db_backup[index_attr_old]="$backup/index.txt.attr.old"; db_backup[serial_old]="$backup/serial.old"; db_backup[crlnumber_old]="$backup/crlnumber.old"; db_backup[newcert]=none
        for key in "${db_keys[@]}"; do for suffix in pre_identity post_identity backup_identity; do field="root_${key}_${suffix}"; [[ -v PKI_RECORD[$field] ]] || pki_die "Intermediate recovery journal is missing field: $field"; done; file_state_allowed "${db_path[$key]}" "Root $key state" "${PKI_RECORD[root_${key}_pre_identity]}" "${PKI_RECORD[root_${key}_post_identity]}" "${PKI_RECORD[root_${key}_backup_identity]}"; current=$(pki_file_identity_or_absent "${db_path[$key]}"); if [[ $current == "${PKI_RECORD[root_${key}_post_identity]}" && ${PKI_RECORD[root_${key}_pre_identity]} != absent ]]; then pki_require_file_identity "${db_backup[$key]}" "${PKI_RECORD[root_${key}_backup_identity]}" "Root $key rollback copy"; fi; done
      fi
      if [[ $ACTION == resume ]]; then
        [[ -d $authority && ! -L $authority && $(pki_dir_identity "$authority") == "$authority_identity" ]] || pki_die 'Published intermediate authority is not complete'
        pki_require_file_identity "$active" "${PKI_RECORD[active_identity]}" 'Active issuer manifest'; pki_require_file_identity "$bootstrap" absent 'Bootstrap root manifest'; pki_require_file_identity "$reservation" "${PKI_RECORD[reservation_consumed_identity]}" 'Consumed intermediate reservation'
        for key in "${db_keys[@]}"; do pki_require_file_identity "${db_path[$key]}" "${PKI_RECORD[root_${key}_post_identity]}" "Published root $key state"; done
        if [[ $root_stage != none && -d $root_stage ]]; then checkpoint_recovery cleanup-pending; pki_remove_journaled_tree "$root_stage" "$root_stage_identity" "$stage" || pki_die 'Cannot remove sensitive root signing stage'; fi
        checkpoint_recovery cleanup-done; write_loaded_journal complete true; rm -f -- "$MARKER"; pki_fsync "$(dirname -- "$MARKER")"
        [[ $stage == none || ! -d $stage ]] || pki_remove_journaled_tree "$stage" "$stage_identity" "$(dirname -- "$stage")" || pki_die 'Cannot remove intermediate bootstrap staging'
        pki_ok "Completed sensitive-stage cleanup for intermediate bootstrap transaction: $TRANSACTION"; exit 0
      fi
      if [[ $(pki_file_identity_or_absent "$active") != absent ]]; then checkpoint_recovery rollback-active-pending; pki_remove_identity_file "$active" "${PKI_RECORD[active_identity]}" || pki_die 'Cannot remove active issuer manifest'; checkpoint_recovery rollback-active-done; fi
      if [[ $(pki_file_identity_or_absent "$bootstrap") == absent ]]; then checkpoint_recovery rollback-bootstrap-pending; pki_publish_staged_file "$bootstrap_stage" "$bootstrap"; checkpoint_recovery rollback-bootstrap-done; fi
      if [[ ${PKI_RECORD[root_mutated]} == true ]]; then for key in "${db_keys[@]}"; do current=$(pki_file_identity_or_absent "${db_path[$key]}"); if [[ $current == "${PKI_RECORD[root_${key}_post_identity]}" && ${PKI_RECORD[root_${key}_pre_identity]} != "${PKI_RECORD[root_${key}_post_identity]}" ]]; then checkpoint_recovery "rollback-root-$key-pending"; pki_restore_journaled_file "${db_path[$key]}" "${PKI_RECORD[root_${key}_pre_identity]}" "${PKI_RECORD[root_${key}_post_identity]}" "${db_backup[$key]}" "${PKI_RECORD[root_${key}_backup_identity]}" "Root $key" || pki_die "Cannot restore root $key state"; checkpoint_recovery "rollback-root-$key-done"; fi; done; fi
    fi
    if [[ -d $authority ]]; then checkpoint_recovery rollback-authority-pending; pki_remove_journaled_tree "$authority" "$authority_identity" "$(dirname -- "$authority")" || pki_die 'Cannot remove journaled bootstrap authority'; checkpoint_recovery rollback-authority-done; fi
    if [[ $stage != none && -d $stage ]]; then checkpoint_recovery rollback-stage-pending; pki_remove_journaled_tree "$stage" "$stage_identity" "$(dirname -- "$stage")" || pki_die 'Cannot remove journaled bootstrap staging'; checkpoint_recovery rollback-stage-done; fi
    if [[ $(pki_file_identity_or_absent "$reservation") != "${PKI_RECORD[reservation_abandoned_identity]}" ]]; then checkpoint_recovery rollback-reservation-pending; pki_publish_staged_file "$abandoned_stage" "$reservation"; checkpoint_recovery rollback-reservation-done; fi
    PKI_RECORD[reservation_identity]=${PKI_RECORD[reservation_abandoned_identity]}; PKI_RECORD[recovery_step]=complete; write_loaded_journal rolled-back true
    rm -f -- "$MARKER"; pki_fsync "$(dirname -- "$MARKER")"; pki_ok "Rolled back bootstrap transaction: $TRANSACTION"; exit 0
  fi
  required_fields=(schema operation transaction phase legacy_root legacy_intermediate new_root new_intermediate root_source_identity intermediate_source_identity root_sha256 intermediate_sha256 transaction_dir transaction_identity provenance_stage provenance_dir provenance_identity provenance_manifest provenance_manifest_identity provenance_manifest_sha256 receipt_identity services_identity services_sha256 backup_receipt private_repo backup_session backup_session_original_identity backup_session_published_identity root_reservation root_reservation_original_identity root_reservation_reserved_identity root_reservation_consumed_identity root_reservation_rollback_identity intermediate_reservation intermediate_reservation_original_identity intermediate_reservation_reserved_identity intermediate_reservation_consumed_identity intermediate_reservation_rollback_identity root_config_original_identity root_config_published_identity root_config_rollback_identity root_config_backup_identity intermediate_config_original_identity intermediate_config_published_identity intermediate_config_rollback_identity intermediate_config_backup_identity issuer_ledger issuer_ledger_identity issuer_ledger_sha256 quarantine_ledger quarantine_ledger_identity quarantine_ledger_sha256 active_manifest active_original_identity active_published_identity committed)
  for field in "${required_fields[@]}"; do [[ -v PKI_RECORD[$field] ]] || pki_die "Recovery journal is missing field: $field"; done
  [[ ${PKI_RECORD[schema]} == 2 && ${PKI_RECORD[operation]} == legacy-migrate && ${PKI_RECORD[transaction]} == "$TRANSACTION" && ${PKI_RECORD[committed]} == false ]] || pki_die 'Recovery journal does not describe the requested uncommitted migration'
  LEGACY_ROOT=${PKI_RECORD[legacy_root]}; LEGACY_INT=${PKI_RECORD[legacy_intermediate]}; NEW_ROOT=${PKI_RECORD[new_root]}; NEW_INT=${PKI_RECORD[new_intermediate]}; TXN_DIR=${PKI_RECORD[transaction_dir]}; ROOT_ID=${PKI_RECORD[root_source_identity]}; INT_ID=${PKI_RECORD[intermediate_source_identity]}
  ROOT_RESERVATION=${PKI_RECORD[root_reservation]}; INT_RESERVATION=${PKI_RECORD[intermediate_reservation]}; BACKUP_SESSION=${PKI_RECORD[backup_session]}; ACTIVE_MANIFEST=${PKI_RECORD[active_manifest]}; ISSUER_LEDGER=${PKI_RECORD[issuer_ledger]}; QUARANTINE_LEDGER=${PKI_RECORD[quarantine_ledger]}
  PROVENANCE_STAGE=${PKI_RECORD[provenance_stage]}; PROVENANCE_DIR=${PKI_RECORD[provenance_dir]}; PROVENANCE_IDENTITY=${PKI_RECORD[provenance_identity]}
  [[ $LEGACY_ROOT == "$PKI_DIR/root-ca" && $LEGACY_INT == "$PKI_DIR/intermediate-ca" && $NEW_ROOT == "$PKI_DIR/authorities/roots/g1" && $NEW_INT == "$PKI_DIR/authorities/intermediates/g1-i1" && $TXN_DIR == "$PKI_DIR/state/rollover/$TRANSACTION" && $PROVENANCE_STAGE == "$PKI_DIR/legacy/.$TRANSACTION.publish" && $PROVENANCE_DIR == "$PKI_DIR/legacy/$TRANSACTION" && ${PKI_RECORD[provenance_manifest]} == "$PROVENANCE_STAGE/provenance-manifest" && $ROOT_RESERVATION == "$(pki_generation_reservation g1)" && $INT_RESERVATION == "$(pki_generation_reservation g1-i1)" && $ACTIVE_MANIFEST == "$(pki_active_issuer_manifest)" && $BACKUP_SESSION == "$PKI_DIR/state/rollover/backup-session-"* && $ISSUER_LEDGER == "$TXN_DIR/issuer-identities" && $QUARANTINE_LEDGER == "$TXN_DIR/quarantine-identities" ]] || pki_die 'Recovery journal paths are outside the exact migration contract'
  [[ -d $TXN_DIR && ! -L $TXN_DIR && $(stat -c '%u:%a' "$TXN_DIR") == "$(id -u):700" && $(pki_dir_identity "$TXN_DIR") == "${PKI_RECORD[transaction_identity]}" ]] || pki_die 'Recovery transaction directory is missing, replaced, or unsafe'
  [[ -d $PROVENANCE_STAGE && ! -L $PROVENANCE_STAGE && $(pki_dir_identity "$PROVENANCE_STAGE") == "$PROVENANCE_IDENTITY" && ! -e $PROVENANCE_DIR && ! -L $PROVENANCE_DIR || -d $PROVENANCE_DIR && ! -L $PROVENANCE_DIR && $(pki_dir_identity "$PROVENANCE_DIR") == "$PROVENANCE_IDENTITY" && ! -e $PROVENANCE_STAGE && ! -L $PROVENANCE_STAGE || ! -e $PROVENANCE_STAGE && ! -L $PROVENANCE_STAGE && ! -e $PROVENANCE_DIR && ! -L $PROVENANCE_DIR && ${PKI_RECORD[recovery_action]:-} == rollback && ${PKI_RECORD[recovery_step]:-} == rollback-provenance-* ]] || pki_die 'Migration provenance is missing, replaced, or ambiguous'
  if [[ -d $PROVENANCE_STAGE ]]; then
    pki_validate_provenance_manifest "$PROVENANCE_STAGE" "${PKI_RECORD[provenance_manifest]}" "${PKI_RECORD[provenance_manifest_identity]}" "${PKI_RECORD[provenance_manifest_sha256]}"
  elif [[ -d $PROVENANCE_DIR ]]; then
    pki_validate_provenance_manifest "$PROVENANCE_DIR" "$PROVENANCE_DIR/provenance-manifest" "${PKI_RECORD[provenance_manifest_identity]}" "${PKI_RECORD[provenance_manifest_sha256]}"
  fi
  pki_require_file_identity "${PKI_RECORD[backup_receipt]}" "${PKI_RECORD[receipt_identity]}" 'Migration backup receipt'
  verify_bound_file() { local path=$1 identity=$2 digest=$3 label=$4 actual; pki_require_file_identity "$path" "$identity" "$label"; actual=$(sha256sum "$path"); [[ ${actual%% *} == "$digest" ]] || pki_die "$label digest changed"; }
  verify_bound_file "$ISSUER_LEDGER" "${PKI_RECORD[issuer_ledger_identity]}" "${PKI_RECORD[issuer_ledger_sha256]}" 'Migration issuer ledger'
  verify_bound_file "$QUARANTINE_LEDGER" "${PKI_RECORD[quarantine_ledger_identity]}" "${PKI_RECORD[quarantine_ledger_sha256]}" 'Migration quarantine ledger'
  services_current=$(pki_file_identity_or_absent "$TXN_DIR/services")
  [[ $services_current == "${PKI_RECORD[services_identity]}" || $services_current != absent && $(pki_file_identity "$TXN_DIR/services") == "${PKI_RECORD[services_identity]}" ]] || pki_die 'Recovery service set changed'
  services_digest=$(sha256sum "$TXN_DIR/services"); [[ ${services_digest%% *} == "${PKI_RECORD[services_sha256]}" ]] || pki_die 'Recovery service set changed'

  write_recovery_journal() {
    local phase=$1 committed=${2:-false} key value content=''
    PKI_RECORD[phase]=$phase; PKI_RECORD[committed]=$committed
    while IFS= read -r key; do value=${PKI_RECORD[$key]}; content+="$key=$value
  "; done < <(printf '%s\n' "${!PKI_RECORD[@]}" | LC_ALL=C sort)
    pki_write_journal "$JOURNAL" "$content"
  }
  migration_checkpoint() { PKI_RECORD[recovery_action]=$ACTION; PKI_RECORD[recovery_step]=$1; write_recovery_journal recovering; recover_fault "$1"; }

  authority_location() {
    local legacy=$1 generation=$2 identity=$3 label=$4 legacy_exists=false generation_exists=false
    [[ ! -e $legacy && ! -L $legacy ]] || legacy_exists=true; [[ ! -e $generation && ! -L $generation ]] || generation_exists=true
    [[ $legacy_exists != "$generation_exists" ]] || pki_die "$label paths are simultaneously present or absent"
    if [[ $legacy_exists == true ]]; then [[ -d $legacy && ! -L $legacy && $(stat -c '%d:%i' "$legacy") == "$identity" ]] || pki_die "$label legacy identity changed"; AUTHORITY_LOCATION=$legacy
    else [[ -d $generation && ! -L $generation && $(stat -c '%d:%i' "$generation") == "$identity" ]] || pki_die "$label generation identity changed"; AUTHORITY_LOCATION=$generation; fi
  }

  allowed_file_state() { local path=$1 label=$2; shift 2; local current expected; current=$(pki_file_identity_or_absent "$path"); for expected in "$@"; do [[ $current != "$expected" ]] || return 0; done; pki_die "$label is not in a journaled identity state"; }

  # Validate every category before the first recovery mutation.
  authority_location "$LEGACY_ROOT" "$NEW_ROOT" "$ROOT_ID" 'Root authority'; ROOT_LOCATION=$AUTHORITY_LOCATION
  authority_location "$LEGACY_INT" "$NEW_INT" "$INT_ID" 'Intermediate authority'; INT_LOCATION=$AUTHORITY_LOCATION
  allowed_file_state "$ROOT_LOCATION/openssl.cnf" 'Root OpenSSL configuration' "${PKI_RECORD[root_config_original_identity]}" "${PKI_RECORD[root_config_published_identity]}" "${PKI_RECORD[root_config_rollback_identity]}"
  allowed_file_state "$INT_LOCATION/openssl.cnf" 'Intermediate OpenSSL configuration' "${PKI_RECORD[intermediate_config_original_identity]}" "${PKI_RECORD[intermediate_config_published_identity]}" "${PKI_RECORD[intermediate_config_rollback_identity]}"
  allowed_file_state "$ROOT_RESERVATION" 'Root reservation' "${PKI_RECORD[root_reservation_original_identity]}" "${PKI_RECORD[root_reservation_reserved_identity]}" "${PKI_RECORD[root_reservation_consumed_identity]}" "${PKI_RECORD[root_reservation_rollback_identity]}"
  allowed_file_state "$INT_RESERVATION" 'Intermediate reservation' "${PKI_RECORD[intermediate_reservation_original_identity]}" "${PKI_RECORD[intermediate_reservation_reserved_identity]}" "${PKI_RECORD[intermediate_reservation_consumed_identity]}" "${PKI_RECORD[intermediate_reservation_rollback_identity]}"
  allowed_file_state "$BACKUP_SESSION" 'Backup session record' "${PKI_RECORD[backup_session_original_identity]}" "${PKI_RECORD[backup_session_published_identity]}"
  allowed_file_state "$ACTIVE_MANIFEST" 'Active issuer manifest' "${PKI_RECORD[active_original_identity]}" "${PKI_RECORD[active_published_identity]}"
  while IFS='|' read -r service original published extra; do [[ -n $service && -z ${extra:-} ]] || pki_die 'Migration issuer ledger has invalid content'; pki_validate_service_name "$service"; allowed_file_state "$(pki_service_issuer "$service")" "Service $service issuer" "$original" "$published"; done <"$ISSUER_LEDGER"
  while IFS='|' read -r basename identity extra; do [[ $basename =~ ^(pki\.env|openssl-root\.cnf\.tpl|openssl-intermediate\.cnf\.tpl|openssl-service\.cnf\.tpl)$ && -z ${extra:-} ]] || pki_die 'Migration quarantine ledger has invalid content'; source="$PKI_DIR/$basename"; destination="$TXN_DIR/quarantine/$basename"; source_state=$(pki_file_identity_or_absent "$source"); destination_state=$(pki_file_identity_or_absent "$destination"); [[ $source_state == "$identity" && $destination_state == absent || $source_state == absent && $destination_state == "$identity" ]] || pki_die "Quarantine entry is ambiguous or replaced: $basename"; done <"$QUARANTINE_LEDGER"
  if [[ $ACTION == rollback ]]; then
    [[ $(pki_file_identity_or_absent "$ROOT_LOCATION/openssl.cnf") != "${PKI_RECORD[root_config_published_identity]}" ]] || pki_require_file_identity "$TXN_DIR/root-openssl.rollback" "${PKI_RECORD[root_config_rollback_identity]}" 'Root OpenSSL rollback stage'
    [[ $(pki_file_identity_or_absent "$INT_LOCATION/openssl.cnf") != "${PKI_RECORD[intermediate_config_published_identity]}" ]] || pki_require_file_identity "$TXN_DIR/intermediate-openssl.rollback" "${PKI_RECORD[intermediate_config_rollback_identity]}" 'Intermediate OpenSSL rollback stage'
    [[ $(pki_file_identity_or_absent "$ROOT_RESERVATION") == "${PKI_RECORD[root_reservation_rollback_identity]}" ]] || pki_require_file_identity "$TXN_DIR/root-abandoned.publish" "${PKI_RECORD[root_reservation_rollback_identity]}" 'Root abandoned reservation stage'
    [[ $(pki_file_identity_or_absent "$INT_RESERVATION") == "${PKI_RECORD[intermediate_reservation_rollback_identity]}" ]] || pki_require_file_identity "$TXN_DIR/intermediate-abandoned.publish" "${PKI_RECORD[intermediate_reservation_rollback_identity]}" 'Intermediate abandoned reservation stage'
  else
    [[ $(pki_file_identity_or_absent "$BACKUP_SESSION") != "${PKI_RECORD[backup_session_original_identity]}" ]] || pki_require_file_identity "$TXN_DIR/backup-session.publish" "${PKI_RECORD[backup_session_published_identity]}" 'Staged backup session'
    for record in "$ROOT_RESERVATION|${PKI_RECORD[root_reservation_original_identity]}|${PKI_RECORD[root_reservation_reserved_identity]}|${PKI_RECORD[root_reservation_consumed_identity]}|$TXN_DIR/root-reserved.publish|$TXN_DIR/root-consumed.publish" "$INT_RESERVATION|${PKI_RECORD[intermediate_reservation_original_identity]}|${PKI_RECORD[intermediate_reservation_reserved_identity]}|${PKI_RECORD[intermediate_reservation_consumed_identity]}|$TXN_DIR/intermediate-reserved.publish|$TXN_DIR/intermediate-consumed.publish"; do path=${record%%|*}; rest=${record#*|}; original=${rest%%|*}; rest=${rest#*|}; reserved=${rest%%|*}; rest=${rest#*|}; consumed=${rest%%|*}; rest=${rest#*|}; reserved_stage=${rest%%|*}; consumed_stage=${rest#*|}; current=$(pki_file_identity_or_absent "$path"); [[ $current != "$original" ]] || pki_require_file_identity "$reserved_stage" "$reserved" 'Staged reserved generation'; [[ $current == "$consumed" ]] || pki_require_file_identity "$consumed_stage" "$consumed" 'Staged consumed generation'; done
    [[ $(pki_file_identity_or_absent "$ROOT_LOCATION/openssl.cnf") != "${PKI_RECORD[root_config_original_identity]}" ]] || pki_require_file_identity "$TXN_DIR/root-openssl.new" "${PKI_RECORD[root_config_published_identity]}" 'Staged root generation configuration'
    [[ $(pki_file_identity_or_absent "$INT_LOCATION/openssl.cnf") != "${PKI_RECORD[intermediate_config_original_identity]}" ]] || pki_require_file_identity "$TXN_DIR/intermediate-openssl.new" "${PKI_RECORD[intermediate_config_published_identity]}" 'Staged intermediate generation configuration'
    while IFS='|' read -r service original published; do [[ $(pki_file_identity_or_absent "$(pki_service_issuer "$service")") != "$original" ]] || pki_require_file_identity "$TXN_DIR/issuer-stage/$service" "$published" "Staged issuer $service"; done <"$ISSUER_LEDGER"
    [[ $(pki_file_identity_or_absent "$ACTIVE_MANIFEST") != "${PKI_RECORD[active_original_identity]}" ]] || pki_require_file_identity "$TXN_DIR/active.publish" "${PKI_RECORD[active_published_identity]}" 'Staged active issuer'
  fi

  if [[ $ACTION == rollback ]]; then
    current=$(pki_file_identity_or_absent "$ACTIVE_MANIFEST"); if [[ $current == "${PKI_RECORD[active_published_identity]}" ]]; then migration_checkpoint rollback-active-pending; pki_remove_identity_file "$ACTIVE_MANIFEST" "$current" || pki_die 'Cannot remove journaled active issuer manifest'; migration_checkpoint rollback-active-done; fi
    while IFS='|' read -r service original published; do issuer=$(pki_service_issuer "$service"); current=$(pki_file_identity_or_absent "$issuer"); if [[ $current == "$published" ]]; then migration_checkpoint "rollback-issuer-$service-pending"; pki_remove_identity_file "$issuer" "$current" || pki_die "Cannot remove journaled issuer: $service"; migration_checkpoint "rollback-issuer-$service-done"; fi; done <"$ISSUER_LEDGER"
    while IFS='|' read -r basename identity; do source="$PKI_DIR/$basename"; destination="$TXN_DIR/quarantine/$basename"; if [[ $(pki_file_identity_or_absent "$destination") == "$identity" ]]; then migration_checkpoint "rollback-quarantine-$basename-pending"; pki_require_file_identity "$source" absent 'Quarantine restore destination'; mv -T -- "$destination" "$source"; pki_fsync_rename_parents "$(dirname -- "$destination")" "$(dirname -- "$source")"; pki_require_file_identity "$source" "$identity" 'Restored quarantine entry'; migration_checkpoint "rollback-quarantine-$basename-done"; fi; done <"$QUARANTINE_LEDGER"
    for record in "$ROOT_LOCATION|root|${PKI_RECORD[root_config_original_identity]}|${PKI_RECORD[root_config_published_identity]}|${PKI_RECORD[root_config_rollback_identity]}|$TXN_DIR/root-openssl.rollback" "$INT_LOCATION|intermediate|${PKI_RECORD[intermediate_config_original_identity]}|${PKI_RECORD[intermediate_config_published_identity]}|${PKI_RECORD[intermediate_config_rollback_identity]}|$TXN_DIR/intermediate-openssl.rollback"; do location=${record%%|*}; rest=${record#*|}; label=${rest%%|*}; rest=${rest#*|}; original=${rest%%|*}; rest=${rest#*|}; published=${rest%%|*}; rest=${rest#*|}; rollback=${rest%%|*}; stage=${rest#*|}; config="$location/openssl.cnf"; current=$(pki_file_identity_or_absent "$config"); if [[ $current == "$published" ]]; then migration_checkpoint "rollback-config-$label-pending"; pki_publish_staged_file "$stage" "$config"; migration_checkpoint "rollback-config-$label-done"; elif [[ $current != "$original" && $current != "$rollback" ]]; then pki_die "$label OpenSSL configuration changed before rollback"; fi; done
    authority_location "$LEGACY_INT" "$NEW_INT" "$INT_ID" 'Intermediate authority'; if [[ $AUTHORITY_LOCATION == "$NEW_INT" ]]; then migration_checkpoint rollback-intermediate-rename-pending; pki_require_file_identity "$LEGACY_INT" absent 'Legacy intermediate destination'; mv -T -- "$NEW_INT" "$LEGACY_INT"; pki_fsync_rename_parents "$(dirname -- "$NEW_INT")" "$(dirname -- "$LEGACY_INT")"; migration_checkpoint rollback-intermediate-rename-done; fi
    authority_location "$LEGACY_ROOT" "$NEW_ROOT" "$ROOT_ID" 'Root authority'; if [[ $AUTHORITY_LOCATION == "$NEW_ROOT" ]]; then migration_checkpoint rollback-root-rename-pending; pki_require_file_identity "$LEGACY_ROOT" absent 'Legacy root destination'; mv -T -- "$NEW_ROOT" "$LEGACY_ROOT"; pki_fsync_rename_parents "$(dirname -- "$NEW_ROOT")" "$(dirname -- "$LEGACY_ROOT")"; migration_checkpoint rollback-root-rename-done; fi
    for record in "$ROOT_RESERVATION|root|${PKI_RECORD[root_reservation_rollback_identity]}|$TXN_DIR/root-abandoned.publish" "$INT_RESERVATION|intermediate|${PKI_RECORD[intermediate_reservation_rollback_identity]}|$TXN_DIR/intermediate-abandoned.publish"; do path=${record%%|*}; rest=${record#*|}; kind=${rest%%|*}; rest=${rest#*|}; rollback=${rest%%|*}; stage=${rest#*|}; current=$(pki_file_identity_or_absent "$path"); if [[ $current != "$rollback" ]]; then migration_checkpoint "rollback-reservation-$kind-pending"; pki_publish_staged_file "$stage" "$path"; migration_checkpoint "rollback-reservation-$kind-done"; fi; done
    current=$(pki_file_identity_or_absent "$BACKUP_SESSION"); if [[ $current == "${PKI_RECORD[backup_session_published_identity]}" ]]; then migration_checkpoint rollback-backup-session-pending; pki_remove_identity_file "$BACKUP_SESSION" "$current" || pki_die 'Cannot remove backup session record'; migration_checkpoint rollback-backup-session-done; fi
    if [[ -d $PROVENANCE_STAGE ]]; then migration_checkpoint rollback-provenance-pending; pki_remove_journaled_tree "$PROVENANCE_STAGE" "$PROVENANCE_IDENTITY" "$(dirname -- "$PROVENANCE_STAGE")" || pki_die 'Cannot remove migration provenance stage'; migration_checkpoint rollback-provenance-done
    elif [[ -d $PROVENANCE_DIR ]]; then migration_checkpoint rollback-provenance-pending; pki_remove_journaled_tree "$PROVENANCE_DIR" "$PROVENANCE_IDENTITY" "$(dirname -- "$PROVENANCE_DIR")" || pki_die 'Cannot remove migration provenance'; migration_checkpoint rollback-provenance-done; fi
    write_recovery_journal rolled-back true; rm -f -- "$MARKER"; pki_fsync "$(dirname -- "$MARKER")"; pki_ok "Rolled back migration transaction: $TRANSACTION"; exit 0
  fi

  # Resume each mutation only from its exact original identity; exact published state is a no-op.
  current=$(pki_file_identity_or_absent "$BACKUP_SESSION"); if [[ $current == "${PKI_RECORD[backup_session_original_identity]}" ]]; then migration_checkpoint resume-backup-session-pending; stage="$TXN_DIR/backup-session.publish"; pki_publish_staged_file "$stage" "$BACKUP_SESSION"; migration_checkpoint resume-backup-session-done; fi
  for record in "$ROOT_RESERVATION|root|${PKI_RECORD[root_reservation_original_identity]}|${PKI_RECORD[root_reservation_reserved_identity]}|$TXN_DIR/root-reserved.publish" "$INT_RESERVATION|intermediate|${PKI_RECORD[intermediate_reservation_original_identity]}|${PKI_RECORD[intermediate_reservation_reserved_identity]}|$TXN_DIR/intermediate-reserved.publish"; do path=${record%%|*}; rest=${record#*|}; kind=${rest%%|*}; rest=${rest#*|}; original=${rest%%|*}; rest=${rest#*|}; published=${rest%%|*}; stage=${rest#*|}; current=$(pki_file_identity_or_absent "$path"); if [[ $current == "$original" ]]; then migration_checkpoint "resume-reservation-$kind-pending"; pki_publish_staged_file "$stage" "$path"; migration_checkpoint "resume-reservation-$kind-done"; elif [[ $current != "$published" && $current != "${PKI_RECORD[root_reservation_consumed_identity]}" && $current != "${PKI_RECORD[intermediate_reservation_consumed_identity]}" ]]; then pki_die 'Reservation cannot be resumed from its current identity'; fi; done
  write_recovery_journal reserved
  authority_location "$LEGACY_ROOT" "$NEW_ROOT" "$ROOT_ID" 'Root authority'; if [[ $AUTHORITY_LOCATION == "$LEGACY_ROOT" ]]; then migration_checkpoint resume-root-rename-pending; pki_require_file_identity "$NEW_ROOT" absent 'Root generation destination'; mv -T -- "$LEGACY_ROOT" "$NEW_ROOT"; pki_fsync_rename_parents "$(dirname -- "$LEGACY_ROOT")" "$(dirname -- "$NEW_ROOT")"; migration_checkpoint resume-root-rename-done; fi; write_recovery_journal root-renamed
  authority_location "$LEGACY_INT" "$NEW_INT" "$INT_ID" 'Intermediate authority'; if [[ $AUTHORITY_LOCATION == "$LEGACY_INT" ]]; then migration_checkpoint resume-intermediate-rename-pending; pki_require_file_identity "$NEW_INT" absent 'Intermediate generation destination'; mv -T -- "$LEGACY_INT" "$NEW_INT"; pki_fsync_rename_parents "$(dirname -- "$LEGACY_INT")" "$(dirname -- "$NEW_INT")"; migration_checkpoint resume-intermediate-rename-done; fi; write_recovery_journal intermediate-renamed
  for record in "$NEW_ROOT/openssl.cnf|root|${PKI_RECORD[root_config_original_identity]}|${PKI_RECORD[root_config_published_identity]}|$TXN_DIR/root-openssl.new" "$NEW_INT/openssl.cnf|intermediate|${PKI_RECORD[intermediate_config_original_identity]}|${PKI_RECORD[intermediate_config_published_identity]}|$TXN_DIR/intermediate-openssl.new"; do path=${record%%|*}; rest=${record#*|}; label=${rest%%|*}; rest=${rest#*|}; original=${rest%%|*}; rest=${rest#*|}; published=${rest%%|*}; stage=${rest#*|}; current=$(pki_file_identity_or_absent "$path"); if [[ $current == "$original" ]]; then migration_checkpoint "resume-config-$label-pending"; pki_publish_staged_file "$stage" "$path"; migration_checkpoint "resume-config-$label-done"; elif [[ $current != "$published" ]]; then pki_die 'Generation configuration cannot be resumed from its current identity'; fi; done
  write_recovery_journal configs-published
  while IFS='|' read -r service original published; do issuer=$(pki_service_issuer "$service"); stage="$TXN_DIR/issuer-stage/$service"; current=$(pki_file_identity_or_absent "$issuer"); if [[ $current == "$original" ]]; then migration_checkpoint "resume-issuer-$service-pending"; pki_publish_staged_file "$stage" "$issuer"; migration_checkpoint "resume-issuer-$service-done"; elif [[ $current != "$published" ]]; then pki_die "Issuer cannot be resumed from its current identity: $service"; fi; done <"$ISSUER_LEDGER"
  write_recovery_journal issuers-published
  while IFS='|' read -r basename identity; do source="$PKI_DIR/$basename"; destination="$TXN_DIR/quarantine/$basename"; if [[ $(pki_file_identity_or_absent "$source") == "$identity" ]]; then migration_checkpoint "resume-quarantine-$basename-pending"; pki_require_file_identity "$destination" absent 'Quarantine publication destination'; mv -T -- "$source" "$destination"; pki_fsync_rename_parents "$(dirname -- "$source")" "$(dirname -- "$destination")"; migration_checkpoint "resume-quarantine-$basename-done"; elif [[ $(pki_file_identity_or_absent "$destination") != "$identity" ]]; then pki_die "Quarantine entry cannot be resumed: $basename"; fi; done <"$QUARANTINE_LEDGER"
  write_recovery_journal quarantined
  for record in "$ROOT_RESERVATION|root|${PKI_RECORD[root_reservation_reserved_identity]}|${PKI_RECORD[root_reservation_consumed_identity]}|$TXN_DIR/root-consumed.publish" "$INT_RESERVATION|intermediate|${PKI_RECORD[intermediate_reservation_reserved_identity]}|${PKI_RECORD[intermediate_reservation_consumed_identity]}|$TXN_DIR/intermediate-consumed.publish"; do path=${record%%|*}; rest=${record#*|}; kind=${rest%%|*}; rest=${rest#*|}; reserved=${rest%%|*}; rest=${rest#*|}; consumed=${rest%%|*}; stage=${rest#*|}; current=$(pki_file_identity_or_absent "$path"); if [[ $current == "$reserved" ]]; then migration_checkpoint "resume-consume-$kind-pending"; pki_publish_staged_file "$stage" "$path"; migration_checkpoint "resume-consume-$kind-done"; elif [[ $current != "$consumed" ]]; then pki_die 'Reservation cannot be consumed from its current identity'; fi; done
  write_recovery_journal active-pending
  current=$(pki_file_identity_or_absent "$ACTIVE_MANIFEST"); if [[ $current == "${PKI_RECORD[active_original_identity]}" ]]; then migration_checkpoint resume-active-pending; stage="$TXN_DIR/active.publish"; pki_publish_staged_file "$stage" "$ACTIVE_MANIFEST"; migration_checkpoint resume-active-done; elif [[ $current != "${PKI_RECORD[active_published_identity]}" ]]; then pki_die 'Active issuer cannot be resumed from its current identity'; fi
  if [[ -d $PROVENANCE_STAGE ]]; then migration_checkpoint resume-provenance-pending; mv -T -- "$PROVENANCE_STAGE" "$PROVENANCE_DIR"; pki_fsync_rename_parents "$(dirname -- "$PROVENANCE_STAGE")" "$(dirname -- "$PROVENANCE_DIR")"; [[ $(pki_dir_identity "$PROVENANCE_DIR") == "$PROVENANCE_IDENTITY" ]] || pki_die 'Migration provenance identity changed during recovery'; migration_checkpoint resume-provenance-done; fi
  write_recovery_journal complete true; rm -f -- "$MARKER"; pki_fsync "$(dirname -- "$MARKER")"; pki_remove_journaled_tree "$TXN_DIR" "${PKI_RECORD[transaction_identity]}" "$(dirname -- "$TXN_DIR")" || pki_die 'Cannot remove committed migration transaction staging'; pki_ok "Resumed migration transaction: $TRANSACTION"

}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        platform_pki_ca_rollover_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in
    -*) ;;

    migrate)
      action="migrate"
      shift
      platform_pki_ca_rollover_migrate_parse_requirements "$@"
      shift $#
      ;;

    status)
      action="status"
      shift
      platform_pki_ca_rollover_status_parse_requirements "$@"
      shift $#
      ;;

    recover)
      action="recover"
      shift
      platform_pki_ca_rollover_recover_parse_requirements "$@"
      shift $#
      ;;

    "")
      platform_pki_ca_rollover_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

platform_pki_ca_rollover_migrate_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        platform_pki_ca_rollover_migrate_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="migrate"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --namespace)

        if [[ -n ${2+x} ]]; then
          args['--namespace']="$2"
          shift
          shift
        else
          printf "%s\n" "--namespace requires an argument: --namespace PATH" >&2
          exit 1
        fi
        ;;

      --pki-dir)

        if [[ -n ${2+x} ]]; then
          args['--pki-dir']="$2"
          shift
          shift
        else
          printf "%s\n" "--pki-dir requires an argument: --pki-dir PATH" >&2
          exit 1
        fi
        ;;

      --backup-receipt)

        if [[ -n ${2+x} ]]; then
          args['--backup-receipt']="$2"
          shift
          shift
        else
          printf "%s\n" "--backup-receipt requires an argument: --backup-receipt PATH" >&2
          exit 1
        fi
        ;;

      --private-repo)

        if [[ -n ${2+x} ]]; then
          args['--private-repo']="$2"
          shift
          shift
        else
          printf "%s\n" "--private-repo requires an argument: --private-repo PATH" >&2
          exit 1
        fi
        ;;

      --yes)

        args['--yes']=1
        shift
        ;;

      --expected-root-sha256)

        if [[ -n ${2+x} ]]; then
          args['--expected-root-sha256']="$2"
          shift
          shift
        else
          printf "%s\n" "--expected-root-sha256 requires an argument: --expected-root-sha256 DIGEST" >&2
          exit 1
        fi
        ;;

      --expected-intermediate-sha256)

        if [[ -n ${2+x} ]]; then
          args['--expected-intermediate-sha256']="$2"
          shift
          shift
        else
          printf "%s\n" "--expected-intermediate-sha256 requires an argument: --expected-intermediate-sha256 DIGEST" >&2
          exit 1
        fi
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  if [[ -z ${args['--backup-receipt']+x} ]]; then
    printf "missing required flag: --backup-receipt PATH\n" >&2
    exit 1
  fi

  [[ -n ${args['--private-repo']:-} ]] || args['--private-repo']="../platform-private"

  if [[ -v args['--namespace'] ]]; then
    validation_output="$(validate_not_empty "${args['--namespace']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--namespace PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--pki-dir'] ]]; then
    validation_output="$(validate_not_empty "${args['--pki-dir']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--pki-dir PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--backup-receipt'] ]]; then
    validation_output="$(validate_not_empty "${args['--backup-receipt']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--backup-receipt PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--private-repo'] ]]; then
    validation_output="$(validate_not_empty "${args['--private-repo']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--private-repo PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--expected-root-sha256'] ]]; then
    validation_output="$(validate_not_empty "${args['--expected-root-sha256']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--expected-root-sha256 DIGEST" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--expected-intermediate-sha256'] ]]; then
    validation_output="$(validate_not_empty "${args['--expected-intermediate-sha256']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--expected-intermediate-sha256 DIGEST" "$validation_output" >&2
      exit 1
    fi
  fi

}

platform_pki_ca_rollover_status_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        platform_pki_ca_rollover_status_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="status"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --namespace)

        if [[ -n ${2+x} ]]; then
          args['--namespace']="$2"
          shift
          shift
        else
          printf "%s\n" "--namespace requires an argument: --namespace PATH" >&2
          exit 1
        fi
        ;;

      --pki-dir)

        if [[ -n ${2+x} ]]; then
          args['--pki-dir']="$2"
          shift
          shift
        else
          printf "%s\n" "--pki-dir requires an argument: --pki-dir PATH" >&2
          exit 1
        fi
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  if [[ -v args['--namespace'] ]]; then
    validation_output="$(validate_not_empty "${args['--namespace']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--namespace PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--pki-dir'] ]]; then
    validation_output="$(validate_not_empty "${args['--pki-dir']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--pki-dir PATH" "$validation_output" >&2
      exit 1
    fi
  fi

}

platform_pki_ca_rollover_recover_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        platform_pki_ca_rollover_recover_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="recover"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --namespace)

        if [[ -n ${2+x} ]]; then
          args['--namespace']="$2"
          shift
          shift
        else
          printf "%s\n" "--namespace requires an argument: --namespace PATH" >&2
          exit 1
        fi
        ;;

      --pki-dir)

        if [[ -n ${2+x} ]]; then
          args['--pki-dir']="$2"
          shift
          shift
        else
          printf "%s\n" "--pki-dir requires an argument: --pki-dir PATH" >&2
          exit 1
        fi
        ;;

      --transaction)

        if [[ -n ${2+x} ]]; then
          args['--transaction']="$2"
          shift
          shift
        else
          printf "%s\n" "--transaction requires an argument: --transaction ID" >&2
          exit 1
        fi
        ;;

      --action)

        if [[ -n ${2+x} ]]; then
          args['--action']="$2"
          shift
          shift
        else
          printf "%s\n" "--action requires an argument: --action ACTION" >&2
          exit 1
        fi
        ;;

      --yes)

        args['--yes']=1
        shift
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  if [[ -z ${args['--transaction']+x} ]]; then
    printf "missing required flag: --transaction ID\n" >&2
    exit 1
  fi
  if [[ -z ${args['--action']+x} ]]; then
    printf "missing required flag: --action ACTION\n" >&2
    exit 1
  fi

  if [[ -v args['--namespace'] ]]; then
    validation_output="$(validate_not_empty "${args['--namespace']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--namespace PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--pki-dir'] ]]; then
    validation_output="$(validate_not_empty "${args['--pki-dir']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--pki-dir PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--transaction'] ]]; then
    validation_output="$(validate_not_empty "${args['--transaction']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--transaction ID" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ ${args['--action']:-} ]] && [[ ! ${args['--action']:-} =~ ^(resume|rollback)$ ]]; then
    printf "%s\n" "--action must be one of: resume, rollback" >&2
    exit 1
  fi

}

initialize() {
  declare -g version="platform-pki-ca-rollover 1.4.0"
  set -euo pipefail

  enable_auto_colors

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "migrate") platform_pki_ca_rollover_migrate_command ;;
    "status") platform_pki_ca_rollover_status_command ;;
    "recover") platform_pki_ca_rollover_recover_command ;;
  esac
}

command_line_args=("$@")
initialize
run "${command_line_args[@]}"
