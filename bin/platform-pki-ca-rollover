  printf "platform-pki-ca-rollover - Inspect generation-aware CA state or migrate the one-time legacy layout\n\n"

  printf "%s\n" "$(bold "Usage:")"
  printf "  platform-pki-ca-rollover COMMAND\n"
  printf "  platform-pki-ca-rollover [COMMAND] --help | -h\n"
  printf "  platform-pki-ca-rollover --version | -v\n"
  echo

  printf "%s\n" "$(bold "Commands:")"
  printf "  %s   Move a verified legacy CA layout into generation g1 and g1-i1\n" "$(green "migrate")"
  printf "  %s   Report legacy, generation-aware, or recovery-required CA state\n" "$(green "status") "
  printf "  %s   Resume migration or terminal cleanup, or roll back the journaled transaction\n" "$(green "recover")"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "$(bold "Options:")"

    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "$(magenta "--version, -v")"
    printf "    Show version number\n"
    echo

    printf "Phase 5 implements legacy migration, migration/bootstrap recovery, and status.\nCandidate preparation, activation, retirement, and rollover completion arrive\nin the next milestone.\n"
    echo

  fi
}

