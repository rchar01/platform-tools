platform_pki_ca_rollover_usage() {
  printf "platform-pki-ca-rollover - Prepare or inspect generation-aware CA rollover state\n\n"

  printf "%s\n" "$(bold "Usage:")"
  printf "  platform-pki-ca-rollover COMMAND\n"
  printf "  platform-pki-ca-rollover [COMMAND] --help | -h\n"
  printf "  platform-pki-ca-rollover --version | -v\n"
  echo

  printf "%s\n" "$(bold "Commands:")"
  printf "  %s   Move a verified legacy CA layout into generation g1 and g1-i1\n" "$(green "migrate")"
  printf "  %s   Report active, candidate, retired, or recovery-required CA state\n" "$(green "status") "
  printf "  %s   Prepare an immutable root or intermediate rollover candidate\n" "$(green "prepare")"
  printf "  %s   Resume migration or terminal cleanup, or roll back the journaled transaction\n" "$(green "recover")"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "$(bold "Options:")"

    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "$(magenta "--version, -v")"
    printf "    Show version number\n"
    echo

    printf "This milestone implements migration, candidate preparation, recovery, and status.\nactivate, acknowledge, rollback, retire, and complete remain unavailable until\nthe immutable export and evidence milestone is implemented.\n"
    echo

  fi
}

