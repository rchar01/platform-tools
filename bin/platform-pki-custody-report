#!/usr/bin/env bash
# This script was generated by bashly 1.4.0 (https://bashly.dev)
# Modifying it manually is not recommended

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2))); then
  printf "bash version 4.2 or higher is required\n" >&2
  exit 1
fi

root_command() {
  SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  COMMON_PATH=${PLATFORM_TOOLS_LIB_DIR:-}
  if [[ -n $COMMON_PATH ]]; then
    COMMON_PATH=${COMMON_PATH}/platform-pki-common.sh
  elif [[ -r ${SCRIPT_DIR}/../lib/platform-pki-common.sh ]]; then
    COMMON_PATH=${SCRIPT_DIR}/../lib/platform-pki-common.sh
  else
    COMMON_PATH=${PLATFORM_TOOLS_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/platform-tools}/lib/platform-pki-common.sh
  fi
  [[ -r $COMMON_PATH ]] || {
    printf '[ERROR] platform-pki-common.sh not found\n' >&2
    exit 1
  }
  # shellcheck source=../../../../lib/platform-pki-common.sh disable=SC1091
  source "$COMMON_PATH"

  pki_reject_repeated_options --namespace --pki-dir --format
  NAMESPACE=${args[--namespace]:-$(pki_default_namespace)}
  PKI_DIR=${args[--pki-dir]:-}
  FORMAT=${args[--format]:-text}
  NAMESPACE=$(pki_expand_path "$NAMESPACE")
  PKI_DIR=${PKI_DIR:-${NAMESPACE}/pki}
  PKI_DIR=$(pki_expand_path "$PKI_DIR")

  export LC_ALL=C
  declare -a MATERIAL_ID=() MATERIAL_ROLE=() MATERIAL_ENCRYPTION=()
  declare -a MATERIAL_CUSTODY=() MATERIAL_BACKUP=() MATERIAL_STATUS=()
  declare -a FINDING_SEVERITY=() FINDING_CODE=() FINDING_MATERIAL=() FINDING_ACTION=()
  declare -A EXPECTED_KEYS=() EXPECTED_RECEIPTS=()
  SCAN_FILE=''

  add_material() {
    MATERIAL_ID+=("$1")
    MATERIAL_ROLE+=("$2")
    MATERIAL_ENCRYPTION+=("$3")
    MATERIAL_CUSTODY+=("$4")
    MATERIAL_BACKUP+=("$5")
    MATERIAL_STATUS+=("$6")
  }

  add_finding() {
    FINDING_SEVERITY+=("$1")
    FINDING_CODE+=("$2")
    FINDING_MATERIAL+=("$3")
    FINDING_ACTION+=("$4")
  }

  header_ancestry_is_safe() {
    local path=$1 current mode owner identity
    HEADER_ANCESTRY_IDENTITY=''
    current=$(dirname -- "$path")
    while :; do
      [[ $current == "$PKI_DIR" || $current == "$PKI_DIR"/* ]] || return 1
      [[ -d $current && ! -L $current ]] || return 1
      mode=$(stat -c '%a' "$current" 2>/dev/null) || return 1
      owner=$(stat -c '%u' "$current" 2>/dev/null) || return 1
      [[ $mode == 700 && $owner == "$(id -u)" ]] || return 1
      identity=$(stat -c '%d:%i:%u:%a:%F' "$current" 2>/dev/null) || return 1
      HEADER_ANCESTRY_IDENTITY+="${current#"$PKI_DIR"}:$identity|"
      [[ $current != "$PKI_DIR" ]] || return 0
      current=$(dirname -- "$current")
    done
  }

  read_first_line_checked() {
    local path=$1 label=$2 kind=$3 before opened after fd ancestry_before evidence
    FIRST_LINE_EVIDENCE=unknown
    READ_FILE_IDENTITY=''
    header_ancestry_is_safe "$path" || pki_die "$label directory ancestry became unsafe"
    ancestry_before=$HEADER_ANCESTRY_IDENTITY
    before=$(pki_file_identity "$path") || pki_die "Cannot inspect $label"
    if ! exec {fd}<"$path"; then
      return 1
    fi
    opened=$(stat -Lc '%d:%i:%u:%a:%h:%s:%y:%z:%F' "/proc/self/fd/$fd") || {
      exec {fd}<&-
      pki_die "Cannot inspect opened $label"
    }
    [[ $opened == "$before" && $(pki_file_identity "$path") == "$before" ]] || {
      exec {fd}<&-
      pki_die "$label identity changed while opening"
    }
    if ! evidence=$(python3 - "$fd" "$kind" <<'PY'
import os
import sys

fd = int(sys.argv[1])
kind = sys.argv[2]
line = bytearray()
while len(line) <= 256:
    byte = os.read(fd, 1)
    if not byte or byte == b"\n":
        break
    if byte == b"\x00":
        print("nul-header")
        raise SystemExit(0)
    line.extend(byte)
if len(line) > 256:
    print("overlong-header")
elif kind == "key" and line == b"-----BEGIN " b"ENCRYPTED PRIVATE KEY-----":
    print("encrypted-pkcs8-header")
elif kind == "key" and line == b"-----BEGIN " b"PRIVATE KEY-----":
    print("plaintext-pkcs8-header")
elif kind == "age" and line == b"age-encryption.org/v1":
    print("age-v1-header")
elif line:
    print("unknown")
else:
    print("unreadable")
PY
    ); then
      exec {fd}<&-
      pki_die "Cannot perform bounded $label header inspection"
    fi
    after=$(stat -Lc '%d:%i:%u:%a:%h:%s:%y:%z:%F' "/proc/self/fd/$fd") || {
      exec {fd}<&-
      pki_die "Cannot reinspect opened $label"
    }
    exec {fd}<&-
    [[ $after == "$before" && $(pki_file_identity "$path") == "$before" ]] || pki_die "$label changed while reading its first line"
    header_ancestry_is_safe "$path" || pki_die "$label directory ancestry became unsafe while reading"
    [[ $HEADER_ANCESTRY_IDENTITY == "$ancestry_before" ]] || pki_die "$label directory ancestry changed while reading"
    FIRST_LINE_EVIDENCE=$evidence
    READ_FILE_IDENTITY=$before
  }

  read_record_checked() {
    local path=$1 label=$2 before opened after fd line key value valid=true ancestry_before record_text
    unset -v CUSTODY_RECORD
    declare -gA CUSTODY_RECORD=()
    header_ancestry_is_safe "$path" || pki_die "$label directory ancestry became unsafe"
    ancestry_before=$HEADER_ANCESTRY_IDENTITY
    before=$(pki_file_identity "$path") || pki_die "Cannot inspect $label"
    exec {fd}<"$path" || return 1
    opened=$(stat -Lc '%d:%i:%u:%a:%h:%s:%y:%z:%F' "/proc/self/fd/$fd") || {
      exec {fd}<&-
      pki_die "Cannot inspect opened $label"
    }
    [[ $opened == "$before" && $(pki_file_identity "$path") == "$before" ]] || {
      exec {fd}<&-
      pki_die "$label identity changed while opening"
    }
    if ! record_text=$(python3 - "$fd" <<'PY'
import os
import sys

fd = int(sys.argv[1])
chunks = []
remaining = 65537
while remaining:
    chunk = os.read(fd, remaining)
    if not chunk:
        break
    chunks.append(chunk)
    remaining -= len(chunk)
data = b"".join(chunks)
if len(data) > 65536 or any(byte < 32 and byte != 10 for byte in data) or b"\x7f" in data:
    raise SystemExit(1)
sys.stdout.buffer.write(data)
PY
    ); then
      valid=false
      record_text=''
    fi
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ ! $line =~ ^([a-z0-9_]+)=([^[:cntrl:]]*)$ ]]; then
        valid=false
        continue
      fi
      key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
      if [[ -v CUSTODY_RECORD[$key] ]]; then
        valid=false
        continue
      fi
      CUSTODY_RECORD[$key]=$value
    done <<<"$record_text"
    after=$(stat -Lc '%d:%i:%u:%a:%h:%s:%y:%z:%F' "/proc/self/fd/$fd") || {
      exec {fd}<&-
      pki_die "Cannot reinspect opened $label"
    }
    exec {fd}<&-
    [[ $after == "$before" && $(pki_file_identity "$path") == "$before" ]] || pki_die "$label changed while reading"
    header_ancestry_is_safe "$path" || pki_die "$label directory ancestry became unsafe while reading"
    [[ $HEADER_ANCESTRY_IDENTITY == "$ancestry_before" ]] || pki_die "$label directory ancestry changed while reading"
    [[ $valid == true ]]
  }

  detect_storage_encryption() {
    local source fstype ancestry saw_ancestry=false
    command -v findmnt >/dev/null 2>&1 || { printf '%s\n' unknown; return; }
    command -v lsblk >/dev/null 2>&1 || { printf '%s\n' unknown; return; }
    source=$(findmnt --noheadings --output SOURCE --target "$PKI_DIR" 2>/dev/null) || {
      printf '%s\n' unknown
      return
    }
    source=${source%%\[*}
    ancestry=$(lsblk --inverse --noheadings --output FSTYPE "$source" 2>/dev/null) || {
      printf '%s\n' unknown
      return
    }
    while IFS= read -r fstype; do
      [[ -n $fstype ]] || continue
      saw_ancestry=true
      [[ $fstype != crypto_LUKS ]] || { printf '%s\n' luks-ancestor; return; }
    done <<<"$ancestry"
    if [[ $saw_ancestry == true ]]; then printf '%s\n' no-luks-ancestor
    else printf '%s\n' unknown; fi
  }

  inspect_key() {
    local id=$1 role=$2 path=$3 custody=$4 backup=$5 presence_severity=$6 presence_code=$7 presence_action=$8
    local type owner mode links encryption=unknown status=review unsafe=false
    EXPECTED_KEYS["$path"]=1

    if [[ ! -e $path && ! -L $path ]]; then
      add_material "$id" "$role" absent "$custody" "$backup" missing
      case $role in
        root-authority|intermediate-authority)
          add_finding high missing-ca-key "$id" restore-or-repair-authority
          ;;
      esac
      return
    fi

    type=$(stat -c '%F' "$path" 2>/dev/null) || type=unknown
    owner=$(stat -c '%u' "$path" 2>/dev/null) || owner=unknown
    mode=$(stat -c '%a' "$path" 2>/dev/null) || mode=unknown
    links=$(stat -c '%h' "$path" 2>/dev/null) || links=unknown
    if ! header_ancestry_is_safe "$path"; then
      unsafe=true
    elif [[ -L $path || $type != 'regular file' || $owner != "$(id -u)" || $links != 1 || ! $mode =~ ^[0-7]+$ ]]; then
      unsafe=true
    elif (( (8#$mode & 077) != 0 )); then
      unsafe=true
    fi

    if [[ $unsafe == true ]]; then
      status=finding
      add_finding high unsafe-private-key "$id" repair-owner-mode-type-and-links
    else
      read_first_line_checked "$path" 'private key' key
      encryption=$FIRST_LINE_EVIDENCE
      if [[ $encryption == overlong-header ]]; then
        status=finding
        add_finding high oversized-private-key-header "$id" quarantine-and-review-key-file
      elif [[ $encryption == nul-header ]]; then
        status=finding
        add_finding high binary-private-key-header "$id" quarantine-and-review-key-file
      fi
    fi

    case $role in
      root-authority|intermediate-authority)
        if [[ $encryption != encrypted-pkcs8-header ]]; then
          status=finding
          add_finding high ca-key-encryption-header-missing "$id" review-key-envelope-and-approved-remediation
        fi
        ;;
      controller-leaf-key|ansible-export-key)
        status=finding
        add_finding "$presence_severity" "$presence_code" "$id" "$presence_action"
        ;;
    esac
    add_material "$id" "$role" "$encryption" "$custody" "$backup" "$status"
  }

  receipt_matches_archive() {
    local receipt=$1 archive=$2 expected_archive_identity=$3 archive_identity key
    local -a required=(schema layout session backup_path backup_device backup_inode backup_size backup_mode backup_owner archive_sha256 created_at created_epoch state_manifest_sha256 private_metadata_sha256)
    [[ -n $expected_archive_identity && $(pki_file_identity "$archive") == "$expected_archive_identity" ]] || return 1
    read_record_checked "$receipt" 'backup receipt' || return 1
    for key in "${required[@]}"; do
      [[ -v CUSTODY_RECORD[$key] && -n ${CUSTODY_RECORD[$key]} ]] || return 1
    done
    [[ ${#CUSTODY_RECORD[@]} -eq 14 && ${CUSTODY_RECORD[schema]} == 2 ]] || return 1
    [[ ${CUSTODY_RECORD[layout]} =~ ^(legacy|generation)$ && ${CUSTODY_RECORD[session]} =~ ^[0-9a-f]{32}$ ]] || return 1
    [[ ${CUSTODY_RECORD[backup_path]} == "$archive" ]] || return 1
    [[ ${CUSTODY_RECORD[backup_device]} =~ ^[0-9]+$ && ${CUSTODY_RECORD[backup_inode]} =~ ^[0-9]+$ ]] || return 1
    [[ ${CUSTODY_RECORD[backup_size]} =~ ^[0-9]+$ && ${CUSTODY_RECORD[backup_mode]} =~ ^[0-7]+$ && ${CUSTODY_RECORD[backup_owner]} =~ ^[0-9]+$ ]] || return 1
    [[ ${CUSTODY_RECORD[archive_sha256]} =~ ^[0-9a-f]{64}$ && ${CUSTODY_RECORD[state_manifest_sha256]} =~ ^[0-9a-f]{64}$ ]] || return 1
    [[ ${CUSTODY_RECORD[private_metadata_sha256]} =~ ^[0-9a-f]{64}$ && ${CUSTODY_RECORD[created_epoch]} =~ ^[0-9]+$ ]] || return 1
    [[ ${CUSTODY_RECORD[created_at]} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || return 1
    archive_identity=$(stat -c '%d:%i:%s:%a:%u' "$archive") || return 1
    [[ $archive_identity == "${CUSTODY_RECORD[backup_device]}:${CUSTODY_RECORD[backup_inode]}:${CUSTODY_RECORD[backup_size]}:${CUSTODY_RECORD[backup_mode]}:${CUSTODY_RECORD[backup_owner]}" ]] || return 1
    [[ $(pki_file_identity "$archive") == "$expected_archive_identity" ]]
  }

  inspect_backups() {
    local path base id type owner mode links encryption status counter=0 receipt orphan_count=0 archive_evidence_identity=''
    local -a entries=()
    local backup_dir=$PKI_DIR/backups
    [[ -e $backup_dir || -L $backup_dir ]] || return 0
    [[ -d $backup_dir && ! -L $backup_dir ]] || pki_die "PKI backup directory must be a non-symlink directory: $backup_dir"
    shopt -s nullglob
    entries=("$backup_dir"/* "$backup_dir"/.[!.]* "$backup_dir"/..?*)
    for path in "${entries[@]}"; do
      [[ $path != *.receipt ]] || continue
      ((counter += 1))
      base=$(basename -- "$path")
      if [[ $base =~ ^platform-pki-([0-9]{8}-[0-9]{6})(-[0-9]+)?\.tar\.gz(\.age)?$ ]]; then
        if [[ -n ${BASH_REMATCH[3]:-} ]]; then
          id=backup:${BASH_REMATCH[1]}${BASH_REMATCH[2]:-}:age
        else
          id=backup:${BASH_REMATCH[1]}${BASH_REMATCH[2]:-}:plain
        fi
      else
        id=backup:unknown-$counter
      fi
      type=$(stat -c '%F' "$path" 2>/dev/null) || type=unknown
      owner=$(stat -c '%u' "$path" 2>/dev/null) || owner=unknown
      mode=$(stat -c '%a' "$path" 2>/dev/null) || mode=unknown
      links=$(stat -c '%h' "$path" 2>/dev/null) || links=unknown
      encryption=unknown
      status=finding
      archive_evidence_identity=''
      if ! header_ancestry_is_safe "$path"; then
        add_finding high unsafe-backup "$id" repair-owner-mode-type-and-links
      elif [[ -L $path || $type != 'regular file' || $owner != "$(id -u)" || $links != 1 || ! $mode =~ ^[0-7]+$ ]] || (( (8#$mode & 077) != 0 )); then
        add_finding high unsafe-backup "$id" repair-owner-mode-type-and-links
      elif [[ $path == *.tar.gz.age ]]; then
        read_first_line_checked "$path" 'age backup' age
        encryption=$FIRST_LINE_EVIDENCE
        archive_evidence_identity=$READ_FILE_IDENTITY
        if [[ $encryption == age-v1-header ]]; then
          status=review
        elif [[ $encryption == overlong-header ]]; then
          add_finding high oversized-backup-header "$id" quarantine-and-review-backup
        elif [[ $encryption == nul-header ]]; then
          add_finding high binary-backup-header "$id" quarantine-and-review-backup
        else
          add_finding high invalid-age-backup "$id" replace-with-verified-age-backup
        fi
      elif [[ $path == *.tar.gz ]]; then
        encryption=plaintext-archive-name
        archive_evidence_identity=$(pki_file_identity "$path")
        add_finding high plaintext-backup "$id" replace-with-age-encrypted-backup
      else
        archive_evidence_identity=$(pki_file_identity "$path")
        add_finding high unknown-backup-format "$id" review-and-quarantine-unknown-backup
      fi
      add_material "$id" pki-backup "$encryption" offline-offsite encrypted-and-restore-tested "$status"
      receipt=$path.receipt
      EXPECTED_RECEIPTS["$receipt"]=1
      if [[ ! -e $receipt && ! -L $receipt ]]; then
        add_finding medium missing-backup-receipt "$id" create-a-fresh-receipt-bound-backup
      else
        type=$(stat -c '%F' "$receipt" 2>/dev/null) || type=unknown
        owner=$(stat -c '%u' "$receipt" 2>/dev/null) || owner=unknown
        mode=$(stat -c '%a' "$receipt" 2>/dev/null) || mode=unknown
        links=$(stat -c '%h' "$receipt" 2>/dev/null) || links=unknown
        if ! header_ancestry_is_safe "$receipt" || [[ -L $receipt || $type != 'regular file' || $owner != "$(id -u)" || $links != 1 || $mode != 600 ]]; then
          add_finding high unsafe-backup-receipt "$id" repair-or-replace-receipt-bound-backup
        elif ! receipt_matches_archive "$receipt" "$path" "$archive_evidence_identity"; then
          add_finding high invalid-backup-receipt "$id" create-a-fresh-receipt-bound-backup
        fi
      fi
    done
    for receipt in "${entries[@]}"; do
      [[ $receipt == *.receipt ]] || continue
      [[ -v EXPECTED_RECEIPTS[$receipt] ]] || ((orphan_count += 1))
    done
    if (( orphan_count > 0 )); then
      add_finding medium "orphan-backup-receipt-count:$orphan_count" backups review-or-remove-orphan-receipts
    fi
    shopt -u nullglob
  }

  scan_managed_metadata() {
    local path type owner mode links unsafe count=0
    SCAN_FILE=$(mktemp "${TMPDIR:-/tmp}/platform-pki-custody-metadata.XXXXXX") || pki_die 'Cannot stage managed-metadata scan'
    find "$PKI_DIR" -xdev -print0 >"$SCAN_FILE" 2>/dev/null || pki_die 'Cannot enumerate complete managed PKI metadata'
    while IFS= read -r -d '' path; do
      type=$(stat -c '%F' "$path" 2>/dev/null) || type=unknown
      owner=$(stat -c '%u' "$path" 2>/dev/null) || owner=unknown
      mode=$(stat -c '%a' "$path" 2>/dev/null) || mode=unknown
      links=$(stat -c '%h' "$path" 2>/dev/null) || links=unknown
      unsafe=false
      if [[ $owner != "$(id -u)" || ! $mode =~ ^[0-7]+$ ]]; then
        unsafe=true
      else
        case $type in
          directory) [[ $mode == 700 ]] || unsafe=true ;;
          'regular file'|'regular empty file')
            [[ $links == 1 ]] || unsafe=true
            (( (8#$mode & 022) == 0 )) || unsafe=true
            ;;
          *) unsafe=true ;;
        esac
      fi
      [[ $unsafe == false ]] || ((count += 1))
    done <"$SCAN_FILE"
    rm -f -- "$SCAN_FILE"
    SCAN_FILE=''
    if (( count > 0 )); then
      add_material unsafe-managed-paths filesystem-metadata unknown repair-in-place no-independent-backup finding
      add_finding high "unsafe-managed-path-count:$count" unsafe-managed-paths inspect-owner-mode-type-and-links
    fi
  }

  scan_unexpected_keys() {
    local path count=0
    SCAN_FILE=$(mktemp "${TMPDIR:-/tmp}/platform-pki-custody-keys.XXXXXX") || pki_die 'Cannot stage private-key scan'
    find "$PKI_DIR" -xdev \( -type f -o -type l \) -name '*.key' -print0 >"$SCAN_FILE" 2>/dev/null || pki_die 'Cannot enumerate complete managed private-key paths'
    while IFS= read -r -d '' path; do
      [[ -v EXPECTED_KEYS[$path] ]] || ((count += 1))
    done <"$SCAN_FILE"
    rm -f -- "$SCAN_FILE"
    SCAN_FILE=''
    if (( count > 0 )); then
      add_material unexpected-keys unclassified-private-key unknown restricted-quarantine review-before-retention finding
      add_finding high "unexpected-private-key-count:$count" unexpected-keys inspect-without-copying-or-printing-content
    fi
  }

  json_string() {
    local value=$1
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/\\n}
    value=${value//$'\r'/\\r}
    value=${value//$'\t'/\\t}
    printf '"%s"' "$value"
  }

  print_text_report() {
    local i material_width=8 role_width=4 evidence_width=19 custody_width=19 backup_width=13
    local severity_width=8 code_width=4 finding_material_width=8
    for i in "${!MATERIAL_ID[@]}"; do
      (( ${#MATERIAL_ID[$i]} <= material_width )) || material_width=${#MATERIAL_ID[$i]}
      (( ${#MATERIAL_ROLE[$i]} <= role_width )) || role_width=${#MATERIAL_ROLE[$i]}
      (( ${#MATERIAL_ENCRYPTION[$i]} <= evidence_width )) || evidence_width=${#MATERIAL_ENCRYPTION[$i]}
      (( ${#MATERIAL_CUSTODY[$i]} <= custody_width )) || custody_width=${#MATERIAL_CUSTODY[$i]}
      (( ${#MATERIAL_BACKUP[$i]} <= backup_width )) || backup_width=${#MATERIAL_BACKUP[$i]}
    done
    for i in "${!FINDING_CODE[@]}"; do
      (( ${#FINDING_SEVERITY[$i]} <= severity_width )) || severity_width=${#FINDING_SEVERITY[$i]}
      (( ${#FINDING_CODE[$i]} <= code_width )) || code_width=${#FINDING_CODE[$i]}
      (( ${#FINDING_MATERIAL[$i]} <= finding_material_width )) || finding_material_width=${#FINDING_MATERIAL[$i]}
    done
    printf 'status=%s\nlayout=%s\nstorage_encryption_evidence=%s\n' "$REPORT_STATUS" "$LAYOUT" "$STORAGE_ENCRYPTION"
    printf 'materials=%s\nfindings=%s\n\n' "${#MATERIAL_ID[@]}" "${#FINDING_CODE[@]}"
    printf '%-*s  %-*s  %-*s  %-*s  %-*s  %s\n' \
      "$material_width" MATERIAL "$role_width" ROLE "$evidence_width" ENCRYPTION_EVIDENCE \
      "$custody_width" RECOMMENDED_CUSTODY "$backup_width" BACKUP_POLICY STATUS
    for i in "${!MATERIAL_ID[@]}"; do
      printf '%-*s  %-*s  %-*s  %-*s  %-*s  %s\n' \
        "$material_width" "${MATERIAL_ID[$i]}" "$role_width" "${MATERIAL_ROLE[$i]}" \
        "$evidence_width" "${MATERIAL_ENCRYPTION[$i]}" "$custody_width" "${MATERIAL_CUSTODY[$i]}" \
        "$backup_width" "${MATERIAL_BACKUP[$i]}" "${MATERIAL_STATUS[$i]}"
    done
    printf '\nFINDINGS\n'
    if (( ${#FINDING_CODE[@]} == 0 )); then
      printf 'none\n'
    else
      printf '%-*s  %-*s  %-*s  %s\n' \
        "$severity_width" SEVERITY "$code_width" CODE "$finding_material_width" MATERIAL ACTION
      for i in "${!FINDING_CODE[@]}"; do
        printf '%-*s  %-*s  %-*s  %s\n' \
          "$severity_width" "${FINDING_SEVERITY[$i]}" "$code_width" "${FINDING_CODE[$i]}" \
          "$finding_material_width" "${FINDING_MATERIAL[$i]}" "${FINDING_ACTION[$i]}"
      done
    fi
    printf '\nOPERATIONAL_CHECKS\n'
    printf 'ca_key_cryptographic_validation=unknown\nbackup_decryption_validation=unknown\nbackup_archive_digest_validation=unknown\n'
    printf 'offline_ca_custody=unknown\nbackup_recipient_separation=unknown\noffsite_backup_copy=unknown\n'
    printf 'isolated_restore_rehearsal=unknown\ntarget_host_leaf_custody=unknown\n'
  }

  print_json_report() {
    local i first=true
    printf '{"schema":1,"status":'; json_string "$REPORT_STATUS"
    printf ',"layout":'; json_string "$LAYOUT"
    printf ',"storage_encryption_evidence":'; json_string "$STORAGE_ENCRYPTION"
    printf ',"materials":['
    for i in "${!MATERIAL_ID[@]}"; do
      [[ $first == true ]] || printf ','; first=false
      printf '{"id":'; json_string "${MATERIAL_ID[$i]}"
      printf ',"role":'; json_string "${MATERIAL_ROLE[$i]}"
      printf ',"encryption_evidence":'; json_string "${MATERIAL_ENCRYPTION[$i]}"
      printf ',"recommended_custody":'; json_string "${MATERIAL_CUSTODY[$i]}"
      printf ',"backup_policy":'; json_string "${MATERIAL_BACKUP[$i]}"
      printf ',"status":'; json_string "${MATERIAL_STATUS[$i]}"; printf '}'
    done
    printf '],"findings":['; first=true
    for i in "${!FINDING_CODE[@]}"; do
      [[ $first == true ]] || printf ','; first=false
      printf '{"severity":'; json_string "${FINDING_SEVERITY[$i]}"
      printf ',"code":'; json_string "${FINDING_CODE[$i]}"
      printf ',"material":'; json_string "${FINDING_MATERIAL[$i]}"
      printf ',"action":'; json_string "${FINDING_ACTION[$i]}"; printf '}'
    done
    printf '],"operational_checks":{"ca_key_cryptographic_validation":"unknown","backup_decryption_validation":"unknown",'
    printf '"backup_archive_digest_validation":"unknown","offline_ca_custody":"unknown","backup_recipient_separation":"unknown",'
    printf '"offsite_backup_copy":"unknown","isolated_restore_rehearsal":"unknown","target_host_leaf_custody":"unknown"}}\n'
  }

  pki_require_pki_dir
  pki_require_cmd python3
  pki_prepare_control_state
  ROOT_LOCK=$(pki_root_operation_lock)
  INTERMEDIATE_LOCK=$(pki_intermediate_operation_lock)
  INVENTORY_LOCK=$(pki_inventory_operation_lock)
  EXPORT_LOCK=$(pki_export_operation_lock)
  # shellcheck disable=SC2329 # Invoked by the EXIT trap.
  finish_custody_report() {
    local status=$?
    trap - EXIT
    [[ -z $SCAN_FILE ]] || rm -f -- "$SCAN_FILE" 2>/dev/null || status=1
    [[ ${EXPORT_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$EXPORT_LOCK" 2>/dev/null || status=1
    [[ ${INVENTORY_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$INVENTORY_LOCK" 2>/dev/null || status=1
    [[ ${INTERMEDIATE_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$INTERMEDIATE_LOCK" 2>/dev/null || status=1
    [[ ${ROOT_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$ROOT_LOCK" 2>/dev/null || status=1
    exit "$status"
  }
  trap finish_custody_report EXIT
  umask 077
  pki_acquire_operation_lock "$ROOT_LOCK" 'root CA operation'; ROOT_LOCK_HELD=true
  pki_acquire_operation_lock "$INTERMEDIATE_LOCK" 'intermediate CA operation'; INTERMEDIATE_LOCK_HELD=true
  pki_acquire_operation_lock "$INVENTORY_LOCK" 'inventory operation'; INVENTORY_LOCK_HELD=true
  pki_acquire_operation_lock "$EXPORT_LOCK" 'export operation'; EXPORT_LOCK_HELD=true
  pki_require_no_unresolved_journal

  LAYOUT=$(pki_detect_layout)
  scan_managed_metadata
  case $LAYOUT in
    generation)
      shopt -s nullglob
      for authority in "$PKI_DIR/authorities/roots"/*; do
        [[ -d $authority && ! -L $authority ]] || pki_die "Root authority path is unsafe: $authority"
        generation=$(basename -- "$authority"); pki_validate_root_generation "$generation"
        inspect_key "root:$generation" root-authority "$authority/private/root-ca.key" offline-detached \
          two-encrypted-separated '' '' ''
      done
      for authority in "$PKI_DIR/authorities/intermediates"/*; do
        [[ -d $authority && ! -L $authority ]] || pki_die "Intermediate authority path is unsafe: $authority"
        generation=$(basename -- "$authority"); pki_validate_intermediate_generation "$generation"
        inspect_key "intermediate:$generation" intermediate-authority "$authority/private/intermediate-ca.key" offline-signer \
          encrypted-after-each-ca-mutation '' '' ''
      done
      shopt -u nullglob
      ;;
    legacy)
      inspect_key legacy-root root-authority "$PKI_DIR/root-ca/private/root-ca.key" offline-detached \
        two-encrypted-separated '' '' ''
      inspect_key legacy-intermediate intermediate-authority "$PKI_DIR/intermediate-ca/private/intermediate-ca.key" offline-signer \
        encrypted-after-each-ca-mutation '' '' ''
      ;;
    *) pki_die "PKI custody report requires a complete legacy or generation layout; detected: $LAYOUT" ;;
  esac

  if [[ -e $PKI_DIR/services || -L $PKI_DIR/services ]]; then
    [[ -d $PKI_DIR/services && ! -L $PKI_DIR/services ]] || pki_die "Service state must be a non-symlink directory: $PKI_DIR/services"
    shopt -s nullglob
    for service_dir in "$PKI_DIR/services"/*; do
      [[ -d $service_dir && ! -L $service_dir ]] || pki_die "Service state path is unsafe: $service_dir"
      service=$(basename -- "$service_dir"); pki_validate_service_name "$service"
      inspect_key "service:$service" controller-leaf-key "$service_dir/private/tls.key" target-host-only \
        reissue-with-fresh-key medium controller-leaf-key migrate-to-host-local-key
    done
    shopt -u nullglob
  fi

  if [[ -e $PKI_DIR/state/csr || -L $PKI_DIR/state/csr ]]; then
    pki_require_private_dir "$PKI_DIR/state/csr" 'Host-local CSR protocol state'
    add_material host-local-csr-state certificate-only-candidates-and-protocol-evidence not-required \
      controlled-protocol-state encrypted-state-backup review
  fi

  if [[ -e $PKI_DIR/export/ansible/services || -L $PKI_DIR/export/ansible/services ]]; then
    export_services=$PKI_DIR/export/ansible/services
    [[ -d $export_services && ! -L $export_services ]] || pki_die "Ansible service export must be a non-symlink directory: $export_services"
    shopt -s nullglob
    for service_dir in "$export_services"/*; do
      [[ -d $service_dir && ! -L $service_dir ]] || pki_die "Ansible service export path is unsafe: $service_dir"
      service=$(basename -- "$service_dir"); pki_validate_service_name "$service"
      if [[ -e $service_dir/tls.key || -L $service_dir/tls.key ]]; then
        inspect_key "export:$service" ansible-export-key "$service_dir/tls.key" migration-only \
          do-not-retain high duplicate-export-key remove-after-validated-host-local-migration
      fi
    done
    shopt -u nullglob
  fi

  inspect_backups
  add_material inventory private-infrastructure-metadata storage-volume local-private encrypted-state-backup review
  add_material ca-databases integrity-critical-ca-state storage-volume offline-signer encrypted-after-each-ca-mutation review
  if [[ -e $PKI_DIR/legacy || -L $PKI_DIR/legacy ]]; then
    add_material legacy migration-quarantine storage-volume restricted-quarantine encrypted-until-reviewed-retention review
  fi
  add_material public-artifacts certificates-chains-and-csrs not-required controlled-public-artifact reconstructable ok
  scan_unexpected_keys

  STORAGE_ENCRYPTION=$(detect_storage_encryption)
  REPORT_STATUS=ok
  (( ${#FINDING_CODE[@]} == 0 )) || REPORT_STATUS=findings

  if [[ $FORMAT == json ]]; then
    print_json_report
  else
    print_text_report
  fi
  [[ $REPORT_STATUS == ok ]] || exit 2

}

version_command() {
  echo "$version"
}

platform_pki_custody_report_usage() {
  printf "platform-pki-custody-report - Report PKI encryption, custody, and backup-policy findings\n\n"

  printf "%s\n" "$(bold "Usage:")"
  printf "  platform-pki-custody-report [OPTIONS]\n"
  printf "  platform-pki-custody-report --help | -h\n"
  printf "  platform-pki-custody-report --version | -v\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "$(bold "Options:")"

    printf "  %s\n" "$(magenta "--namespace PATH")"
    printf "    Platform namespace root\n"
    echo

    printf "  %s\n" "$(magenta "--pki-dir PATH")"
    printf "    PKI directory\n"
    echo

    printf "  %s\n" "$(magenta "--format VALUE")"
    printf "    Report format\n"
    printf "    %s\n" "Default: text"
    echo

    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "$(magenta "--version, -v")"
    printf "    Show version number\n"
    echo

    printf "%s\n" "$(bold "Examples:")"
    printf "  platform-pki-custody-report\n"
    printf "  platform-pki-custody-report --format json\n"
    echo

    printf "The report inspects managed PKI paths, file metadata, storage ancestry, age\nheaders, and only the first PEM header line of validated private-key files.\nIt never decrypts, parses, hashes, copies, or prints private-key content.\n\nReport exit codes:\n  0 no structural custody findings\n  1 parser, configuration, or unsafe-layout error\n  2 one or more custody or encryption findings\n"
    echo

  fi
}

normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

enable_auto_colors() {
  if [[ -z ${NO_COLOR+x} && ! -t 1 ]]; then
    NO_COLOR=1
  fi
}

print_in_color() {
  local color="$1"
  shift
  if [[ "${NO_COLOR:-}" == "" ]]; then
    printf "$color%b\e[0m\n" "$*"
  else
    printf "%b\n" "$*"
  fi
}

red() { print_in_color "\e[31m" "$*"; }
green() { print_in_color "\e[32m" "$*"; }
yellow() { print_in_color "\e[33m" "$*"; }
blue() { print_in_color "\e[34m" "$*"; }
magenta() { print_in_color "\e[35m" "$*"; }
cyan() { print_in_color "\e[36m" "$*"; }
black() { print_in_color "\e[30m" "$*"; }
white() { print_in_color "\e[37m" "$*"; }

bold() { print_in_color "\e[1m" "$*"; }
underlined() { print_in_color "\e[4m" "$*"; }
bold_underlined() { print_in_color "\e[1;4m" "$*"; }

red_bold() { print_in_color "\e[1;31m" "$*"; }
green_bold() { print_in_color "\e[1;32m" "$*"; }
yellow_bold() { print_in_color "\e[1;33m" "$*"; }
blue_bold() { print_in_color "\e[1;34m" "$*"; }
magenta_bold() { print_in_color "\e[1;35m" "$*"; }
cyan_bold() { print_in_color "\e[1;36m" "$*"; }
black_bold() { print_in_color "\e[1;30m" "$*"; }
white_bold() { print_in_color "\e[1;37m" "$*"; }

red_underlined() { print_in_color "\e[4;31m" "$*"; }
green_underlined() { print_in_color "\e[4;32m" "$*"; }
yellow_underlined() { print_in_color "\e[4;33m" "$*"; }
blue_underlined() { print_in_color "\e[4;34m" "$*"; }
magenta_underlined() { print_in_color "\e[4;35m" "$*"; }
cyan_underlined() { print_in_color "\e[4;36m" "$*"; }
black_underlined() { print_in_color "\e[4;30m" "$*"; }
white_underlined() { print_in_color "\e[4;37m" "$*"; }

validate_not_empty() {
  [[ -n $1 ]] || printf '%s\n' 'must not be empty'
}

validate_format() {
  case $1 in
    text|json) ;;
    *) printf 'Format must be text or json: %s\n' "$1" ;;
  esac
}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        platform_pki_custody_report_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="root"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --namespace)

        if [[ -n ${2+x} ]]; then
          args['--namespace']="$2"
          shift
          shift
        else
          printf "%s\n" "--namespace requires an argument: --namespace PATH" >&2
          exit 1
        fi
        ;;

      --pki-dir)

        if [[ -n ${2+x} ]]; then
          args['--pki-dir']="$2"
          shift
          shift
        else
          printf "%s\n" "--pki-dir requires an argument: --pki-dir PATH" >&2
          exit 1
        fi
        ;;

      --format)

        if [[ -n ${2+x} ]]; then
          args['--format']="$2"
          shift
          shift
        else
          printf "%s\n" "--format requires an argument: --format VALUE" >&2
          exit 1
        fi
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  [[ -n ${args['--format']:-} ]] || args['--format']="text"

  if [[ -v args['--namespace'] ]]; then
    validation_output="$(validate_not_empty "${args['--namespace']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--namespace PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--pki-dir'] ]]; then
    validation_output="$(validate_not_empty "${args['--pki-dir']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--pki-dir PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--format'] ]]; then
    validation_output="$(validate_format "${args['--format']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--format VALUE" "$validation_output" >&2
      exit 1
    fi
  fi

}

initialize() {
  declare -g version="platform-pki-custody-report 2.0.0"
  set -euo pipefail

  enable_auto_colors

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "root") root_command ;;
  esac
}

command_line_args=("$@")
initialize
run "${command_line_args[@]}"
