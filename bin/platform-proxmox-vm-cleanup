validate_numeric_vmid() { [[ $1 =~ ^[0-9]+$ ]] || printf '%s\n' 'must be numeric'; }
validate_not_empty() { [[ -n $1 ]] || printf '%s\n' 'must not be empty'; }
command_exists() { command -v "$1" >/dev/null 2>&1; }
has_control_characters() { [[ $1 =~ [[:cntrl:]] ]]; }

validate_inputs() {
  local host_label='[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?'
  local host_re="${host_label}(\\.${host_label})*" internal_count=0

  if [[ -n $SSH_TARGET ]]; then
    [[ $SSH_TARGET =~ ^([A-Za-z_][A-Za-z0-9_.-]*@)?${host_re}$ ]] ||
      die '--ssh must use host or user@host syntax with DNS-name or IPv4 characters only'
  fi
  [[ -z $EXPECTED_NAME ]] || ! has_control_characters "$EXPECTED_NAME" ||
    die '--name must not contain control characters'
  [[ $REMOTE_INSPECT != true ]] || ((internal_count += 1))
  [[ $REMOTE_DESTROY != true ]] || ((internal_count += 1))
  [[ $REMOTE_CANCEL != true ]] || ((internal_count += 1))
  ((internal_count <= 1)) || die 'Internal inspection, destruction, and cancellation modes cannot be combined'
}

read_authorization_token() {
  local token extra
  if ! IFS= read -r token <&3; then
    token=''
    exec 3<&-
    die 'Internal authorization input is unavailable or not newline-terminated'
  fi
  if IFS= read -r extra <&3; then
    token=''
    extra=''
    exec 3<&-
    die 'Internal authorization input must contain exactly one line'
  fi
  if [[ -n $extra ]]; then
    token=''
    extra=''
    exec 3<&-
    die 'Internal authorization input has trailing unterminated data'
  fi
  if [[ ! $token =~ ^[A-Fa-f0-9]{64}$ ]]; then
    token=''
    exec 3<&-
    die 'Internal authorization input has an invalid shape'
  fi
  AUTHORIZATION_TOKEN=${token,,}
  token=''
  exec 3<&-
}

expand_path() {
  case $1 in
    \~) printf '%s\n' "$HOME" ;;
    \~/*) printf '%s/%s\n' "$HOME" "${1:2}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

resolve_self_path() {
  case ${BASH_SOURCE[0]} in
    */*) [[ -r ${BASH_SOURCE[0]} ]] || return 1; printf '%s\n' "${BASH_SOURCE[0]}" ;;
    *) command -v -- "${BASH_SOURCE[0]}" 2>/dev/null || return 1 ;;
  esac
}

confirm_cleanup() {
  local confirmation
  [[ $ASSUME_YES != true ]] || return 0
  [[ -t 0 ]] || die 'Interactive confirmation requires a TTY; use --yes to bypass it'
  printf 'Type VMID %s to destroy: ' "$VMID"
  read -r confirmation || die 'Confirmation input unavailable; cleanup aborted'
  [[ $confirmation == "$VMID" ]] || die 'Confirmation did not match; cleanup aborted'
}

require_proxmox_host() {
  command_exists qm || die 'qm is required; run on a Proxmox host, or use --ssh from an operator workstation'
  command_exists sha256sum || die 'sha256sum is required to bind cleanup authorization to the inspected qm config'
}

qm_status_missing_evidence() {
  [[ $1 =~ ^Configuration\ file\ \'nodes/[A-Za-z0-9.-]+/qemu-server/${VMID}\.conf\'\ does\ not\ exist$ ]]
}

query_vm_status() {
  local output status
  if output=$(qm status "$VMID" 2>&1); then
    case $output in
      'status: running') printf '%s\n' running ;;
      'status: stopped') printf '%s\n' stopped ;;
      *) die "VMID ${VMID} returned malformed or unsupported qm status: ${output}" ;;
    esac
    return 0
  else
    status=$?
  fi
  qm_status_missing_evidence "$output" && die "VMID ${VMID} does not exist"
  [[ -z $output ]] || printf '%s\n' "$output" >&2
  return "$status"
}

query_vm_config() {
  local output status
  if output=$(qm config "$VMID" 2>&1); then
    printf '%s\n' "$output"
    return 0
  else
    status=$?
  fi
  [[ -z $output ]] || printf '%s\n' "$output" >&2
  return "$status"
}

config_name() {
  local config=$1 line name='' count=0
  while IFS= read -r line || [[ -n $line ]]; do
    case $line in 'name: '*) name=${line#name: }; ((count += 1)) ;; esac
  done <<<"$config"
  [[ $count -eq 1 && -n $name ]] || die "VMID ${VMID} has no unique non-empty name in qm config"
  ! has_control_characters "$name" || die "VMID ${VMID} has an invalid name in qm config"
  printf '%s\n' "$name"
}

capture_target_state() {
  local print_config=$1 status config name digest
  status=$(query_vm_status) || return $?
  config=$(query_vm_config) || return $?
  name=$(config_name "$config") || return $?
  [[ -z $EXPECTED_NAME || $name == "$EXPECTED_NAME" ]] ||
    die "VMID ${VMID} name mismatch: expected '${EXPECTED_NAME}', got '${name}'"
  digest=$(printf '%s' "$config" | sha256sum)
  digest=${digest%% *}
  [[ $digest =~ ^[A-Fa-f0-9]{64}$ ]] || die 'Could not hash the inspected qm config'
  CAPTURED_VMID=$VMID
  CAPTURED_NAME=$name
  CAPTURED_STATUS=$status
  CAPTURED_CONFIG_DIGEST=${digest,,}
  if [[ $print_config == true ]]; then
    warn "Target for cleanup: VMID ${VMID}"
    printf '%s\n' "$config"
  fi
}

compare_authorized_state() {
  local required_status=$1
  [[ $CAPTURED_VMID == "$AUTH_VMID" ]] || die 'VMID identity changed after inspection; cleanup aborted'
  [[ $CAPTURED_NAME == "$AUTH_NAME" ]] ||
    die "VMID ${VMID} name changed after inspection: expected '${AUTH_NAME}', got '${CAPTURED_NAME}'"
  [[ $CAPTURED_CONFIG_DIGEST == "$AUTH_CONFIG_DIGEST" ]] ||
    die "VMID ${VMID} configuration changed after inspection; cleanup aborted"
  [[ $CAPTURED_STATUS == "$required_status" ]] ||
    die "VMID ${VMID} status changed after inspection: expected '${required_status}', got '${CAPTURED_STATUS}'"
}

resolve_destroy_command() {
  local output
  output=$(qm destroy 2>&1 || true)
  grep -Eq '(^|[^A-Za-z0-9_-])--purge([^A-Za-z0-9_-]|$)' <<<"$output" ||
    die 'Could not verify qm destroy --purge support; cleanup aborted'
  DESTROY_COMMAND=(qm destroy "$VMID" --purge)
  if grep -Eq '(^|[^A-Za-z0-9_-])--destroy-unreferenced-disks([^A-Za-z0-9_-]|$)' <<<"$output"; then
    DESTROY_COMMAND+=(--destroy-unreferenced-disks 1)
  else
    warn 'qm destroy does not support --destroy-unreferenced-disks on this Proxmox version; using --purge only'
  fi
}

authorization_dir() {
  printf '%s\n' "${PLATFORM_VM_CLEANUP_AUTH_DIR:-${TMPDIR:-/tmp}/platform-proxmox-vm-cleanup-auth-${EUID}}"
}

validate_authorization_dir() {
  local dir=$1 owner mode
  [[ -d $dir && ! -L $dir ]] || die "Cleanup authorization directory is not a regular directory: $dir"
  owner=$(stat -c '%u' -- "$dir") || die 'Could not inspect cleanup authorization directory owner'
  mode=$(stat -c '%a' -- "$dir") || die 'Could not inspect cleanup authorization directory mode'
  [[ $owner -eq $EUID && $mode == 700 ]] || die 'Cleanup authorization directory must be current-user-owned with exact mode 700'
}

prepare_authorization_dir() {
  local dir
  dir=$(authorization_dir)
  if [[ ! -e $dir && ! -L $dir ]]; then
    (umask 077; mkdir -- "$dir") || die 'Could not create cleanup authorization directory'
    chmod 700 -- "$dir"
  fi
  validate_authorization_dir "$dir"
  AUTH_DIR=$dir
  AUTH_DIR_DEVICE=$(stat -c '%d' -- "$dir") || die 'Could not inspect cleanup authorization directory device'
}

parse_authorization_content() {
  local content=$1
  local -a lines
  mapfile -t lines <<<"$content"
  [[ ${#lines[@]} -eq 7 && ${lines[0]} == version=1 ]] || die 'Invalid cleanup authorization state'
  AUTH_CREATED=${lines[1]#created=}
  AUTH_NONCE=${lines[2]#nonce=}
  AUTH_VMID=${lines[3]#vmid=}
  AUTH_NAME=${lines[4]#name=}
  AUTH_STATUS=${lines[5]#status=}
  AUTH_CONFIG_DIGEST=${lines[6]#config-sha256=}
  [[ ${lines[1]} == created=* && $AUTH_CREATED =~ ^[0-9]+$ ]] || die 'Invalid cleanup authorization creation time'
  [[ ${lines[2]} == nonce=* && $AUTH_NONCE =~ ^[A-Fa-f0-9]{64}$ ]] || die 'Invalid cleanup authorization nonce'
  [[ ${lines[3]} == vmid=* && $AUTH_VMID =~ ^[0-9]+$ ]] || die 'Invalid cleanup authorization VMID'
  [[ ${lines[4]} == name=* && -n $AUTH_NAME ]] || die 'Invalid cleanup authorization name'
  ! has_control_characters "$AUTH_NAME" || die 'Invalid cleanup authorization name'
  [[ ${lines[5]} == status=running || ${lines[5]} == status=stopped ]] || die 'Invalid cleanup authorization status'
  [[ ${lines[6]} == config-sha256=* && $AUTH_CONFIG_DIGEST =~ ^[A-Fa-f0-9]{64}$ ]] ||
    die 'Invalid cleanup authorization config identity'
  AUTH_NONCE=${AUTH_NONCE,,}
  AUTH_CONFIG_DIGEST=${AUTH_CONFIG_DIGEST,,}
}

validate_authorization_age() {
  local now age
  now=$(date +%s) || die 'Could not read current time for cleanup authorization'
  ((AUTH_CREATED <= now)) || die 'Cleanup authorization creation time is in the future'
  age=$((now - AUTH_CREATED))
  ((age <= 300)) || die 'Cleanup authorization has expired'
}

authorization_content_matches_token() {
  local content=$1 token=$2
  (
    parse_authorization_content "$content"
    [[ $AUTH_NONCE == "${token,,}" ]]
  ) >/dev/null 2>&1
}

cleanup_stale_authorizations() {
  local path content now created metadata identity
  local -a candidates
  now=$(date +%s) || return 1
  cleanup_interrupted_authorizations "$now"
  shopt -s nullglob
  candidates=("$AUTH_DIR"/[A-Fa-f0-9]*)
  shopt -u nullglob
  for path in "${candidates[@]}"; do
    [[ ${path##*/} =~ ^[A-Fa-f0-9]{64}$ && -f $path && ! -L $path ]] || continue
    metadata=$(stat -c '%u:%a:%h:%d:%i' -- "$path" 2>/dev/null || true)
    [[ $metadata == "${EUID}:600:1:${AUTH_DIR_DEVICE}:"* ]] || continue
    identity=${metadata##*:600:1:}
    content=$(<"$path")
    authorization_content_matches_token "$content" "${path##*/}" || continue
    created=$(printf '%s\n' "$content" | awk -F= '$1 == "created" { print $2; exit }')
    [[ $created =~ ^[0-9]+$ ]] || continue
    ((created <= now && now - created > 300)) || continue
    safe_remove_authorization_artifact "$path" "$identity" 1 ||
      warn 'Could not remove an expired cleanup authorization'
  done
}

authorization_artifact_metadata() {
  local path=$1 expected_links=$2 metadata
  [[ -f $path && ! -L $path ]] || return 1
  metadata=$(stat -c '%u:%a:%h:%d:%i:%Y' -- "$path") || return 1
  [[ $metadata == "${EUID}:600:${expected_links}:${AUTH_DIR_DEVICE}:"* ]] || return 1
  printf '%s\n' "$metadata"
}

safe_remove_authorization_artifact() {
  local path=$1 expected_identity=$2 expected_links=$3 metadata identity
  metadata=$(authorization_artifact_metadata "$path" "$expected_links") || return 1
  identity=$(printf '%s\n' "$metadata" | awk -F: '{ print $4 ":" $5 }')
  [[ $identity == "$expected_identity" ]] || return 1
  rm -- "$path"
}

cleanup_interrupted_authorizations() {
  local now=$1 path metadata identity modified token final final_metadata final_identity final_modified content
  local -a consumed_candidates temp_candidates
  shopt -s nullglob
  consumed_candidates=("$AUTH_DIR"/.consumed.*)
  temp_candidates=("$AUTH_DIR"/.tmp.*)
  shopt -u nullglob

  for path in "${consumed_candidates[@]}"; do
    [[ ${path##*/} =~ ^\.consumed\.([A-Fa-f0-9]{64})\.[0-9]+\.[0-9]+$ ]] || continue
    token=${BASH_REMATCH[1],,}
    metadata=$(authorization_artifact_metadata "$path" 1) || continue
    content=$(<"$path")
    authorization_content_matches_token "$content" "$token" || continue
    identity=$(printf '%s\n' "$metadata" | awk -F: '{ print $4 ":" $5 }')
    modified=${metadata##*:}
    ((modified <= now && now - modified > 300)) || continue
    safe_remove_authorization_artifact "$path" "$identity" 1 ||
      warn 'Could not remove an aged consumed cleanup authorization artifact'
  done

  for path in "${temp_candidates[@]}"; do
    [[ ${path##*/} =~ ^\.tmp\.([A-Fa-f0-9]{64})\.[0-9]+$ ]] || continue
    token=${BASH_REMATCH[1],,}
    content=$(<"$path")
    authorization_content_matches_token "$content" "$token" || continue
    if metadata=$(authorization_artifact_metadata "$path" 1); then
      identity=$(printf '%s\n' "$metadata" | awk -F: '{ print $4 ":" $5 }')
      modified=${metadata##*:}
      ((modified <= now && now - modified > 300)) || continue
      safe_remove_authorization_artifact "$path" "$identity" 1 ||
        warn 'Could not remove an aged staged cleanup authorization artifact'
      continue
    fi

    metadata=$(authorization_artifact_metadata "$path" 2) || continue
    identity=$(printf '%s\n' "$metadata" | awk -F: '{ print $4 ":" $5 }')
    modified=${metadata##*:}
    ((modified <= now && now - modified > 300)) || continue
    final="$AUTH_DIR/$token"
    final_metadata=$(authorization_artifact_metadata "$final" 2) || continue
    final_identity=$(printf '%s\n' "$final_metadata" | awk -F: '{ print $4 ":" $5 }')
    [[ $final_identity == "$identity" ]] || continue
    final_modified=${final_metadata##*:}
    ((final_modified <= now && now - final_modified > 300)) || continue
    if safe_remove_authorization_artifact "$path" "$identity" 2; then
      safe_remove_authorization_artifact "$final" "$identity" 1 ||
        warn 'Could not remove the published side of an aged authorization pair'
    else
      warn 'Could not remove the staged side of an aged authorization pair'
    fi
  done
}

new_authorization_nonce() {
  local nonce
  command_exists od || die 'od is required to create cleanup authorization'
  command_exists tr || die 'tr is required to create cleanup authorization'
  nonce=$(od -An -N32 -tx1 /dev/urandom | tr -d '[:space:]') || die 'Could not create cleanup authorization nonce'
  [[ $nonce =~ ^[a-f0-9]{64}$ ]] || die 'Generated cleanup authorization nonce has an invalid shape'
  printf '%s\n' "$nonce"
}

create_authorization() {
  local nonce created temp final metadata identity
  prepare_authorization_dir
  cleanup_stale_authorizations || warn 'Could not complete expired cleanup authorization cleanup'
  nonce=$(new_authorization_nonce)
  created=$(date +%s) || die 'Could not timestamp cleanup authorization'
  temp="$AUTH_DIR/.tmp.${nonce}.$$"
  final="$AUTH_DIR/$nonce"
  metadata=$(printf 'version=1\ncreated=%s\nnonce=%s\nvmid=%s\nname=%s\nstatus=%s\nconfig-sha256=%s\n' \
    "$created" "$nonce" "$CAPTURED_VMID" "$CAPTURED_NAME" "$CAPTURED_STATUS" "$CAPTURED_CONFIG_DIGEST")
  (umask 077; set -o noclobber; printf '%s\n' "$metadata" >"$temp") || die 'Could not stage cleanup authorization'
  chmod 600 -- "$temp"
  authorization_artifact_metadata "$temp" 1 >/dev/null || die 'Staged cleanup authorization has unsafe metadata'
  ln -- "$temp" "$final" || die 'Could not publish cleanup authorization'
  rm -- "$temp" || die 'Could not finalize cleanup authorization'
  metadata=$(authorization_artifact_metadata "$final" 1) || die 'Published cleanup authorization has unsafe metadata'
  identity=$(printf '%s\n' "$metadata" | awk -F: '{ print $4 ":" $5 }')
  [[ -n $identity ]] || die 'Published cleanup authorization has no stable file identity'
  printf '%s\n' "$nonce"
}

consume_authorization() {
  local token=$1 path consumed identity moved_identity metadata content
  prepare_authorization_dir
  path="$AUTH_DIR/$token"
  [[ -f $path && ! -L $path ]] || die 'Cleanup authorization was not found or was already consumed'
  metadata=$(stat -c '%u:%a:%h:%d' -- "$path") || die 'Could not inspect cleanup authorization metadata'
  [[ $metadata == "${EUID}:600:1:${AUTH_DIR_DEVICE}" ]] || die 'Cleanup authorization must be owner-only mode 600 with one link on the authorization filesystem'
  identity=$(stat -c '%d:%i' -- "$path") || die 'Could not inspect cleanup authorization identity'
  consumed="$AUTH_DIR/.consumed.${token}.$$.$RANDOM"
  [[ ! -e $consumed && ! -L $consumed ]] || die 'Could not reserve cleanup authorization consumption path'
  mv -- "$path" "$consumed" || die 'Cleanup authorization was consumed concurrently'
  moved_identity=$(stat -c '%d:%i' -- "$consumed") || die 'Cleanup authorization changed during consumption'
  metadata=$(stat -c '%u:%a:%h:%d' -- "$consumed") || die 'Could not recheck cleanup authorization metadata'
  if [[ $moved_identity != "$identity" || $metadata != "${EUID}:600:1:${AUTH_DIR_DEVICE}" ]]; then
    rm -f -- "$consumed"
    die 'Cleanup authorization changed during consumption'
  fi
  content=$(<"$consumed")
  rm -- "$consumed" || die 'Could not remove consumed cleanup authorization'
  parse_authorization_content "$content"
  [[ $AUTH_NONCE == "${token,,}" ]] || die 'Cleanup authorization nonce does not match its server-side state'
  validate_authorization_age
}

revoke_authorization() {
  local token=$1
  consume_authorization "$token" >/dev/null 2>&1 || return 1
}

cleanup_pending_authorization() {
  local status=$?
  if [[ -n ${PENDING_AUTHORIZATION:-} ]]; then
    if [[ ${PENDING_AUTHORIZATION_REMOTE:-false} == true ]]; then
      (cancel_remote_authorization "$PENDING_AUTHORIZATION") || true
    else
      (revoke_authorization "$PENDING_AUTHORIZATION") || true
    fi
  fi
  return "$status"
}

execute_authorized_cleanup() {
  local token=$1 initial_status
  consume_authorization "$token"
  [[ $AUTH_VMID == "$VMID" ]] || die 'Cleanup authorization conflicts with --vmid'
  [[ -z $EXPECTED_NAME || $AUTH_NAME == "$EXPECTED_NAME" ]] || die 'Cleanup authorization conflicts with --name'
  initial_status=$AUTH_STATUS
  capture_target_state false
  compare_authorized_state "$initial_status"
  resolve_destroy_command
  capture_target_state false
  compare_authorized_state "$initial_status"
  if [[ $initial_status == running ]]; then
    warn "Force-stopping running VMID ${VMID} before destroy"
    qm stop "$VMID"
    capture_target_state false
    compare_authorized_state stopped
  fi
  warn "Destroying VMID ${VMID} with purge enabled"
  "${DESTROY_COMMAND[@]}"
  ok "Destroyed VMID ${VMID}"
}

emit_authorization_token() {
  printf 'PLATFORM_VM_CLEANUP_AUTHORIZATION=%s\n' "$1"
}

extract_authorization_token() {
  local output=$1 line token='' count=0
  while IFS= read -r line || [[ -n $line ]]; do
    case $line in
      PLATFORM_VM_CLEANUP_AUTHORIZATION=*) token=${line#*=}; ((count += 1)) ;;
    esac
  done <<<"$output"
  [[ $count -eq 1 && $token =~ ^[a-f0-9]{64}$ ]] || return 1
  printf '%s\n' "$token"
}

print_remote_inspection_output() {
  local output=$1 line
  while IFS= read -r line || [[ -n $line ]]; do
    case $line in PLATFORM_VM_CLEANUP_AUTHORIZATION=*) ;; *) printf '%s\n' "$line" ;; esac
  done <<<"$output"
}

run_local() {
  local token
  require_proxmox_host
  if [[ $REMOTE_DESTROY == true ]]; then read_authorization_token; execute_authorized_cleanup "$AUTHORIZATION_TOKEN"; return; fi
  if [[ $REMOTE_CANCEL == true ]]; then read_authorization_token; revoke_authorization "$AUTHORIZATION_TOKEN" || die 'Cleanup authorization could not be revoked'; return; fi
  info "Checking VMID ${VMID}"
  capture_target_state true
  token=$(create_authorization)
  if [[ $REMOTE_INSPECT == true ]]; then emit_authorization_token "$token"; return; fi
  PENDING_AUTHORIZATION=$token
  PENDING_AUTHORIZATION_REMOTE=false
  trap cleanup_pending_authorization EXIT
  trap 'exit 1' HUP INT TERM
  confirm_cleanup
  execute_authorized_cleanup "$token"
  PENDING_AUTHORIZATION=''
  trap - EXIT HUP INT TERM
}

prepare_ssh() {
  local expanded
  command_exists ssh || die 'ssh is required for --ssh'
  SELF_PATH=$(resolve_self_path) || die 'Could not locate this script to stream it over SSH'
  SSH_ARGS=()
  if [[ -n $IDENTITY_FILE ]]; then
    expanded=$(expand_path "$IDENTITY_FILE")
    [[ -f $expanded ]] || die "SSH identity file not found: $expanded"
    SSH_ARGS=(-i "$expanded" -o IdentitiesOnly=yes)
  fi
}

remote_receiver_command() {
  cat <<'REMOTE_COMMAND'
exec bash -c 'set -euo pipefail
IFS= read -r mode
IFS= read -r script_size
IFS= read -r vmid
IFS= read -r expected_name
IFS= read -r token
[[ $mode == inspect || $mode == destroy || $mode == cancel ]]
[[ $script_size =~ ^[0-9]+$ && $vmid =~ ^[0-9]+$ ]]
[[ $token == - || $token =~ ^[a-f0-9]{64}$ ]]
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/platform-proxmox-vm-cleanup.XXXXXX")
trap "rm -rf -- \"$tmp_dir\"" EXIT HUP INT TERM
chmod 700 "$tmp_dir"
script_path="$tmp_dir/tool"
token_path="$tmp_dir/authorization-token"
dd bs=1 count="$script_size" iflag=fullblock status=none >"$script_path"
chmod 600 "$script_path"
args=(--vmid "$vmid")
[[ -z $expected_name ]] || args+=(--name "$expected_name")
case $mode in
  inspect) args+=(--remote-inspect) ;;
  destroy) args+=(--remote-destroy) ;;
  cancel) args+=(--remote-cancel) ;;
esac
if [[ $mode == inspect ]]; then
  bash "$script_path" "${args[@]}"
else
  (umask 077; printf "%s\n" "$token" >"$token_path")
  chmod 600 "$token_path"
  token=
  bash "$script_path" "${args[@]}" 3<"$token_path"
fi'
REMOTE_COMMAND
}

run_remote_mode() {
  local mode=$1 token=$2 script_size remote_command
  script_size=$(wc -c <"$SELF_PATH") || die 'Could not determine streamed script size'
  remote_command=$(remote_receiver_command)
  # remote_command is fixed; VM, name, mode, and token data travel over stdin.
  # shellcheck disable=SC2029
  { printf '%s\n%s\n%s\n%s\n%s\n' "$mode" "$script_size" "$VMID" "$EXPECTED_NAME" "$token"; cat "$SELF_PATH"; } |
    ssh "${SSH_ARGS[@]}" "$SSH_TARGET" "$remote_command" 3<&-
}

cancel_remote_authorization() {
  run_remote_mode cancel "$1" >/dev/null 2>&1 || return 1
}

run_over_ssh() {
  local output status token
  prepare_ssh
  info "Inspecting VMID ${VMID} on ${SSH_TARGET}"
  if output=$(run_remote_mode inspect -); then status=0; else status=$?; [[ -z $output ]] || printf '%s\n' "$output"; return "$status"; fi
  token=$(extract_authorization_token "$output") || die 'Remote inspection returned an invalid authorization token'
  print_remote_inspection_output "$output"
  PENDING_AUTHORIZATION=$token
  PENDING_AUTHORIZATION_REMOTE=true
  trap cleanup_pending_authorization EXIT
  trap 'exit 1' HUP INT TERM
  confirm_cleanup
  info "Destroying VMID ${VMID} on ${SSH_TARGET}"
  run_remote_mode destroy "$token"
  PENDING_AUTHORIZATION=''
  trap - EXIT HUP INT TERM
}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        platform_proxmox_vm_cleanup_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="root"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --vmid)

        if [[ -n ${2+x} ]]; then
          args['--vmid']="$2"
          shift
          shift
        else
          printf "%s\n" "--vmid requires an argument: --vmid VMID" >&2
          exit 1
        fi
        ;;

      --ssh)

        if [[ -n ${2+x} ]]; then
          args['--ssh']="$2"
          shift
          shift
        else
          printf "%s\n" "--ssh requires an argument: --ssh DESTINATION" >&2
          exit 1
        fi
        ;;

      --identity-file)

        if [[ -n ${2+x} ]]; then
          args['--identity-file']="$2"
          shift
          shift
        else
          printf "%s\n" "--identity-file requires an argument: --identity-file PATH" >&2
          exit 1
        fi
        ;;

      --name)

        if [[ -n ${2+x} ]]; then
          args['--name']="$2"
          shift
          shift
        else
          printf "%s\n" "--name requires an argument: --name VM-NAME" >&2
          exit 1
        fi
        ;;

      --yes)

        args['--yes']=1
        shift
        ;;

      --remote-inspect)

        args['--remote-inspect']=1
        shift
        ;;

      --remote-destroy)

        args['--remote-destroy']=1
        shift
        ;;

      --remote-cancel)

        args['--remote-cancel']=1
        shift
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  if [[ -z ${args['--vmid']+x} ]]; then
    printf "missing required flag: --vmid VMID\n" >&2
    exit 1
  fi

  if [[ -v args['--vmid'] ]]; then
    validation_output="$(validate_numeric_vmid "${args['--vmid']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--vmid VMID" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--ssh'] ]]; then
    validation_output="$(validate_not_empty "${args['--ssh']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--ssh DESTINATION" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--identity-file'] ]]; then
    validation_output="$(validate_not_empty "${args['--identity-file']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--identity-file PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--name'] ]]; then
    validation_output="$(validate_not_empty "${args['--name']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--name VM-NAME" "$validation_output" >&2
      exit 1
    fi
  fi

}

initialize() {
  declare -g version="platform-proxmox-vm-cleanup 1.4.0"
  set -euo pipefail

  enable_auto_colors

  # Preserve the handwritten parser's interspersed help behavior while allowing
  # any earlier parser or validation error to take precedence.
  legacy_help_compatible=true
  index=0
  while ((index < ${#command_line_args[@]})); do
    argument=${command_line_args[index]}
    case $argument in
      --help|-h)
        if [[ $legacy_help_compatible == true ]]; then
          long_usage=yes
          platform_proxmox_vm_cleanup_usage
          exit 0
        fi
        ;;
      --vmid|--ssh|--identity-file|--name)
        ((index += 1))
        if ((index >= ${#command_line_args[@]})); then
          legacy_help_compatible=false
        fi
        ;;
      --vmid=?*|--ssh=?*|--identity-file=?*|--name=?*|--yes|--remote-inspect|--remote-destroy|--remote-cancel)
        ;;
      *) legacy_help_compatible=false ;;
    esac
    ((index += 1))
  done

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "root") root_command ;;
  esac
}

command_line_args=("$@")
initialize
run "${command_line_args[@]}"
