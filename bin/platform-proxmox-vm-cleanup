if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2))); then
  printf "bash version 4.2 or higher is required\n" >&2
  exit 1
fi

root_command() {
  VMID=${args[--vmid]}
  SSH_TARGET=${args[--ssh]:-}
  IDENTITY_FILE=${args[--identity-file]:-}
  EXPECTED_NAME=${args[--name]:-}
  ASSUME_YES=false
  REMOTE_INSPECT=false
  REMOTE_DESTROY=false
  REMOTE_CANCEL=false
  AUTHORIZATION_TOKEN=''
  [[ ! -v args[--yes] ]] || ASSUME_YES=true
  [[ ! -v args[--remote-inspect] ]] || REMOTE_INSPECT=true
  if [[ -v args[--remote-destroy] ]]; then
    REMOTE_DESTROY=true
    ASSUME_YES=true
  fi
  [[ ! -v args[--remote-cancel] ]] || REMOTE_CANCEL=true

  validate_inputs

  if [[ $REMOTE_INSPECT == true || $REMOTE_DESTROY == true || $REMOTE_CANCEL == true ]]; then
    [[ -z $SSH_TARGET ]] || die '--ssh cannot be combined with internal remote modes'
    run_local
    exit 0
  fi

  if [[ -n $SSH_TARGET ]]; then
    run_over_ssh
  else
    run_local
  fi

}

version_command() {
  echo "$version"
}

platform_proxmox_vm_cleanup_usage() {
  printf "platform-proxmox-vm-cleanup - Safely stop and destroy exactly one Proxmox VM by VMID\n\n"

  printf "%s\n" "$(bold "Usage:")"
  printf "  platform-proxmox-vm-cleanup [OPTIONS]\n"
  printf "  platform-proxmox-vm-cleanup --help | -h\n"
  printf "  platform-proxmox-vm-cleanup --version | -v\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "$(bold "Options:")"

    printf "  %s\n" "$(magenta "--vmid VMID (required)")"
    printf "    Required numeric Proxmox VMID to destroy\n"
    echo

    printf "  %s\n" "$(magenta "--ssh DESTINATION")"
    printf "    SSH target for the Proxmox host\n"
    echo

    printf "  %s\n" "$(magenta "--identity-file PATH")"
    printf "    SSH private key for --ssh\n"
    echo

    printf "  %s\n" "$(magenta "--name VM-NAME")"
    printf "    Abort unless the qm config name exactly matches this value\n"
    echo

    printf "  %s\n" "$(magenta "--yes")"
    printf "    Skip the interactive VMID confirmation prompt\n"
    echo

    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "$(magenta "--version, -v")"
    printf "    Show version number\n"
    echo

    printf "%s\n" "$(bold "Examples:")"
    printf "  platform-proxmox-vm-cleanup --vmid 9900\n"
    printf "  platform-proxmox-vm-cleanup --ssh root@192.0.2.10 --vmid 9900\n"
    printf "  platform-proxmox-vm-cleanup --vmid 9900 --name smoke-9900 --yes\n"
    echo

    printf "Run locally on a Proxmox host, or use --ssh with a DNS-name/IPv4 host or\nuser@host destination to stream this executable and run qm remotely. The\nhelper prints the target configuration and verifies an optional exact name\nguard before confirmation. Without --yes, confirmation requires an\ninteractive TTY and the exact VMID.\n\nThis tool never cleans by name, pattern, tag, range, or state. It only\ndestroys the single VMID provided by --vmid.\n"
    echo

  fi
}

normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

