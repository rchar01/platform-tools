  echo "$version"
}

platform_pki_certificate_export_usage() {
  printf "platform-pki-certificate-export - Publish or resolve an immutable certificate-only CSR export\n\n"

  printf "%s\n" "$(bold "Usage:")"
  printf "  platform-pki-certificate-export COMMAND\n"
  printf "  platform-pki-certificate-export [COMMAND] --help | -h\n"
  printf "  platform-pki-certificate-export --version | -v\n"
  echo

  printf "%s\n" "$(bold "Commands:")"
  printf "  %s   Publish one exact pending CSR response as an immutable export\n" "$(green "publish")"
  printf "  %s   Resolve one digest-pinned immutable certificate export\n" "$(green "resolve")"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "$(bold "Options:")"

    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "$(magenta "--version, -v")"
    printf "    Show version number\n"
    echo

    printf "Publication copies only an authenticated pending CSR certificate response.\nExports are unfinalized and contain no private key. Resolution requires the\nexact service, request ID, and manifest digest; it never infers current or\nlatest state and performs no deployment, activation, or finalization.\n"
    echo

  fi
}

