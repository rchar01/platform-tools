platform_pki_certificate_export_resolve_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        platform_pki_certificate_export_resolve_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="resolve"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --request-id)

        if [[ -n ${2+x} ]]; then
          args['--request-id']="$2"
          shift
          shift
        else
          printf "%s\n" "--request-id requires an argument: --request-id ID" >&2
          exit 1
        fi
        ;;

      --manifest-sha256)

        if [[ -n ${2+x} ]]; then
          args['--manifest-sha256']="$2"
          shift
          shift
        else
          printf "%s\n" "--manifest-sha256 requires an argument: --manifest-sha256 DIGEST" >&2
          exit 1
        fi
        ;;

      --format)

        if [[ -n ${2+x} ]]; then
          args['--format']="$2"
          shift
          shift
        else
          printf "%s\n" "--format requires an argument: --format FORMAT" >&2
          exit 1
        fi
        ;;

      --namespace)

        if [[ -n ${2+x} ]]; then
          args['--namespace']="$2"
          shift
          shift
        else
          printf "%s\n" "--namespace requires an argument: --namespace PATH" >&2
          exit 1
        fi
        ;;

      --pki-dir)

        if [[ -n ${2+x} ]]; then
          args['--pki-dir']="$2"
          shift
          shift
        else
          printf "%s\n" "--pki-dir requires an argument: --pki-dir PATH" >&2
          exit 1
        fi
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        if [[ -z ${args['service']+x} ]]; then
          args['service']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  if [[ -z ${args['service']+x} ]]; then
    printf "missing required argument: SERVICE\nusage: platform-pki-certificate-export resolve SERVICE [OPTIONS]\n" >&2

    exit 1
  fi

  if [[ -z ${args['--request-id']+x} ]]; then
    printf "missing required flag: --request-id ID\n" >&2
    exit 1
  fi
  if [[ -z ${args['--manifest-sha256']+x} ]]; then
    printf "missing required flag: --manifest-sha256 DIGEST\n" >&2
    exit 1
  fi

  [[ -n ${args['--format']:-} ]] || args['--format']="path"

  if [[ -v args['--request-id'] ]]; then
    validation_output="$(validate_not_empty "${args['--request-id']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--request-id ID" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--manifest-sha256'] ]]; then
    validation_output="$(validate_not_empty "${args['--manifest-sha256']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--manifest-sha256 DIGEST" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--namespace'] ]]; then
    validation_output="$(validate_not_empty "${args['--namespace']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--namespace PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ -v args['--pki-dir'] ]]; then
    validation_output="$(validate_not_empty "${args['--pki-dir']:-}")"
    if [[ -n "${validation_output}" ]]; then
      printf "validation error in %s:\n%s\n" "--pki-dir PATH" "$validation_output" >&2
      exit 1
    fi
  fi

  if [[ ${args['--format']:-} ]] && [[ ! ${args['--format']:-} =~ ^(path|json)$ ]]; then
    printf "%s\n" "--format must be one of: path, json" >&2
    exit 1
  fi

}

initialize() {
  declare -g version="platform-pki-certificate-export 2.2.0"
  set -euo pipefail

  enable_auto_colors

  SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  COMMON_PATH=${PLATFORM_TOOLS_LIB_DIR:-}
  if [[ -n $COMMON_PATH ]]; then
    COMMON_PATH=${COMMON_PATH}/platform-pki-common.sh
  elif [[ -r ${SCRIPT_DIR}/../lib/platform-pki-common.sh ]]; then
    COMMON_PATH=${SCRIPT_DIR}/../lib/platform-pki-common.sh
  else
    COMMON_PATH=${PLATFORM_TOOLS_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/platform-tools}/lib/platform-pki-common.sh
  fi
  [[ -r $COMMON_PATH ]] || { printf '[ERROR] platform-pki-common.sh not found\n' >&2; exit 1; }
  # shellcheck source=../../../../lib/platform-pki-common.sh disable=SC1091
  source "$COMMON_PATH"
  CSR_COMMON_PATH=$(dirname -- "$COMMON_PATH")/platform-pki-csr-sign.sh
  [[ -r $CSR_COMMON_PATH ]] || { printf '[ERROR] platform-pki-csr-sign.sh not found\n' >&2; exit 1; }
  # shellcheck source=../../../../lib/platform-pki-csr-sign.sh disable=SC1091
  source "$CSR_COMMON_PATH"

  PKI_CERTIFICATE_EXPORT_RESPONSE_FIELDS=(
    schema request_id nonce operation service target request_sha256 approval_sha256
    inventory_sha256 csr_sha256 csr_spki_sha256 certificate_sha256
    certificate_spki_sha256 chain_sha256 issuer_root issuer_intermediate serial
    not_before_epoch not_after_epoch candidate_state response_principal created_epoch
  )
  PKI_CERTIFICATE_EXPORT_CANDIDATE_FIELDS=(
    schema request_id nonce operation service target state request_sha256
    approval_sha256 inventory_sha256 csr_sha256 csr_spki_sha256 certificate_sha256
    chain_sha256 issuer_root issuer_intermediate serial response_sha256
    response_signature_sha256 created_epoch
  )
  PKI_CERTIFICATE_EXPORT_ARTIFACT_FIELDS=(
    schema kind service request_id operation target source_kind
    source_response_sha256 source_response_signature_sha256 certificate_sha256
    certificate_spki_sha256 chain_sha256 fullchain_sha256 issuer_root
    issuer_intermediate serial not_before_epoch not_after_epoch candidate_state
    deployment_state response_principal created_epoch
  )
  certificate_export_sha256() {
    local value before
    [[ -f $1 && ! -L $1 ]] || pki_die "Certificate export input must be a non-symlink regular file: $1"
    before=$(pki_file_identity "$1") || pki_die "Cannot inspect certificate export input: $1"
    value=$(sha256sum -- "$1") || pki_die "Cannot hash certificate export input: $1"
    [[ $(pki_file_identity "$1") == "$before" ]] || pki_die "Certificate export input changed while being hashed: $1"
    printf '%s\n' "${value%% *}"
  }

  certificate_export_require_decimal() {
    [[ $1 =~ ^(0|[1-9][0-9]*)$ ]] || pki_die "$2 must be a canonical decimal epoch"
  }

  certificate_export_require_digest() {
    [[ $1 =~ ^[0-9a-f]{64}$ ]] || pki_die "$2 must be a lowercase SHA-256 digest"
  }

  certificate_export_pause() {
    local point=$1 marker release
    [[ ${PLATFORM_PKI_CERTIFICATE_EXPORT_PAUSE_AT:-} == "$point" ]] || return 0
    marker=${PLATFORM_PKI_CERTIFICATE_EXPORT_PAUSE_MARKER:?}
    release=${PLATFORM_PKI_CERTIFICATE_EXPORT_PAUSE_RELEASE:?}
    : >"$marker" || pki_die "Cannot create certificate export pause marker: $marker"
    while [[ ! -e $release ]]; do sleep 0.01; done
  }

  certificate_export_validate_tree() {
    local root=$1 kind=$2 completeness=${3:-complete}
    [[ -d $root && ! -L $root ]] || pki_die "$kind must be a non-symlink directory: $root"
    python3 - "$root" "$kind" "$completeness" "$(id -u)" <<'PY' || pki_die "$kind has unexpected or unsafe entries: $root"
import os
import pathlib
import stat
import sys

root = pathlib.Path(sys.argv[1])
kind = sys.argv[2]
complete = sys.argv[3] == "complete"
owner = int(sys.argv[4])
expected_by_kind = {
    "CSR candidate artifact": {"candidate", "tls.crt", "ca-chain.crt", "fullchain.crt", "response", "response.sig"},
    "CSR response artifact": {"tls.crt", "ca-chain.crt", "fullchain.crt", "response", "response.sig"},
    "Certificate export artifact": {"artifact", "tls.crt", "ca-chain.crt", "fullchain.crt", "response", "response.sig"},
    "Staged certificate export artifact": {"artifact", "tls.crt", "ca-chain.crt", "fullchain.crt", "response", "response.sig"},
}
expected = expected_by_kind[kind]
metadata = root.stat(follow_symlinks=False)
if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != owner or stat.S_IMODE(metadata.st_mode) != 0o700:
    raise SystemExit(1)
entries = sorted(os.scandir(root), key=lambda entry: entry.name)
names = {entry.name for entry in entries}
if (complete and names != expected) or (not complete and not names <= expected):
    raise SystemExit(1)
for entry in entries:
    metadata = entry.stat(follow_symlinks=False)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != owner or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) != 0o600:
        raise SystemExit(1)
PY
  }

  certificate_export_compare_file() {
    local first=$1 second=$2 label=$3 first_identity second_identity
    first_identity=$(pki_file_identity "$first") || pki_die "Cannot inspect $label"
    second_identity=$(pki_file_identity "$second") || pki_die "Cannot inspect $label"
    cmp -s -- "$first" "$second" || pki_die "$label differs between the pending candidate and response"
    [[ $(pki_file_identity "$first") == "$first_identity" && $(pki_file_identity "$second") == "$second_identity" ]] || \
      pki_die "$label changed while being compared"
  }

  certificate_export_validate_profile() {
    local certificate=$1 subject text dns ips
    subject=$(openssl x509 -in "$certificate" -noout -subject -nameopt RFC2253) || pki_die 'Cannot inspect exported certificate subject'
    [[ $subject == "subject=CN=$COMMON_NAME" ]] || pki_die 'Exported certificate subject does not match inventory'
    text=$(openssl x509 -in "$certificate" -noout -text) || pki_die 'Cannot inspect exported certificate profile'
    [[ $text == *'Public-Key: (384 bit)'* && $text == *'ASN1 OID: secp384r1'* && $text == *'CA:FALSE'* && $text == *'Digital Signature'* && $text == *'TLS Web Server Authentication'* ]] || \
      pki_die 'Exported certificate has an invalid service profile'
    dns=$(pki_inventory_array "$SERVICE" dns)
    ips=$(pki_inventory_array "$SERVICE" ips)
    printf '%s\n' "$text" | python3 -c 'import textwrap; exec(textwrap.dedent(r"""
  import re
  import sys

  expected = {f"DNS:{value}" for value in sys.argv[1].splitlines() if value}
  expected |= {f"IP Address:{value}" for value in sys.argv[2].splitlines() if value}
  lines = sys.stdin.read().splitlines()
  extensions = []
  sans = set()
  for index, line in enumerate(lines):
      match = re.match(r"^\s+X509v3 ([^:]+):( critical)?\s*$", line)
      if not match or match.group(1) == "extensions":
          continue
      extensions.append((match.group(1), bool(match.group(2))))
      if match.group(1) == "Subject Alternative Name":
          if index + 1 >= len(lines):
              raise SystemExit(1)
          sans = {value.strip() for value in lines[index + 1].strip().split(",")}
  required = {
      ("Basic Constraints", True),
      ("Key Usage", True),
      ("Extended Key Usage", False),
      ("Subject Alternative Name", False),
      ("Subject Key Identifier", False),
      ("Authority Key Identifier", False),
  }
  if set(extensions) != required or len(extensions) != len(required) or sans != expected:
      raise SystemExit(1)
  """))' "$dns" "$ips" || pki_die 'Exported certificate SANs or extensions do not match inventory'
  }

  certificate_export_spki_sha256() {
    local output
    output=$(
      set -o pipefail
      openssl x509 -in "$1" -pubkey -noout 2>/dev/null |
        openssl pkey -pubin -outform DER 2>/dev/null |
        sha256sum
    ) || pki_die 'Cannot extract exported certificate public key'
    printf '%s\n' "${output%% *}"
  }

  certificate_export_recheck_sources() {
    local key path
    [[ $(pki_dir_identity "$CANDIDATE_DIR") == "$CANDIDATE_DIR_IDENTITY" && $(pki_dir_identity "$RESPONSE_DIR") == "$RESPONSE_DIR_IDENTITY" ]] || \
      pki_die 'CSR source artifact directory identity changed'
    for key in "${!CERT_SOURCE_IDENTITIES[@]}"; do
      path=$PKI_DIR/state/csr/${key%%/*}s/$SERVICE/$REQUEST_ID/${key#*/}
      [[ -f $path && ! -L $path && $(pki_file_identity "$path") == "${CERT_SOURCE_IDENTITIES[$key]}" ]] || \
        pki_die "CSR source artifact file identity changed: $key"
    done
  }

  certificate_export_recheck_artifact() {
    local name path
    certificate_export_validate_tree "$EXPORT_DIR" 'Certificate export artifact'
    [[ $(pki_dir_identity "$EXPORT_DIR") == "$CERT_ARTIFACT_DIR_IDENTITY" ]] || \
      pki_die 'Certificate export artifact directory identity changed after validation'
    for name in artifact tls.crt ca-chain.crt fullchain.crt response response.sig; do
      path=$EXPORT_DIR/$name
      [[ -f $path && ! -L $path && $(pki_file_identity "$path") == "${CERT_ARTIFACT_IDENTITIES[$name]}" ]] || \
        pki_die "Certificate export artifact file identity changed after validation: $name"
    done
  }

  certificate_export_validate_sources() {
    local name response_digest signature_digest certificate_digest chain_digest fullchain_digest
    local root_cert intermediate_cert serial not_before not_after spki trust trust_identity transaction_identity
    local trust_snapshot trust_snapshot_identity opened after fd
    CANDIDATE_DIR="$PKI_DIR/state/csr/candidates/$SERVICE/$REQUEST_ID"
    RESPONSE_DIR="$PKI_DIR/state/csr/responses/$SERVICE/$REQUEST_ID"
    TRANSACTION_DIR="$PKI_DIR/state/csr/transactions/csr-$REQUEST_ID"
    certificate_export_validate_tree "$CANDIDATE_DIR" 'CSR candidate artifact'
    certificate_export_validate_tree "$RESPONSE_DIR" 'CSR response artifact'
    CANDIDATE_DIR_IDENTITY=$(pki_dir_identity "$CANDIDATE_DIR")
    RESPONSE_DIR_IDENTITY=$(pki_dir_identity "$RESPONSE_DIR")
    declare -gA CERT_SOURCE_IDENTITIES=()
    for name in candidate tls.crt ca-chain.crt fullchain.crt response response.sig; do
      CERT_SOURCE_IDENTITIES[candidate/$name]=$(pki_file_identity "$CANDIDATE_DIR/$name")
    done
    for name in tls.crt ca-chain.crt fullchain.crt response response.sig; do
      CERT_SOURCE_IDENTITIES[response/$name]=$(pki_file_identity "$RESPONSE_DIR/$name")
    done
    for name in tls.crt ca-chain.crt fullchain.crt response response.sig; do
      certificate_export_compare_file "$CANDIDATE_DIR/$name" "$RESPONSE_DIR/$name" "$name"
    done

    declare -gA CERT_RESPONSE=() CERT_CANDIDATE=()
    pki_csr_read_ordered_record "$RESPONSE_DIR/response" 'CSR response manifest' CERT_RESPONSE "${PKI_CERTIFICATE_EXPORT_RESPONSE_FIELDS[@]}"
    pki_csr_read_ordered_record "$CANDIDATE_DIR/candidate" 'CSR candidate record' CERT_CANDIDATE "${PKI_CERTIFICATE_EXPORT_CANDIDATE_FIELDS[@]}"
    [[ $(wc -l <"$RESPONSE_DIR/response") -eq ${#PKI_CERTIFICATE_EXPORT_RESPONSE_FIELDS[@]} && \
      $(wc -l <"$CANDIDATE_DIR/candidate") -eq ${#PKI_CERTIFICATE_EXPORT_CANDIDATE_FIELDS[@]} ]] || \
      pki_die 'CSR response or candidate record is not canonically newline-terminated'
    [[ ${CERT_RESPONSE[schema]} == 1 && ${CERT_CANDIDATE[schema]} == 1 ]] || pki_die 'CSR response or candidate schema is unsupported'
    [[ ${CERT_RESPONSE[request_id]} == "$REQUEST_ID" && ${CERT_CANDIDATE[request_id]} == "$REQUEST_ID" ]] || pki_die 'CSR artifact request ID does not match the requested export'
    [[ ${CERT_RESPONSE[service]} == "$SERVICE" && ${CERT_CANDIDATE[service]} == "$SERVICE" ]] || pki_die 'CSR artifact service does not match the requested export'
    [[ ${CERT_RESPONSE[operation]} == issue || ${CERT_RESPONSE[operation]} == migrate || ${CERT_RESPONSE[operation]} == renew ]] || pki_die 'CSR response operation is invalid'
    [[ ${CERT_RESPONSE[target]} == "$INVENTORY_TARGET" && ${CERT_CANDIDATE[target]} == "$INVENTORY_TARGET" ]] || pki_die 'CSR artifact target does not match current inventory'
    [[ ${CERT_RESPONSE[response_principal]} =~ ^[a-z0-9][a-z0-9.-]*$ ]] || pki_die 'CSR response identity is invalid'
    [[ ${CERT_RESPONSE[candidate_state]} == pending && ${CERT_CANDIDATE[state]} == pending ]] || pki_die 'CSR candidate is not pending'
    [[ ${CERT_RESPONSE[nonce]} =~ ^[0-9a-f]{64}$ ]] || pki_die 'CSR response nonce is invalid'
    for name in request_sha256 approval_sha256 inventory_sha256 csr_sha256 csr_spki_sha256 certificate_sha256 certificate_spki_sha256 chain_sha256; do
      certificate_export_require_digest "${CERT_RESPONSE[$name]}" "CSR response $name"
    done
    for name in request_id nonce operation service target request_sha256 approval_sha256 inventory_sha256 csr_sha256 csr_spki_sha256 certificate_sha256 chain_sha256 issuer_root issuer_intermediate serial created_epoch; do
      [[ ${CERT_CANDIDATE[$name]} == "${CERT_RESPONSE[$name]}" ]] || pki_die "CSR candidate does not bind response field: $name"
    done
    response_digest=$(certificate_export_sha256 "$RESPONSE_DIR/response")
    signature_digest=$(certificate_export_sha256 "$RESPONSE_DIR/response.sig")
    [[ ${CERT_CANDIDATE[response_sha256]} == "$response_digest" && ${CERT_CANDIDATE[response_signature_sha256]} == "$signature_digest" ]] || pki_die 'CSR candidate does not bind the exact signed response'

    pki_validate_root_generation "${CERT_RESPONSE[issuer_root]}"
    pki_validate_intermediate_generation "${CERT_RESPONSE[issuer_intermediate]}"
    [[ ${CERT_RESPONSE[issuer_intermediate]} == "${CERT_RESPONSE[issuer_root]}"-i* ]] || pki_die 'CSR response issuer generations do not match'
    ROOT_CA_DIR=$(pki_root_authority_dir "${CERT_RESPONSE[issuer_root]}")
    INTERMEDIATE_CA_DIR=$(pki_intermediate_authority_dir "${CERT_RESPONSE[issuer_intermediate]}")
    pki_require_private_dir "$ROOT_CA_DIR" 'CSR response root generation'
    pki_require_private_dir "$INTERMEDIATE_CA_DIR" 'CSR response intermediate generation'
    root_cert=$(pki_root_cert "${CERT_RESPONSE[issuer_root]}")
    intermediate_cert=$(pki_intermediate_cert "${CERT_RESPONSE[issuer_intermediate]}")
    pki_csr_require_protocol_file "$root_cert" 'CSR response root certificate'
    pki_csr_require_protocol_file "$intermediate_cert" 'CSR response intermediate certificate'
    pki_require_ca_certificate_profile "$root_cert" 1 'CSR response root certificate'
    pki_require_ca_self_signature "$root_cert" 'CSR response root certificate'
    pki_require_ca_certificate_profile "$intermediate_cert" 0 'CSR response intermediate certificate'
    openssl verify -CAfile "$root_cert" "$intermediate_cert" >/dev/null 2>&1 || pki_die 'CSR response intermediate does not verify against its root generation'
    openssl verify -CAfile "$root_cert" -untrusted "$intermediate_cert" "$RESPONSE_DIR/tls.crt" >/dev/null 2>&1 || pki_die 'CSR response certificate chain verification failed'
    cmp -s -- "$RESPONSE_DIR/ca-chain.crt" <(cat -- "$intermediate_cert" "$root_cert") || pki_die 'CSR response CA chain does not match its issuer generations'
    cmp -s -- "$RESPONSE_DIR/fullchain.crt" <(cat -- "$RESPONSE_DIR/tls.crt" "$intermediate_cert") || pki_die 'CSR response full chain does not match its leaf and intermediate'

    certificate_digest=$(certificate_export_sha256 "$RESPONSE_DIR/tls.crt")
    chain_digest=$(certificate_export_sha256 "$RESPONSE_DIR/ca-chain.crt")
    fullchain_digest=$(certificate_export_sha256 "$RESPONSE_DIR/fullchain.crt")
    [[ $certificate_digest == "${CERT_RESPONSE[certificate_sha256]}" && $chain_digest == "${CERT_RESPONSE[chain_sha256]}" ]] || pki_die 'CSR response certificate or chain digest binding failed'
    spki=$(certificate_export_spki_sha256 "$RESPONSE_DIR/tls.crt")
    certificate_export_require_digest "$spki" 'Exported certificate SPKI digest'
    [[ $spki == "${CERT_RESPONSE[certificate_spki_sha256]}" && $spki == "${CERT_RESPONSE[csr_spki_sha256]}" ]] || pki_die 'CSR response certificate public key binding failed'
    serial=$(openssl x509 -in "$RESPONSE_DIR/tls.crt" -noout -serial) || pki_die 'Cannot inspect CSR response certificate serial'
    serial=${serial#serial=}; serial=${serial#Serial=}; serial=${serial^^}
    [[ ${CERT_RESPONSE[serial]} =~ ^([0-9A-F][0-9A-F])+$ && $serial == "${CERT_RESPONSE[serial]}" ]] || pki_die 'CSR response certificate serial binding failed'
    not_before=$(date -u -d "$(openssl x509 -in "$RESPONSE_DIR/tls.crt" -noout -startdate | sed 's/^notBefore=//')" +%s) || pki_die 'Cannot parse CSR response certificate notBefore'
    not_after=$(date -u -d "$(openssl x509 -in "$RESPONSE_DIR/tls.crt" -noout -enddate | sed 's/^notAfter=//')" +%s) || pki_die 'Cannot parse CSR response certificate notAfter'
    certificate_export_require_decimal "${CERT_RESPONSE[not_before_epoch]}" 'CSR response not_before_epoch'
    certificate_export_require_decimal "${CERT_RESPONSE[not_after_epoch]}" 'CSR response not_after_epoch'
    certificate_export_require_decimal "${CERT_RESPONSE[created_epoch]}" 'CSR response created_epoch'
    [[ $not_before == "${CERT_RESPONSE[not_before_epoch]}" && $not_after == "${CERT_RESPONSE[not_after_epoch]}" && $not_after -gt $not_before ]] || pki_die 'CSR response certificate validity binding failed'
    certificate_export_validate_profile "$RESPONSE_DIR/tls.crt"

    pki_require_private_dir "$TRANSACTION_DIR" 'CSR signing transaction directory'
    trust=$TRANSACTION_DIR/responses.allowed_signers
    pki_csr_require_protocol_file "$trust" 'Retained CSR response trust snapshot'
    transaction_identity=$(pki_dir_identity "$TRANSACTION_DIR")
    trust_identity=$(pki_file_identity "$trust")
    exec {fd}<"$trust" || pki_die 'Cannot open retained CSR response trust snapshot'
    opened=$(stat -Lc '%d:%i:%u:%a:%h:%s:%y:%z:%F' "/proc/self/fd/$fd") || { exec {fd}<&-; pki_die 'Cannot inspect opened retained CSR response trust snapshot'; }
    [[ $opened == "$trust_identity" && $(pki_file_identity "$trust") == "$trust_identity" && $(pki_dir_identity "$TRANSACTION_DIR") == "$transaction_identity" ]] || \
      { exec {fd}<&-; pki_die 'Retained CSR response trust snapshot changed while opening'; }
    certificate_export_pause retained-trust-opened
    trust_snapshot=$INVENTORY_SNAPSHOT_DIR/responses.allowed_signers
    [[ ! -e $trust_snapshot && ! -L $trust_snapshot ]] || { exec {fd}<&-; pki_die 'Retained CSR response trust snapshot destination is unsafe'; }
    cp -- "/proc/self/fd/$fd" "$trust_snapshot" || { exec {fd}<&-; pki_die 'Cannot copy retained CSR response trust snapshot'; }
    chmod 600 "$trust_snapshot" || { exec {fd}<&-; pki_die 'Cannot secure retained CSR response trust snapshot'; }
    trust_snapshot_identity=$(pki_file_identity "$trust_snapshot") || { exec {fd}<&-; pki_die 'Cannot inspect copied CSR response trust snapshot'; }
    INVENTORY_SNAPSHOT_FILES[responses.allowed_signers]=$trust_snapshot_identity
    after=$(stat -Lc '%d:%i:%u:%a:%h:%s:%y:%z:%F' "/proc/self/fd/$fd") || { exec {fd}<&-; pki_die 'Cannot reinspect opened retained CSR response trust snapshot'; }
    if [[ $after != "$trust_identity" || ! -f $trust || -L $trust || $(pki_file_identity "$trust") != "$trust_identity" || $(pki_dir_identity "$TRANSACTION_DIR") != "$transaction_identity" ]]; then
      exec {fd}<&-
      pki_die 'Retained CSR response trust snapshot changed while being copied'
    fi
    exec {fd}<&-
    pki_csr_require_protocol_file "$trust_snapshot" 'Copied CSR response trust snapshot'
    [[ $(pki_file_identity "$trust_snapshot") == "$trust_snapshot_identity" ]] || pki_die 'Copied CSR response trust snapshot identity changed'
    pki_csr_validate_allowed_signers "$trust_snapshot" "${CERT_RESPONSE[response_principal]}" true
    pki_csr_verify_signature "$trust_snapshot" "${CERT_RESPONSE[response_principal]}" platform-pki-csr-response-v1 "$RESPONSE_DIR/response.sig" "$RESPONSE_DIR/response" 'CSR response'
    [[ $(pki_file_identity "$trust_snapshot") == "$trust_snapshot_identity" ]] || pki_die 'Copied CSR response trust snapshot changed during verification'
    certificate_export_recheck_sources

    SOURCE_RESPONSE_SHA256=$response_digest
    SOURCE_SIGNATURE_SHA256=$signature_digest
    CERTIFICATE_SHA256=$certificate_digest
    CERTIFICATE_SPKI_SHA256=$spki
    CHAIN_SHA256=$chain_digest
    FULLCHAIN_SHA256=$fullchain_digest
  }

  certificate_export_manifest_content() {
    cat <<EOF
schema=1
kind=certificate-export
service=$SERVICE
request_id=$REQUEST_ID
operation=${CERT_RESPONSE[operation]}
target=${CERT_RESPONSE[target]}
source_kind=csr-response
source_response_sha256=$SOURCE_RESPONSE_SHA256
source_response_signature_sha256=$SOURCE_SIGNATURE_SHA256
certificate_sha256=$CERTIFICATE_SHA256
certificate_spki_sha256=$CERTIFICATE_SPKI_SHA256
chain_sha256=$CHAIN_SHA256
fullchain_sha256=$FULLCHAIN_SHA256
issuer_root=${CERT_RESPONSE[issuer_root]}
issuer_intermediate=${CERT_RESPONSE[issuer_intermediate]}
serial=${CERT_RESPONSE[serial]}
not_before_epoch=${CERT_RESPONSE[not_before_epoch]}
not_after_epoch=${CERT_RESPONSE[not_after_epoch]}
candidate_state=pending
deployment_state=unfinalized
response_principal=${CERT_RESPONSE[response_principal]}
created_epoch=${CERT_RESPONSE[created_epoch]}
EOF
  }

  certificate_export_validate_artifact() {
    local root=$1 expected_digest=${2:-} name actual manifest_identity
    certificate_export_validate_tree "$root" 'Certificate export artifact'
    CERT_ARTIFACT_DIR_IDENTITY=$(pki_dir_identity "$root")
    unset -v CERT_ARTIFACT_IDENTITIES
    declare -gA CERT_ARTIFACT_IDENTITIES=()
    for name in artifact tls.crt ca-chain.crt fullchain.crt response response.sig; do
      CERT_ARTIFACT_IDENTITIES[$name]=$(pki_file_identity "$root/$name")
    done
    declare -gA CERT_ARTIFACT=()
    pki_csr_read_ordered_record "$root/artifact" 'Certificate export manifest' CERT_ARTIFACT "${PKI_CERTIFICATE_EXPORT_ARTIFACT_FIELDS[@]}"
    [[ $(wc -l <"$root/artifact") -eq ${#PKI_CERTIFICATE_EXPORT_ARTIFACT_FIELDS[@]} ]] || \
      pki_die 'Certificate export manifest is not canonically newline-terminated'
    [[ ${CERT_ARTIFACT[schema]} == 1 && ${CERT_ARTIFACT[kind]} == certificate-export && ${CERT_ARTIFACT[source_kind]} == csr-response ]] || pki_die 'Certificate export manifest schema or kind is unsupported'
    [[ ${CERT_ARTIFACT[service]} == "$SERVICE" && ${CERT_ARTIFACT[request_id]} == "$REQUEST_ID" ]] || pki_die 'Certificate export manifest identity does not match the requested artifact'
    [[ ${CERT_ARTIFACT[operation]} == "${CERT_RESPONSE[operation]}" && ${CERT_ARTIFACT[target]} == "${CERT_RESPONSE[target]}" ]] || pki_die 'Certificate export operation or target binding failed'
    [[ ${CERT_ARTIFACT[source_response_sha256]} == "$SOURCE_RESPONSE_SHA256" && ${CERT_ARTIFACT[source_response_signature_sha256]} == "$SOURCE_SIGNATURE_SHA256" ]] || pki_die 'Certificate export source response binding failed'
    [[ ${CERT_ARTIFACT[certificate_sha256]} == "$CERTIFICATE_SHA256" && ${CERT_ARTIFACT[certificate_spki_sha256]} == "$CERTIFICATE_SPKI_SHA256" && ${CERT_ARTIFACT[chain_sha256]} == "$CHAIN_SHA256" && ${CERT_ARTIFACT[fullchain_sha256]} == "$FULLCHAIN_SHA256" ]] || pki_die 'Certificate export certificate digest binding failed'
    for name in issuer_root issuer_intermediate serial not_before_epoch not_after_epoch response_principal created_epoch; do
      [[ ${CERT_ARTIFACT[$name]} == "${CERT_RESPONSE[$name]}" ]] || pki_die "Certificate export does not bind response field: $name"
    done
    [[ ${CERT_ARTIFACT[candidate_state]} == pending && ${CERT_ARTIFACT[deployment_state]} == unfinalized ]] || pki_die 'Certificate export state is not pending and unfinalized'
    [[ $(certificate_export_sha256 "$root/tls.crt") == "$CERTIFICATE_SHA256" && \
      $(certificate_export_sha256 "$root/ca-chain.crt") == "$CHAIN_SHA256" && \
      $(certificate_export_sha256 "$root/fullchain.crt") == "$FULLCHAIN_SHA256" && \
      $(certificate_export_sha256 "$root/response") == "$SOURCE_RESPONSE_SHA256" && \
      $(certificate_export_sha256 "$root/response.sig") == "$SOURCE_SIGNATURE_SHA256" ]] || \
      pki_die 'Certificate export file digest validation failed'
    certificate_export_compare_file "$root/tls.crt" "$RESPONSE_DIR/tls.crt" 'Exported certificate'
    certificate_export_compare_file "$root/ca-chain.crt" "$RESPONSE_DIR/ca-chain.crt" 'Exported CA chain'
    certificate_export_compare_file "$root/fullchain.crt" "$RESPONSE_DIR/fullchain.crt" 'Exported full chain'
    certificate_export_compare_file "$root/response" "$RESPONSE_DIR/response" 'Exported response manifest'
    certificate_export_compare_file "$root/response.sig" "$RESPONSE_DIR/response.sig" 'Exported response signature'
    manifest_identity=$(pki_file_identity "$root/artifact")
    actual=$(certificate_export_sha256 "$root/artifact")
    [[ -z $expected_digest || $actual == "$expected_digest" ]] || pki_die 'Certificate export manifest digest does not match --manifest-sha256'
    certificate_export_recheck_sources
    [[ $(pki_file_identity "$root/artifact") == "$manifest_identity" ]] || pki_die 'Certificate export manifest changed during validation'
    EXPORT_DIR=$root
    certificate_export_recheck_artifact
    ARTIFACT_SHA256=$actual
  }

  certificate_export_prepare_parent() {
    local path
    for path in "$PKI_DIR/export" "$PKI_DIR/export/certificates" "$PKI_DIR/export/certificates/v1" "$PKI_DIR/export/certificates/v1/artifacts" "$PKI_DIR/export/certificates/v1/artifacts/$SERVICE"; do
      if [[ ! -e $path && ! -L $path ]]; then
        mkdir -m 700 -- "$path" || pki_die "Cannot create certificate export directory: $path"
        pki_fsync "$(dirname -- "$path")"
      fi
      pki_require_private_dir "$path" 'Certificate export directory'
    done
    EXPORT_SERVICE_DIR=$PKI_DIR/export/certificates/v1/artifacts/$SERVICE
    EXPORT_DIR=$EXPORT_SERVICE_DIR/$REQUEST_ID
  }

  certificate_export_copy_source() {
    local source=$1 destination=$2 label=$3 before opened after fd
    pki_csr_require_protocol_file "$source" "$label"
    before=$(pki_file_identity "$source")
    [[ $before == "${CERT_SOURCE_IDENTITIES[response/$(basename -- "$source")]}" ]] || pki_die "$label identity changed after validation"
    exec {fd}<"$source" || pki_die "Cannot open $label"
    opened=$(stat -Lc '%d:%i:%u:%a:%h:%s:%y:%z:%F' "/proc/self/fd/$fd") || { exec {fd}<&-; pki_die "Cannot inspect opened $label"; }
    [[ $opened == "$before" && $(pki_file_identity "$source") == "$before" ]] || { exec {fd}<&-; pki_die "$label changed while opening"; }
    cp -- "/proc/self/fd/$fd" "$destination" || { exec {fd}<&-; pki_die "Cannot stage $label"; }
    after=$(stat -Lc '%d:%i:%u:%a:%h:%s:%y:%z:%F' "/proc/self/fd/$fd")
    exec {fd}<&-
    [[ $after == "$before" && $(pki_file_identity "$source") == "$before" ]] || pki_die "$label changed while being staged"
    chmod 600 "$destination" || pki_die "Cannot secure staged $label"
  }

  certificate_export_cleanup_stage() {
    local status=${1:-0} path name identity
    [[ -n ${EXPORT_STAGE:-} && -n ${EXPORT_STAGE_IDENTITY:-} && -d $EXPORT_STAGE && ! -L $EXPORT_STAGE ]] || return "$status"
    [[ $(pki_dir_identity "$EXPORT_STAGE") == "$EXPORT_STAGE_IDENTITY" ]] || return 1
    while IFS= read -r -d '' path; do
      name=$(basename -- "$path")
      [[ -v EXPORT_STAGE_FILES[$name] && -f $path && ! -L $path ]] || return 1
      identity=${EXPORT_STAGE_FILES[$name]}
      [[ $(pki_file_identity "$path") == "$identity" ]] || return 1
    done < <(find "$EXPORT_STAGE" -mindepth 1 -maxdepth 1 -print0)
    for name in "${!EXPORT_STAGE_FILES[@]}"; do
      path=$EXPORT_STAGE/$name
      [[ -f $path && ! -L $path ]] || continue
      pki_remove_identity_file "$path" "${EXPORT_STAGE_FILES[$name]}" || return 1
    done
    [[ $(pki_dir_identity "$EXPORT_STAGE") == "$EXPORT_STAGE_IDENTITY" ]] || return 1
    rmdir -- "$EXPORT_STAGE" || return 1
    pki_fsync "$EXPORT_SERVICE_DIR"
    EXPORT_STAGE=''; EXPORT_STAGE_IDENTITY=''
    return "$status"
  }

  certificate_export_cleanup_inventory_snapshot() {
    local status=${1:-0} path name
    [[ -n ${INVENTORY_SNAPSHOT_DIR:-} && -n ${INVENTORY_SNAPSHOT_IDENTITY:-} && -d $INVENTORY_SNAPSHOT_DIR && ! -L $INVENTORY_SNAPSHOT_DIR ]] || return "$status"
    [[ $(pki_dir_identity "$INVENTORY_SNAPSHOT_DIR") == "$INVENTORY_SNAPSHOT_IDENTITY" ]] || return 1
    while IFS= read -r -d '' path; do
      name=$(basename -- "$path")
      [[ -v INVENTORY_SNAPSHOT_FILES[$name] && -f $path && ! -L $path && $(pki_file_identity "$path") == "${INVENTORY_SNAPSHOT_FILES[$name]}" ]] || return 1
    done < <(find "$INVENTORY_SNAPSHOT_DIR" -mindepth 1 -maxdepth 1 -print0)
    for name in "${!INVENTORY_SNAPSHOT_FILES[@]}"; do
      path=$INVENTORY_SNAPSHOT_DIR/$name
      [[ -f $path && ! -L $path && $(pki_file_identity "$path") == "${INVENTORY_SNAPSHOT_FILES[$name]}" ]] || return 1
      pki_remove_identity_file "$path" "${INVENTORY_SNAPSHOT_FILES[$name]}" || return 1
    done
    [[ $(pki_dir_identity "$INVENTORY_SNAPSHOT_DIR") == "$INVENTORY_SNAPSHOT_IDENTITY" ]] || return 1
    rmdir -- "$INVENTORY_SNAPSHOT_DIR" || return 1
    pki_fsync "$(dirname -- "$INVENTORY_SNAPSHOT_DIR")"
    INVENTORY_SNAPSHOT_DIR=''; INVENTORY_SNAPSHOT_IDENTITY=''
    return "$status"
  }

  certificate_export_publish() {
    local name content status=0
    certificate_export_prepare_parent
    if [[ -e $EXPORT_DIR || -L $EXPORT_DIR ]]; then
      [[ -d $EXPORT_DIR && ! -L $EXPORT_DIR ]] || pki_die 'Certificate export destination is unsafe'
      certificate_export_validate_artifact "$EXPORT_DIR"
      pki_ok "Kept exact immutable certificate export: $EXPORT_DIR"
      printf 'manifest_sha256=%s\n' "$ARTIFACT_SHA256"
      return 0
    fi
    EXPORT_STAGE=$(mktemp -d "$EXPORT_SERVICE_DIR/.platform-pki-certificate-export.$REQUEST_ID.XXXXXX") || pki_die 'Cannot create certificate export stage'
    chmod 700 "$EXPORT_STAGE"
    EXPORT_STAGE_IDENTITY=$(pki_dir_identity "$EXPORT_STAGE") || pki_die 'Cannot snapshot certificate export stage identity'
    declare -gA EXPORT_STAGE_FILES=()
    trap 'status=$?; trap - EXIT; certificate_export_finish "$status"' EXIT
    for name in tls.crt ca-chain.crt fullchain.crt response response.sig; do
      certificate_export_copy_source "$RESPONSE_DIR/$name" "$EXPORT_STAGE/$name" "CSR response $name"
      EXPORT_STAGE_FILES[$name]=$(pki_file_identity "$EXPORT_STAGE/$name")
    done
    [[ $(pki_dir_identity "$EXPORT_STAGE") == "$EXPORT_STAGE_IDENTITY" ]] || pki_die 'Certificate export stage identity changed before manifest creation'
    content=$(certificate_export_manifest_content)$'\n'
    printf '%s' "$content" >"$EXPORT_STAGE/artifact" || pki_die 'Cannot write certificate export manifest'
    chmod 600 "$EXPORT_STAGE/artifact"
    EXPORT_STAGE_FILES[artifact]=$(pki_file_identity "$EXPORT_STAGE/artifact")
    certificate_export_validate_tree "$EXPORT_STAGE" 'Staged certificate export artifact'
    pki_fsync_tree "$EXPORT_STAGE"
    [[ $(pki_dir_identity "$EXPORT_STAGE") == "$EXPORT_STAGE_IDENTITY" ]] || pki_die 'Certificate export stage identity changed before publication'
    [[ ! -e $EXPORT_DIR && ! -L $EXPORT_DIR ]] || pki_die 'Certificate export destination appeared before publication'
    certificate_export_pause publish-before-rename
    mv --no-copy --update=none-fail -T -- "$EXPORT_STAGE" "$EXPORT_DIR" || pki_die 'Cannot publish immutable certificate export'
    pki_fsync_rename_parents "$EXPORT_SERVICE_DIR" "$EXPORT_SERVICE_DIR"
    EXPORT_STAGE=''; EXPORT_STAGE_IDENTITY=''
    certificate_export_validate_artifact "$EXPORT_DIR"
    pki_ok "Published immutable unfinalized certificate export: $EXPORT_DIR"
    printf 'manifest_sha256=%s\n' "$ARTIFACT_SHA256"
  }

  certificate_export_resolve() {
    local absolute
    certificate_export_require_digest "$MANIFEST_SHA256" '--manifest-sha256'
    EXPORT_DIR=$PKI_DIR/export/certificates/v1/artifacts/$SERVICE/$REQUEST_ID
    certificate_export_validate_artifact "$EXPORT_DIR" "$MANIFEST_SHA256"
    absolute=$(cd -- "$EXPORT_DIR" && pwd -P) || pki_die 'Cannot resolve certificate export path'
    certificate_export_pause resolver-before-output
    certificate_export_recheck_artifact
    certificate_export_recheck_sources
    if [[ $FORMAT == path ]]; then
      printf '%s\n' "$absolute"
    else
      python3 - "$SERVICE" "$REQUEST_ID" "$ARTIFACT_SHA256" "$absolute" <<'PY'
import json
import sys

print(json.dumps({
    "schema": 1,
    "kind": "certificate-export-resolution",
    "service": sys.argv[1],
    "request_id": sys.argv[2],
    "manifest_sha256": sys.argv[3],
    "path": sys.argv[4],
    "candidate_state": "pending",
    "deployment_state": "unfinalized",
}, sort_keys=True, separators=(",", ":")))
PY
    fi
  }

  certificate_export_finish() {
    local status=${1:-$?}
    trap - EXIT
    certificate_export_cleanup_stage "$status" || status=1
    certificate_export_cleanup_inventory_snapshot "$status" || status=1
    [[ ${EXPORT_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$EXPORT_LOCK" 2>/dev/null || status=1
    [[ ${INVENTORY_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$INVENTORY_LOCK" 2>/dev/null || status=1
    [[ ${INTERMEDIATE_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$INTERMEDIATE_LOCK" 2>/dev/null || status=1
    [[ ${ROOT_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$ROOT_LOCK" 2>/dev/null || status=1
    [[ ${LIFECYCLE_LOCK_HELD:-false} != true ]] || pki_release_operation_lock "$LIFECYCLE_LOCK" 2>/dev/null || status=1
    exit "$status"
  }

  # shellcheck disable=SC2154 # Bashly defines args and command_line_args.
  certificate_export_run() {
    local action=$1
    pki_reject_repeated_options --request-id --manifest-sha256 --format --namespace --pki-dir
    SERVICE=${args[service]}
    REQUEST_ID=${args[--request-id]}
    NAMESPACE=${args[--namespace]:-$(pki_default_namespace)}
    PKI_DIR=${args[--pki-dir]:-}
    MANIFEST_SHA256=${args[--manifest-sha256]:-}
    FORMAT=${args[--format]:-path}
    pki_validate_service_name "$SERVICE"
    [[ $SERVICE =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ && $SERVICE != . && $SERVICE != .. ]] || pki_die 'Certificate export service is invalid'
    [[ $REQUEST_ID =~ ^[0-9a-f]{32}$ ]] || pki_die 'Certificate export request ID is invalid'
    NAMESPACE=$(pki_expand_path "$NAMESPACE")
    PKI_DIR=${PKI_DIR:-${NAMESPACE}/pki}
    PKI_DIR=$(pki_expand_path "$PKI_DIR")
    pki_require_cmd openssl; pki_require_cmd ssh-keygen; pki_require_cmd sha256sum; pki_require_cmd python3; pki_require_cmd cmp
    pki_require_pki_dir; pki_prepare_control_state
    LIFECYCLE_LOCK=$(pki_lifecycle_operation_lock); ROOT_LOCK=$(pki_root_operation_lock); INTERMEDIATE_LOCK=$(pki_intermediate_operation_lock); INVENTORY_LOCK=$(pki_inventory_operation_lock); EXPORT_LOCK=$(pki_export_operation_lock)
    LIFECYCLE_LOCK_HELD=false; ROOT_LOCK_HELD=false; INTERMEDIATE_LOCK_HELD=false; INVENTORY_LOCK_HELD=false; EXPORT_LOCK_HELD=false
    EXPORT_STAGE=''; EXPORT_STAGE_IDENTITY=''; INVENTORY_SNAPSHOT_DIR=''; INVENTORY_SNAPSHOT_IDENTITY=''
    unset -v INVENTORY_SNAPSHOT_FILES
    declare -gA INVENTORY_SNAPSHOT_FILES=()
    trap 'certificate_export_finish $?' EXIT
    umask 077
    pki_acquire_operation_lock "$LIFECYCLE_LOCK" 'PKI lifecycle operation'; LIFECYCLE_LOCK_HELD=true
    pki_acquire_operation_lock "$ROOT_LOCK" 'root CA operation'; ROOT_LOCK_HELD=true
    pki_acquire_operation_lock "$INTERMEDIATE_LOCK" 'intermediate CA operation'; INTERMEDIATE_LOCK_HELD=true
    pki_acquire_operation_lock "$INVENTORY_LOCK" 'inventory operation'; INVENTORY_LOCK_HELD=true
    pki_acquire_operation_lock "$EXPORT_LOCK" 'export operation'; EXPORT_LOCK_HELD=true
    pki_require_no_unresolved_journal
    pki_require_generation_layout
    INVENTORY_SNAPSHOT_DIR=$(mktemp -d "${TMPDIR:-/tmp}/platform-pki-certificate-export-inventory.XXXXXX") || pki_die 'Cannot create certificate export inventory snapshot directory'
    INVENTORY_SNAPSHOT_IDENTITY=$(pki_dir_identity "$INVENTORY_SNAPSHOT_DIR") || pki_die 'Cannot snapshot certificate export inventory directory identity'
    pki_load_inventory_snapshot "$INVENTORY_SNAPSHOT_DIR"
    INVENTORY_SNAPSHOT_FILES[services.yml]=$(pki_file_identity "$INVENTORY_SNAPSHOT_DIR/services.yml")
    INVENTORY_SNAPSHOT_FILES[canonical]=$(pki_file_identity "$INVENTORY_SNAPSHOT_DIR/canonical")
    pki_require_service_in_inventory "$SERVICE"
    [[ $(pki_inventory_key_custody "$SERVICE") == host-local ]] || pki_die 'Certificate-only CSR export requires key_custody: host-local'
    COMMON_NAME=$(pki_inventory_scalar "$SERVICE" common_name)
    INVENTORY_TARGET=$(pki_inventory_scalar "$SERVICE" target)
    certificate_export_validate_sources
    if [[ $action == publish ]]; then certificate_export_publish; else certificate_export_resolve; fi
  }

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "publish") platform_pki_certificate_export_publish_command ;;
    "resolve") platform_pki_certificate_export_resolve_command ;;
  esac
}

command_line_args=("$@")
initialize
run "${command_line_args[@]}"
