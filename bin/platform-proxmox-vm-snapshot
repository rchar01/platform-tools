platform_proxmox_vm_snapshot_usage() {
  printf "platform-proxmox-vm-snapshot - Create, inspect, roll back, or delete short-lived Proxmox VE 9 VM snapshots\n\n"

  printf "%s\n" "$(bold "Usage:")"
  printf "  platform-proxmox-vm-snapshot COMMAND\n"
  printf "  platform-proxmox-vm-snapshot [COMMAND] --help | -h\n"
  printf "  platform-proxmox-vm-snapshot --version | -v\n"
  echo

  printf "%s\n" "$(bold "Commands:")"
  printf "  %s   Create a temporary VM snapshot\n" "$(green "create")  "
  printf "  %s   List VM snapshots\n" "$(green "list")    "
  printf "  %s   Roll back VMs to an existing snapshot\n" "$(green "rollback")"
  printf "  %s   Delete an existing VM snapshot\n" "$(green "delete")  "
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "$(bold "Options:")"

    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "$(magenta "--version, -v")"
    printf "    Show version number\n"
    echo

    printf "Exactly one of --vmid, --vm-name, or --environment is required. Environment\nselection requires exact managed-by-tofu and environment tags and may target\nmultiple VMs. Multi-VM operations run serially and are not atomic.\n\nSnapshots are temporary rollback points, not backups. Without --yes, create,\nrollback, and delete require interactive TTY confirmation. Rollback and\ndelete use the exact VMID/environment plus snapshot name as confirmation.\n"
    echo

  fi
}

